// The Python face of DriftSpec (SREQ-00015-1, SREQ-00016-1; DS-84, DS-85): the engine as a library
// Python depends on, and a language server on it. Written in Python except the extension, which is
// C++ over the limited CPython API: the box says python, the module native says cpp.
//
//   python   a library in process: load, check, render, page, expected_at
//   editor   the language server protocol over stdio: what an editor asks while a design is typed

package driftspec@driftspec {


  // What it is to depend, for the rules of the Python face: through a member or a behaviour.
  definition depends(a, b) {
    title: a depends on b itself, through one of its members or through its behaviours
    if a uses b
    if m in a, m owns b
    if m in a, m refs b
    if m in a, m uses b
    if m in a, s behaviour-of m, s uses b
  }

  rule python-asks-the-engine-through-the-workspace {
    title: what is Python reaches the engine only through the native module; it holds no part of the engine of its own
    @requirement REQ-00107-2
    for class c in driftspec@driftspec
    where not c in driftspec@driftspec@_native
    never depends(c, x), x in driftspec@ds
  }

  requirement REQ-00086-1 {
    status: approved
    @refines SREQ-00015-1
    title: The Python face shall read a workspace into a typed model through one native module, every Python from 3.10 on
    text:
      driftspec.load(source) takes a directory or a mapping of path to text and gives a Model:
      the entities by identity, the relations, the findings and the metamodel, read from the
      JSON driftspec._native returns. check, render, page and expected_at do the same for their
      answers. The native module is built against the limited API (abi3).
    tags: python, api
    verification VER-00095-2 {
      status: approved
      title: Integration tests confirm the package loads a directory or the texts an editor holds into a typed model, checks it, draws and pages it
      method: test
      tests:
        tests/integration/python/test_driftspec.py::TestLoad::test_a_directory_loads_into_a_typed_model
        tests/integration/python/test_driftspec.py::TestLoad::test_the_texts_an_editor_holds_load_as_a_workspace
        tests/integration/python/test_driftspec.py::TestLoad::test_a_path_that_is_no_directory_is_refused
        tests/integration/python/test_driftspec.py::TestCheck::test_a_clean_workspace_reports_no_error
        tests/integration/python/test_driftspec.py::TestCheck::test_a_syntax_error_is_a_finding_where_it_is
        tests/integration/python/test_driftspec.py::TestDrawing::test_a_diagram_draws_as_text_and_none_draws_nothing
        tests/integration/python/test_driftspec.py::TestDrawing::test_the_viewer_opens_framed_where_it_is_asked
        tests/integration/python/test_driftspec.py::TestDrawing::test_what_the_grammar_takes_in_a_module
        tests/integration/python/test_driftspec.py::TestModelReadsTheMetamodel::test_a_member_an_outcome_and_a_rule_are_drawn_inside_what_holds_them
        tests/integration/python/test_driftspec.py::TestModelReadsTheMetamodel::test_messages_are_laid_out_and_interfaces_are_named
    }
  }

  requirement REQ-00087-1 {
    status: approved
    @refines SREQ-00016-1
    title: The language server shall check the design a file belongs to on every change, and lead from a name to what it is
    text:
      The design a file belongs to is its folder and the folders above that hold .ds files of
      their own, never past the project root; each design keeps its model and its diagnostics.
      Definition, references, hover, completion and symbols answer from that model; draw and
      view show the diagram or the entity under the cursor, or the declaration the cursor is in.
    tags: lsp, editor
    verification VER-00096-2 {
      status: approved
      title: Integration tests confirm the language server, driven over stdio, diagnoses a buffer as it is typed, leads a name to its declaration and draws it, and keeps each design apart
      method: test
      tests:
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_buffer_typed_wrong_is_diagnosed_and_cleared_when_right
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_name_leads_to_its_declaration_and_draws
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_file_belongs_to_its_own_design_only
        tests/integration/python/test_lsp.py::TestLanguageServer::test_the_outline_lists_every_declaration_of_the_file
        tests/integration/python/test_lsp.py::TestLanguageServer::test_completion_offers_every_kind_a_reference_names
    }
    verification VER-00254-1 {
      status: draft
      title: Integration tests confirm the language server publishes each finding with the editor mapping the severity table gives its severity, and never the coverage
      text: DS-386, the regression test of the language server reading the severity table instead of naming a severity.
      method: test
      tests:
        tests/integration/python/test_lsp.py::TestSeverityThroughTheTable::test_each_diagnostic_carries_the_editor_mapping_of_its_finding_s_severity
    }
  }

  // ---- the library: what a Python caller sees -------------------------------------------------
  interface python {
    kind: library
    transport: in process
    encoding: python objects
    @requirement REQ-00086-1

    operation check(source: driftspec::Source) -> driftspec::Report : UC-00001-1
    operation load(source: driftspec::Source) -> driftspec::Model : UC-00005-1
    operation render(source: driftspec::Source, diagram: string) -> string : UC-00002-1
  }

  sequence python::check {
    -> driftspec::check(source) -> report
    return report
  }

  sequence python::check / errors {            // the report counts errors: nothing is raised
    -> driftspec::check(source) -> report
    return report
  }

  sequence python::check / bad-usage {         // neither a directory nor texts: NotADirectoryError
    -> driftspec::read(source) -> files
    return none
  }

  sequence python::load {
    -> driftspec::load(source) -> model
    return model
  }

  sequence python::load / no-workspace {
    -> driftspec::read(source) -> files
    return none
  }

  sequence python::render {
    -> driftspec::render(source, diagram, format, width) -> drawing
    return drawing
  }

  sequence python::render / no-diagram {       // "" for a diagram the workspace does not have
    -> driftspec::render(source, diagram, format, width) -> drawing
    return drawing
  }

  sequence python::render / no-workspace {
    -> driftspec::read(source) -> files
    return none
  }

  // ---- the live session: a workspace followed as it is written --------------------------------
  requirement REQ-00089-2 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall reload the model on every change of the workspace's files and give every page that follows it the new state
    text:
      driftspec.live watches the .ds files of a workspace; a change loads the model again and pushes the
      state (version, findings, counts, history) to every page following the session as server-sent
      events. A half-written file does not stop the session: the error is sent and the next save is
      read.
    rationale: Revision 2: the identities that changed left with ds diff (Owner, 2026-11-18, DS-277).
    tags: live, viewer
    verification VER-00098-2 {
      status: approved
      title: Integration tests confirm a change to a file reaches a new version of the state, and a page following the session receives the model
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_a_change_to_a_file_reaches_a_new_version_of_the_state
        tests/integration/python/test_live.py::TestLiveSession::test_a_reader_receives_the_model_and_is_taken_where_it_is_asked
    }
    verification VER-00251-1 {
      status: approved
      title: Integration tests confirm the facade, the watcher and the language server read a workspace's files by the engine's one rule, and the watcher sees a save in a dot-folder
      method: test
      tests:
        tests/integration/python/test_workspace_files.py::TestWorkspaceFiles::test_the_facade_reads_the_files_the_engine_reads_and_no_other
        tests/integration/python/test_workspace_files.py::TestWorkspaceFiles::test_the_watcher_stamps_the_same_files_and_sees_a_save_in_a_dot_folder
        tests/integration/python/test_workspace_files.py::TestWorkspaceFiles::test_the_language_server_finds_a_folder_s_own_files_by_the_same_rule
        tests/integration/python/test_workspace_files.py::TestWorkspaceFiles::test_the_engine_reads_the_same_files_when_its_binary_is_at_hand
    }
  }

  requirement REQ-00090-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall carry focus, notes, highlights and the reader's selection both ways, through a contract with a version, and keep notes and highlights beside the workspace across restarts
    text:
      The contract (GET /contract) names the routes a client calls and the events it receives, and
      the state says the contract's version, so a browser page and an editor's panel rely on the
      same thing. Focus takes the reader to an identity; a note is a bubble on an identity, replaced
      by the next one on it and removed by an empty one; a highlight lights identities with a tone;
      clear removes them. The reader's selection is posted back. Notes and highlights are kept in
      <workspace>/.driftspec/live.json, never in the design.
    rationale: Found using the spike (DS-102): notes in memory were lost on every restart.
    tags: live, viewer
    verification VER-00099-2 {
      status: approved
      title: Integration tests confirm focus, notes, highlights and the selection go both ways through the contract, and notes and highlights survive a restart outside the design
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_readers_selection_reaches_the_one_who_writes
        tests/integration/python/test_live.py::TestLiveSession::test_notes_and_highlights_survive_a_restart_and_stay_out_of_the_design
        tests/integration/python/test_live.py::TestLiveSession::test_a_note_with_no_text_removes_it_and_clear_removes_them_all
        tests/integration/python/test_live.py::TestLiveSession::test_the_contract_says_its_routes_and_its_version
        tests/integration/python/test_live.py::TestLiveSession::test_the_page_goes_fullscreen_whole_when_the_viewer_asks
    }
    verification VER-00250-2 {
      status: draft
      title: Integration tests confirm the HTTP routes, the MCP tools and the command line are read from one contract, agree with it, and publish their contract byte for byte
      text: Revision 2 (DS-386): the contract is version 5, with the coverage in the state; the pin follows it.
      method: test
      tests:
        tests/integration/python/test_live_contract.py::TestContract::test_the_contract_publishes_its_version_byte_for_byte
        tests/integration/python/test_live_contract.py::TestContract::test_the_tools_an_agent_lists_are_what_version_4_listed_byte_for_byte
        tests/integration/python/test_live_contract.py::TestContract::test_every_route_of_the_contract_is_served_and_nothing_else
        tests/integration/python/test_live_contract.py::TestContract::test_every_route_answers_on_a_session
        tests/integration/python/test_live_contract.py::TestContract::test_every_tool_is_an_operation_of_the_contract_or_the_door_s_own
        tests/integration/python/test_live_contract.py::TestContract::test_every_command_is_an_operation_of_the_contract_or_the_door_s_own
        tests/integration/python/test_live_contract.py::TestContract::test_a_get_takes_no_body_from_a_tool_or_a_command
    }
    verification VER-00252-1 {
      status: approved
      title: Integration tests confirm an event a page reads later carries the notes, highlights, comments and state it was sent with
      text: DS-414, the regression test of a race the events had: each carried the session's own lists, and a page serialised them when it took the event, so an annotate event could show a comment written after it.
      method: test
      tests:
        tests/integration/python/test_live_events.py::TestEventsCarryWhatTheyWereSentWith::test_an_annotate_event_keeps_the_annotations_it_was_sent_with
        tests/integration/python/test_live_events.py::TestEventsCarryWhatTheyWereSentWith::test_a_model_event_keeps_the_state_it_was_sent_with
    }
  }

  requirement REQ-00230-1 {
    status: draft
    @refines SREQ-00017-1
    title: The live session shall show the coverage apart from the findings, and colour each finding by the severity the severity table gives it
    text:
      The state carries the coverage (what is not yet written: a requirement nothing verifies, an
      operation with no behaviour) in a field of its own, apart from the findings, and the page lists it
      in a folded section of its own in the information colour. Each finding is coloured by its row of
      the severity table: one that fails red, one that does not amber. The findings pill counts what
      fails, with the rest beside it. The page carries the table as the engine writes it and names no
      severity itself.
    rationale: Owner, 2026-11-24 (DS-386): the page painted every finding red and the pill red on any finding; the coverage, kept apart since DS-216, reached no Python door.
    tags: live, viewer, severity
    verification VER-00253-1 {
      status: draft
      title: Integration tests confirm the coverage reaches the state apart from the findings and the page carries the severity table it colours by
      method: test
      tests:
        tests/integration/python/test_live_severities.py::TestSeveritiesOnThePage::test_the_coverage_reaches_the_state_apart_from_the_findings
        tests/integration/python/test_live_severities.py::TestSeveritiesOnThePage::test_the_page_carries_the_severity_table_it_colours_by
    }
  }

  requirement REQ-00091-3 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall offer its contract to an agent as MCP tools over stdio
    text:
      python -m driftspec.live mcp serves live_open (starting the session if none serves the workspace),
      live_focus, live_note, live_highlight, live_clear, live_selection, live_state, live_comments
      (what the reader wrote since the last call) and live_isolate; each answers
      through the session's routes, so the agent and a page see the same state.
    rationale: Revision 2 adds the tools of the reader's comments, isolation and the baseline (DS-139, DS-147, DS-148); revision 3 drops the baseline with ds diff (DS-277).
    tags: live, mcp
    verification VER-00100-2 {
      status: approved
      title: Integration tests confirm an agent calls the contract as MCP tools and an unknown tool is an error
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_an_agent_calls_the_contract_as_mcp_tools
        tests/integration/python/test_live.py::TestLiveSession::test_an_agent_reads_comments_and_isolates_as_mcp_tools
    }
  }

  requirement REQ-00102-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall keep whether the reader has seen each note, and bring a note the agent writes again back unseen
    text:
      A note carries seen and when it was written. The reader marks notes seen or not (POST /seen);
      what is seen is kept with the notes beside the workspace, so the agent knows what was read. A
      note written again on the same identity comes back unseen. The page folds a note to a dot on
      its box and opens it again, folds or opens them all, marks them all seen and hides the seen;
      a seen note is dimmed and folded; bubbles keep out of each other's way.
    rationale: Owner, 2026-11-09 and 2026-11-10 (DS-102): the agent's notes are too much to read at once.
    tags: live, viewer
    verification VER-00111-1 {
      status: approved
      title: Integration tests confirm a note is marked seen, comes back unseen when written again, keeps what was seen across a restart, and the page folds and marks notes
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_reader_marks_a_note_seen_and_a_rewritten_note_comes_back_unseen
        tests/integration/python/test_live.py::TestLiveSession::test_the_page_folds_notes_marks_them_seen_and_keeps_them_apart
    }
  }

  requirement REQ-00165-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall answer only its own page and the tools of the machine it runs on
    text:
      It listens on 127.0.0.1, and a request whose Host is not the session's own name, or whose
      Origin, when the browser sends one, is not the session's own page, is refused (403) before it
      reads or writes anything. Its page writes the workspace's name escaped.
    rationale:
      A page of another site open in the same browser could write notes and comments into the
      session, which the browser carries out even though it hides the answer, and a name that
      resolves to 127.0.0.1 could read the design (audit for 0.1.0, DS-302).
    tags: live, security
    verification VER-00182-1 {
      status: approved
      title: Integration tests confirm a page of another origin cannot write to the session and a name that is not the session's cannot read it
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSessionIsLocal::test_a_page_of_another_origin_cannot_write_to_the_session
        tests/integration/python/test_live.py::TestLiveSessionIsLocal::test_a_name_that_is_not_the_sessions_cannot_read_it
    }
  }

  requirement REQ-00103-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall carry what the reader writes on an identity to the agent, each comment read once
    text:
      The page offers a comment box on what is selected, under the thread of the agent's notes and
      the reader's comments on it, in the order they were written. A comment (POST /comment) is kept
      numbered beside the workspace; the agent reads the unread ones (POST /unread, live_comments),
      which marks them read, and answers with a note on the same identity.
    rationale: Owner, 2026-11-10 (DS-147): write back to the agent from the viewer.
    tags: live, viewer, mcp
    verification VER-00112-1 {
      status: approved
      title: Integration tests confirm a comment reaches the agent once, is kept across a restart outside the design, and the page comments on what is selected
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_a_comment_reaches_the_agent_once_and_survives_a_restart
        tests/integration/python/test_live.py::TestLiveSession::test_the_page_lets_the_reader_comment_on_what_is_selected
    }
  }

  requirement REQ-00104-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall keep what the reader isolates across reloads and let the agent isolate it
    text:
      What is isolated (POST /isolate, live_isolate) is in the state and told to every page; a page
      that isolated it itself only tells the session. A new version of the model keeps it isolated.
      How the viewer isolates is REQ-00092-3.
    rationale: Owner, 2026-11-09 and 2026-11-10 (DS-139): see only the modules being talked about.
    tags: live, viewer, mcp
    verification VER-00113-1 {
      status: approved
      title: Integration tests confirm the isolation is kept in the state and told to every page
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_isolation_is_kept_and_told_to_every_page
    }
  }

  requirement REQ-00100-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall list every rule and definition as written, whether it holds, what breaks it and where, and light a rule in the viewer when the reader picks it
    text:
      The state carries the rules: each one's clauses as written, its title, what it answers to,
      where it is written, its breaches with their bindings, answer and location, and the problems
      the checker found in it. The page shows them in a panel of the logic perspective, filtered by
      all, broken, or those that speak of what the reader selected; picking one asks the viewer to
      light it.
    rationale: Owner, 2026-11-09 (DS-108): without seeing the rules they cannot be understood.
    tags: live, viewer, logic
    verification VER-00109-1 {
      status: approved
      title: Integration tests confirm the state carries the rules as written with what breaks them and where
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_rules_reach_the_state_as_written_with_what_breaks_them
    }
    verification VER-00256-1 {
      status: draft
      title: Integration tests confirm each rule and definition carries the problems written inside it, every rule finding of the language included, and keeps them when their message is reworded
      text: DS-421. The problems were matched by the start of their message and broke silently on any rewording; they are now the rule findings written inside the rule's span. The scene keeps a record of the same rules of its own, a duplication DS-406/DS-409 retire.
      method: test
      tests:
        tests/integration/python/test_live_rules.py::TestRuleProblems::test_each_rule_has_the_problems_written_inside_it
        tests/integration/python/test_live_rules.py::TestRuleProblems::test_a_reworded_message_still_reaches_its_rule
    }
  }

  interface session {                          // what a page or an editor's panel relies on
    kind: http
    transport: http, server-sent events on localhost
    encoding: json
    @requirement REQ-00090-1

    operation state() -> object
    operation events() -> object
    operation focus(id: string, also: list<string>) -> object
    operation note(id: string, text: string, tone: string) -> object
    operation highlight(ids: list<string>, tone: string, add: bool) -> object
    operation clear(what: string) -> object
    operation selection(id: string, label: string) -> object
    operation seen(ids: list<string>, seen: bool) -> object {
      @requirement REQ-00102-1
    }
    operation comment(id: string, text: string) -> object {
      @requirement REQ-00103-1
    }
    operation unread(mark: bool) -> object {
      @requirement REQ-00103-1
    }
    operation isolate(ids: list<string>, tell: bool) -> object {
      @requirement REQ-00104-1
    }
  }

  sequence session::state {
    local s: live_session::Live
    -> s.state() -> state
    return state
  }

  sequence session::events {
    local s: live_session::Live
    local pages: live_session::Events
    -> pages.listen() -> q
    -> s.state() -> state
    -> pages.leave(q)
    return state
  }

  sequence session::focus {
    local s: live_session::Live
    -> s.focus(id, also) -> listeners
    return listeners
  }

  sequence session::note {
    local s: live_session::Live
    -> s.note(id, text, tone, frame) -> notes
    return notes
  }

  sequence session::highlight {
    local s: live_session::Live
    -> s.highlight(ids, tone, add, frame) -> highlights
    return highlights
  }

  sequence session::clear {
    local s: live_session::Live
    -> s.clear(what)
    return none
  }

  sequence session::selection {
    local s: live_session::Live
    -> s.select(id, label)
    return none
  }

  sequence session::seen {
    local s: live_session::Live
    -> s.seen(ids, seen) -> count
    return count
  }

  sequence session::comment {
    local s: live_session::Live
    -> s.comment(id, text) -> count
    return count
  }

  sequence session::unread {
    local s: live_session::Live
    -> s.unread(mark) -> comments
    return comments
  }

  sequence session::isolate {
    local s: live_session::Live
    -> s.isolate(ids, tell) -> isolated
    return isolated
  }

  interface agent {                            // the same contract, for an agent
    kind: mcp
    transport: stdio, json-rpc
    @requirement REQ-00091-3

    operation live_open(workspace: string) -> string
    operation live_focus(id: string) -> object
    operation live_note(id: string, text: string) -> object
    operation live_highlight(ids: list<string>) -> object
    operation live_clear(what: string) -> object
    operation live_selection() -> object
    operation live_state() -> object
    operation live_comments(peek: bool) -> object {
      @requirement REQ-00103-1
    }
    operation live_isolate(ids: list<string>) -> object {
      @requirement REQ-00104-1
    }
  }

  sequence agent::live_open {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_focus {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_note {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_highlight {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_clear {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_selection {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_state {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_comments {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_isolate {
    -> live_mcp::tool(port, name, args, opened) -> answer
    return answer
  }

  // ---- the language server: what an editor asks -----------------------------------------------
  interface editor {
    kind: lsp
    transport: stdio, json-rpc
    @requirement REQ-00087-1

    operation did_change(uri: string, text: string) -> none : UC-00007-1
    operation definition(uri: string, line: int, character: int) -> lsprotocol::Location : UC-00007-1
    operation references(uri: string, line: int, character: int) -> lsprotocol::Location : UC-00007-1
    operation hover(uri: string, line: int, character: int) -> lsprotocol::Hover : UC-00007-1
    operation completion(uri: string, line: int, character: int) -> lsprotocol::CompletionList : UC-00007-1
    operation draw(uri: string, line: int, character: int) -> string : UC-00007-1
    operation view(uri: string, line: int, character: int) -> string : UC-00007-1
  }

  sequence editor::did_change {
    -> lsp::changed(ls, params)
  }

  sequence editor::definition {
    -> lsp::definition(ls, params) -> locations
    return locations
  }

  sequence editor::references {
    -> lsp::references(ls, params) -> locations
    return locations
  }

  sequence editor::hover {
    -> lsp::hover(ls, params) -> hover
    return hover
  }

  sequence editor::completion {
    -> lsp::completion(ls, params) -> items
    return items
  }

  sequence editor::draw {
    -> lsp::draw(ls, uri, line, character, rest) -> drawing
    return drawing
  }

  sequence editor::view {
    -> lsp::view(ls, uri, line, character, rest) -> opened
    return opened
  }

  // ---- the extension: C++ inside the Python box --------------------------------------------------
  module _native {
    language: cpp
    @consumes driftspec@ds@engine                // DS-92: through the engine's interface
    @consumes driftspec@ds@workspace             // DS-90: a workspace loaded once, through its interface
    @requirement REQ-00086-1
    // the module makes the language once, a model::Metamodel, and hands it to the engine's Api and to every
    // Workspace it loads (DS-341); version() is that metamodel's

    function version() -> std::string
    function severities() -> std::string        // the severity table, as the engine writes it (DS-386)
    function check(files: std::map<std::string, std::string>) -> std::string
    function export(files: std::map<std::string, std::string>) -> std::string
    function expected_at(text: std::string, line: int, column: int) -> std::string
    function render(files: std::map<std::string, std::string>, diagram: std::string, format: std::string, width: int) -> std::string
    function page(files: std::map<std::string, std::string>, title: std::string, focus: std::vector<std::string>) -> std::string
    function qualify(scope: std::string, name: std::string) -> std::string
    function outer(scope: std::string) -> std::string
    function box_of(scope: std::string) -> std::string
    function package_of(scope: std::string) -> std::string
    function behaviour_of(id: std::string) -> std::string
    function subject_of(id: std::string) -> std::string
    function scenario_of(id: std::string) -> std::string
    function without_revision(id: std::string) -> std::string

    // A workspace loaded once and kept in the engine (DS-173): the native object a Python Workspace
    // holds; its methods are the operations of the engine's workspace interface, each answer the JSON
    // the engine writes. No reader sees a CPython type yet: argos holds it to no code (DS-90).
    class Workspace {
      @requirement REQ-00086-1
      @constraint CST-00009-1
      - owns workspace: driftspec@ds@api::Workspace
      + Workspace(files: std::map<std::string, std::string>)
      + reload(files: std::map<std::string, std::string>) -> none  // loaded again in place (DS-420)
      + export() -> std::string
      + report() -> std::string
      + find(id: std::string) -> std::string
      + relations_from(id: std::string) -> std::string
      + relations_to(id: std::string) -> std::string
      + touching(id: std::string) -> std::string
      + members(scope: std::string) -> std::string
      + parent(id: std::string) -> std::string
      + children(id: std::string) -> std::string
      + revision_of(artefact: std::string) -> std::string
      + tree(sequence: std::string) -> std::string
      + steps(sequence: std::string, path: std::string) -> std::string
      + walk(sequence: std::string, path: std::string, depth: int) -> std::string
      + ask(question: std::string, subject: std::string) -> std::string
      + shows(diagram: std::string) -> std::string
      + render(diagram: std::string, format: std::string, width: int) -> std::string
      + page(title: std::string, focus: std::vector<std::string>) -> std::string
    }

    sequence Workspace::export {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.export() -> json
      return json
    }

    sequence Workspace::report {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.report() -> json
      return json
    }

    sequence Workspace::find {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.find(id) -> json
      return json
    }

    sequence Workspace::relations_from {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.from(id) -> json
      return json
    }

    sequence Workspace::relations_to {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.to(id) -> json
      return json
    }

    sequence Workspace::touching {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.touching(id) -> json
      return json
    }

    sequence Workspace::members {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.members(scope) -> json
      return json
    }

    sequence Workspace::parent {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.parent(id) -> json
      return json
    }

    sequence Workspace::children {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.children(id) -> json
      return json
    }

    sequence Workspace::revision_of {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.revisionOf(artefact) -> json
      return json
    }

    sequence Workspace::tree {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.tree(sequence) -> json
      return json
    }

    sequence Workspace::steps {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.steps(sequence, path) -> json
      return json
    }

    sequence Workspace::walk {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.walk(sequence, path, depth) -> json
      return json
    }

    sequence Workspace::ask {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.ask(question, subject) -> json
      return json
    }

    sequence Workspace::shows {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.shows(diagram) -> json
      return json
    }

    sequence Workspace::render {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.render(diagram, format, width) -> json
      return json
    }

    sequence Workspace::reload {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.reload(files)
    }

    sequence Workspace::page {
      local loaded: driftspec@ds@workspace  // the engine's in-process interface, not the class behind it
      -> loaded.page(title, focus) -> json
      return json
    }

    sequence check {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.check(files) -> json
      return json
    }

    sequence export {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.export(files) -> json
      return json
    }

    sequence expected_at {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.expectedAt(text, line, column) -> json
      return json
    }

    sequence render {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.render(files, diagram, format, width) -> drawing
      return drawing
    }

    sequence page {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.page(files, title, focus) -> html
      return html
    }
  }

  // ---- the package: the JSON read into a typed model ----------------------------------------------
  // Its types are written as Python writes them (str, dict<str, int>, tuple<variadic<str>> for a
  // tuple of any length, optional<T> for T | None), so argos holds them to the code as they are.
  module driftspec {
    @requirement REQ-00086-1

    dataclass Location {
      @requirement REQ-00086-1
      + file: str
      + line: int
      + column: int
      + end_line: int                          // the place right after its last character; 0 when not known
      + end_column: int
    }
    dataclass Entity {
      @requirement REQ-00086-1
      + id: str
      + kind: str
      + name: str
      + scope: str
      + location: Location
      + fields: Mapping[str, str]
      + flags: tuple[str, ...]
      + expected: bool
    }
    dataclass Relation {
      @requirement REQ-00086-1
      + kind: str
      + source: str
      + target: str
      + location: Location
      + multiplicity: str                      // how many a holding relation holds: "1", "*"; "" for the rest
    }
    dataclass Finding {
      @requirement REQ-00086-1
      + code: str
      + severity: str
      + message: str
      + location: Location
    }
    dataclass Breach {                         // one binding that breaks a rule, and its answer
      @requirement REQ-00098-1
      + bindings: tuple[tuple[str, str], ...]
      + witness: tuple[tuple[str, str], ...]
      + location: Location
    }
    class Model {                              // a workspace loaded: every entity by its identity
      @requirement REQ-00086-1
      + many entities: dict[str, Entity]
      + many relations: list[Relation]
      + many findings: list[Finding]
      + metamodel: dict                        // the kinds and relations the language declares, as ds export writes them
      + many breaches: dict[str, list[Breach]]
      + find(identity: str) -> Entity | None
      + of_kind(kind: str) -> Iterator[Entity]
      + named(name: str) -> list[Entity]
      + relations_of(identity: str) -> list[Relation]
      + in_file(path: str) -> list[Entity]
      + parents_of(kind: str) -> list[str]
      + in_a_box(kind: str) -> bool
      + laid_out(kind: str) -> bool
      + named_kinds() -> set[str]
      + owner(entity: Entity) -> Entity
    }
    dataclass Report {
      @requirement REQ-00086-1
      + many findings: list[Finding]
      + counts: Mapping[str, int]
      + many coverage: list[Finding]           // kept apart from the findings: what is not yet written (DS-216)
      + errors() -> int                        // a property: the count of errors
    }

    // ---- what the engine answers about a loaded workspace, read into Python's own types (DS-173) -----
    dataclass Answer {
      @requirement REQ-00086-1
      + kind: str
      + id: str
      + detail: str
    }
    dataclass Step {
      @requirement REQ-00086-1
      + message: str
      + next: str
      + next_path: str
    }
    dataclass Walked {
      @requirement REQ-00086-1
      + message: str
      + depth: int
    }
    dataclass Frame {
      @requirement REQ-00086-1
      + id: str
      + kind: str
      + frame: str
      + at: int
      + first: str
      + else_: str
      + two_sides: bool
      + scenario: str
      + else_scenario: str
    }
    dataclass Tree {
      @requirement REQ-00086-1
      + sequence: str
      + messages: tuple[tuple[str, str], ...]
      + many frames: tuple[Frame, ...]
    }

    // What Python holds: a workspace loaded once in the engine, asked; it computes nothing the
    // engine knows. Several may be held at once, each with its own model. It is made from a Source.
    class Workspace {
      @requirement REQ-00086-1
      @constraint CST-00009-1
      - owns _native: _native.Workspace
      + reload(source: Source) -> None         // loaded again in place: a file whose text has not changed is not parsed again (DS-420)
      + model() -> Model
      + report() -> Report
      + find(identity: str) -> Entity | None
      + relations_from(identity: str) -> list[Relation]
      + relations_to(identity: str) -> list[Relation]
      + touching(identity: str) -> list[Relation]
      + members(scope: str) -> list[str]
      + parent(identity: str) -> str
      + children(identity: str) -> list[str]
      + revision_of(artefact: str) -> str
      + tree(sequence: str) -> Tree
      + steps(sequence: str, path: str) -> list[Step]
      + walk(sequence: str, path: str, depth: int) -> list[Walked]
      + ask(question: str, subject: str) -> list[Answer]
      + shows(diagram: str) -> list[Answer]
      + render(diagram: str, format: str, width: int) -> str
      + page(title: str, focus: list[str] | tuple[str, ...]) -> str
    }

    sequence Workspace::relations_from {
      self -> _native.relations_from(identity) -> text
      return found
    }

    // A workspace's files, by one rule: the engine's own (Parser::parseDirectory). The facade reads with it,
    // the live session's watcher stamps with it and the language server finds a folder's own with it.
    function files(root: Union[str, os.PathLike], nested: bool) -> list[str]
    function read(source: Source) -> dict[str, str]

    sequence read {
      -> files(root, nested) -> paths
      return texts
    }
    function load(source: Source) -> Model
    function check(source: Source) -> Report
    function render(source: Source, diagram: str, format: str, width: int) -> str
    function page(source: Source, title: str, focus: list[str] | tuple[str, ...]) -> str
    function expected_at(text: str, line: int, column: int) -> list[str]
    function severities() -> list[dict]        // the severity table as the engine writes it: a door reads a severity here, never by name
    // the engine's JSON read into the types above, one shape each
    - function _location(d: Mapping) -> Location
    - function _finding(d: Mapping) -> Finding
    - function _entity(e: Mapping) -> Entity
    - function _relation(r: Mapping) -> Relation
    - function _model(data: Mapping) -> Model
    - function _report(data: Mapping) -> Report

    // A workspace loaded for one look at the whole of it (DS-173).
    sequence load {
      local workspace: Workspace
      -> workspace.model() -> model
      return model
    }

    sequence check {
      local workspace: Workspace
      -> workspace.report() -> report
      return report
    }

    sequence render {
      -> read(source) -> files
      -> _native::render(files, diagram, format, width) -> drawing
      return drawing
    }

    sequence page {
      -> read(source) -> files
      -> _native::page(files, title, focus) -> html
      return html
    }

    sequence expected_at {
      -> _native::expected_at(text, line, column) -> words
      return words
    }
  }

  // ---- the server: one design per file, its model kept, its findings published -------------------
  // The protocol's types come from lsprotocol, which the code names through its module (lsp.Location).
  module lsp {
    @requirement REQ-00087-1

    function path_of(uri: str) -> str
    function uri_of(path: str) -> str
    function holds_ds(directory: str) -> bool
    function workspace_of(ls: LanguageServer, path: str) -> str
    function workspace_files(ls: LanguageServer, ws: str) -> dict[str, str]
    function use(ls: LanguageServer, uri: str) -> str
    function refresh(ls: LanguageServer, ws: str) -> None
    function word_at(ls: LanguageServer, uri: str, position: lsp.Position) -> str
    function entities_for(word: str) -> list[driftspec.Entity]
    function location_of(e: driftspec.Entity) -> lsp.Location
    function changed(ls: LanguageServer, params) -> None
    function definition(ls: LanguageServer, params: lsp.DefinitionParams) -> list[lsp.Location]
    function references(ls: LanguageServer, params: lsp.ReferenceParams) -> list[lsp.Location]
    function hover(ls: LanguageServer, params: lsp.HoverParams) -> lsp.Hover | None
    function completion(ls: LanguageServer, params: lsp.CompletionParams) -> lsp.CompletionList
    function symbols(ls: LanguageServer, params: lsp.DocumentSymbolParams) -> list[lsp.SymbolInformation]
    function subject_at(ls: LanguageServer, uri: str, line: int, character: int, typed: str) -> tuple[str, str]
    function enclosing(path: str, line: int) -> driftspec.Entity | None
    function subject_of(word: str) -> tuple[str, str]
    function with_focus(files: dict[str, str], identity: str) -> tuple[dict[str, str], str]
    function optional(rest: tuple) -> tuple[int, str]      // the width and the word typed, from what pygls passes on
    function draw(ls: LanguageServer, uri: str, line: int, character: int, *rest) -> dict
    function open_in_browser(path: str) -> None
    function view(ls: LanguageServer, uri: str, line: int, character: int, *rest) -> dict
    function main() -> None

    sequence changed {
      -> workspace_of(ls, path) -> ws
      -> refresh(ls, ws)
    }

    // a folder's own .ds files, by the rule the engine reads a workspace with
    sequence holds_ds {
      -> driftspec::files(directory, nested) -> own
      return held
    }

    // The design loaded once in the engine: its findings, its drawings and the viewer ask it (DS-173).
    sequence refresh {
      local workspace: driftspec.Workspace
      -> workspace_files(ls, ws) -> files
      -> workspace.model() -> model
    }

    sequence definition {
      -> use(ls, uri) -> ws
      -> entities_for(word) -> found
      return locations
    }

    sequence draw {
      -> optional(rest) -> options
      -> use(ls, uri) -> ws
      -> subject_at(ls, uri, line, character, typed) -> subject
      -> workspace_files(ls, ws) -> files
      -> with_focus(files, identity) -> focused
      -> driftspec::render(focused, diagram, format, width) -> drawing
      return answer
    }

    sequence view {
      local workspace: driftspec.Workspace
      -> optional(rest) -> options
      -> use(ls, uri) -> ws
      -> subject_at(ls, uri, line, character, typed) -> subject
      -> workspace.page(title, focus) -> html
      -> open_in_browser(path)
      return answer
    }
  }

  // ---- the live session ---------------------------------------------------------------------------
  // The live session is split by what each part does (DS-322): the session and its contract, the page
  // around the viewer, the routes served over HTTP, the client side with the MCP tools, and the command
  // line, which keeps every name a caller imports from driftspec.live.
  module live {                                // the command line: driftspec-live and python -m driftspec.live
    @requirement REQ-00089-2
    @requirement REQ-00091-3

    class Command {                            // one command line: the command, its words and the options taken out of them
      @requirement REQ-00089-2
      + port: int
      + tone: str
      + add: bool
      + args: list[str]                        // the words left once the options are taken out
      + name: str                              // the command; serve when there is none
      + static option(args: list[str], flag: str, default)  // the value after a flag, taken out with it
      + word(k: int, default: str) -> str
      + ask(op: Operation) -> None             // the session's answer to an operation of the contract, printed as its word shows it
    }

    function asking(op: Operation)             // the command of an operation of the contract
    function main(argv: list[str] | None) -> None
  }

  module live_session {                        // the session over one workspace, and the parts it is made of
    @requirement REQ-00230-1
    @requirement REQ-00089-2
    @requirement REQ-00090-1
    @requirement REQ-00102-1
    @requirement REQ-00103-1
    @requirement REQ-00104-1

    // The session holds the version shown and composes three parts, each with one job (DS-322): what
    // both sides keep, the pages that follow it, and the files it watches. None of them knows the
    // session; the session tells the pages when what is kept changes.
    rule the-parts-of-the-session-know-no-session {
      title: the annotations, the events and the watcher know nothing of the session that composes them
      @requirement REQ-00089-2
      for class c in driftspec@driftspec@live_session
      where c != driftspec@driftspec@live_session::Live
      never depends(c, driftspec@driftspec@live_session::Live)
    }

    rule the-parts-of-the-session-reach-no-engine {
      title: only the session loads the design; what is kept, the pages and the files ask no engine
      @requirement REQ-00089-2
      for class c in driftspec@driftspec@live_session
      where c != driftspec@driftspec@live_session::Live
      never depends(c, driftspec@driftspec@driftspec::Workspace)
    }

    class Live {                               // a session over one workspace: its model version by version, and what both sides point at
      @requirement REQ-00230-1
      @requirement REQ-00089-2
      @requirement REQ-00090-1
      + workspace: str                         // the workspace's real path
      + title: str                             // the project's name, or the workspace's when it is not called design
      + lock: threading.Lock
      + version: int
      + page: str                              // the viewer of the version shown
      + optional loaded: driftspec.Workspace | None      // the version shown, loaded once in the engine (DS-173)
      + history: list[dict]                    // the last reloads: version, when, how long
      + findings: list[dict]
      + coverage: list[dict]                   // what is not yet written, kept apart from the findings (DS-386)
      + counts: dict
      + selection: dict
      + rules: list[dict]
      + isolated: list[str]
      + error: str
      + boot: str                              // when the server started: a page from an older one reloads itself
      + owns annotations: Annotations          // what both sides keep, beside the design
      + owns events: Events                    // the pages that follow the session
      + owns watcher: Watcher                  // the .ds files, watched
      + reload() -> bool
      + rules_of(model, findings) -> list[dict] {
        @requirement REQ-00100-1
      }
      + static within(place, span) -> bool {   // a place written inside a declaration's span: a rule's problems by where they are (DS-421)
        @requirement REQ-00100-1
      }
      + state() -> dict
      + shown(f) -> dict                       // a finding as a page reads it: code, severity, message, file, line
      + tick() -> None                         // one look at the files; an error is kept, never raised
      + watch(every: float) -> None
      + annotated(frame: list[str]) -> None    // what is kept, saved and told to every page
      + focus(identity: str, also: list[str] | None) -> int
      + note(identity: str, text: str, tone: str, frame: bool) -> int
      + highlight(ids: list[str], tone: str, add: bool, frame: bool) -> int
      + clear(what: str) -> None
      + select(identity: str | None, label: str) -> None
      + seen(ids: list[str], seen: bool) -> int {
        @requirement REQ-00102-1
      }
      + comment(identity: str, text: str) -> int {
        @requirement REQ-00103-1
      }
      + unread(mark: bool) -> list[dict] {
        @requirement REQ-00103-1
      }
      + isolate(ids: list[str], tell: bool) -> list[str] {
        @requirement REQ-00104-1
      }
    }

    class Annotations {                        // what both sides point at and keep: notes, highlights, comments
      @requirement REQ-00090-1
      + store: str                             // <workspace>/.driftspec/live.json
      + notes: list[dict]
      + highlights: list[dict]
      + comments: list[dict]
      + load() -> None
      + save() -> None                         // a read-only workspace keeps them for the session only
      + told(frame: list[str]) -> dict         // what a page is told when they change
      + note(identity: str, text: str, tone: str) -> int
      + highlight(ids: list[str], tone: str, add: bool) -> int
      + clear(what: str) -> None
      + seen(ids: list[str], seen: bool) -> int {
        @requirement REQ-00102-1
      }
      + comment(identity: str, text: str) -> int {
        @requirement REQ-00103-1
      }
      + unread() -> list[dict] {
        @requirement REQ-00103-1
      }
      + mark_read() -> None {
        @requirement REQ-00103-1
      }
    }

    class Events {                             // the pages that follow the session, a queue each
      @requirement REQ-00090-1
      + listeners: list[queue.Queue]
      + listen() -> queue.Queue
      + leave(q: queue.Queue) -> None
      + broadcast(event: str, data: dict) -> None  // a copy, taken when sent: a page reads what was sent (DS-414)
      + count() -> int
    }

    class Watcher {                            // the .ds files of a workspace: what they were, and whether a save changed them
      @requirement REQ-00089-2
      + workspace: str
      + stamp: tuple | None                    // what the files were at the last look; none before the first
      + files_stamp() -> tuple
      + changed() -> bool                      // the first look is a change
      + follow(tick: Callable[[], None], every: float, stopped: Callable[[], bool]) -> None
    }

    // The files the engine reads, stamped: a save in a dot-folder is a change, as the engine reads it.
    sequence Watcher::files_stamp {
      -> driftspec::files(workspace, nested) -> paths
      return stamp
    }

    rule the-watcher-stamps-what-the-engine-reads {
      title: the watcher lists a workspace's files by the facade's one rule, the engine's, and by no walk of its own
      @requirement REQ-00089-2
      for class w in driftspec@driftspec@live_session
      where w = driftspec@driftspec@live_session::Watcher
      holds m in w, s behaviour-of m, s couples-transient driftspec@driftspec@driftspec::files
    }

    // A save: the version loaded once, and its model, its page and its check asked of it (DS-173).
    sequence Live::reload {
      local loaded: driftspec.Workspace
      -> watcher.changed() -> changed
      opt nothing was saved since / unchanged {
        return false
      }
      -> loaded.model() -> model
      -> loaded.page(title, focus) -> page
      -> loaded.report() -> report
      -> rules_of(model, findings) -> rules
      -> events.broadcast(event, data)
      return true
    }
  }

  module live_contract {                       // the contract of the session, declared once
    @requirement REQ-00090-1
    @requirement REQ-00091-3
    @requirement REQ-00089-2

    // Each operation is one row: its route, what the contract says of it, what the session answers, the
    // MCP tool and the word of the command line that call it (DS-322). The HTTP routes, the tools and the
    // commands are read from the table, so the three doors cannot disagree; GET /contract is described
    // from it too.
    rule the-contract-knows-no-door {
      title: the contract names what the session answers and knows none of the doors that serve it
      @requirement REQ-00090-1
      for class c in driftspec@driftspec@live_contract, class d in driftspec@driftspec@live_http
      never depends(c, d)
    }

    rule the-contract-holds-no-session {
      title: the contract asks the session it is given and holds none
      @requirement REQ-00090-1
      for class c in driftspec@driftspec@live_contract
      never depends(c, driftspec@driftspec@live_session::Live)
    }

    dataclass Tool {                           // an operation as an MCP tool
      @requirement REQ-00091-3
      + name: str
      + description: str
      + properties: dict                       // its arguments, as a JSON schema
      + required: tuple[str, ...]
      + rank: int                              // where tools/list puts it
      + body: Callable[[dict], dict | None]    // the request its arguments make; none for a GET
      + after: Callable[[dict], object]        // what of the answer it gives back
      + schema() -> dict
    }

    dataclass Word {                           // an operation as a word of the command line
      @requirement REQ-00089-2
      + word: str
      + body: Callable                         // the request its words make; none for a GET
      + optional indent: int | None
      + show: Callable[[dict], object]         // what of the answer it prints
    }

    dataclass Operation {                      // one operation of the session
      @requirement REQ-00090-1
      + verb: str
      + path: str
      + doc: str                               // what the contract says of it
      + optional answer: Callable | None       // what the session answers; none for a route the server writes itself
      + optional tool: Tool | None
      + optional word: Word | None
      + route() -> str
    }

    class Contract {                           // the operations in the order the contract lists them
      @requirement REQ-00090-1
      + operations: tuple[Operation, ...]
      + describe() -> dict                     // what GET /contract answers
      + gets() -> dict[str, Callable]
      + posts() -> dict[str, Callable]
      + tools() -> list[Operation]             // in the order tools/list gives them
      + words() -> list[Operation]
    }
  }

  module live_page {                           // the page around the viewer, which follows the session
    @requirement REQ-00230-1
    @requirement REQ-00089-2
    @requirement REQ-00102-1
    @requirement REQ-00103-1
    @requirement REQ-00104-1

    function shell(title: str, workspace: str) -> str
  }

  module live_http {                           // the session served over HTTP on this machine only
    @requirement REQ-00090-1
    @requirement REQ-00165-1

    class Handler {                            // one request to a session; handler_for binds a subclass to each session
      @requirement REQ-00090-1
      + live: Live
      + log_message(*a)
      + local() -> bool {                      // the Host and the Origin are this session's own (DS-302)
        @requirement REQ-00165-1
      }
      + send(code: int, body: bytes, ctype: str) -> None
      + json(obj, code: int) -> None
      + do_GET()
      + page() -> None
      + events() -> None                       // the events a page follows, until the session stops
      + stream(q: queue.Queue) -> None         // the next event, or a keep-alive
      + do_POST()
    }

    function handler_for(live: Live) -> type[Handler]
    function browser_open(url: str) -> None
    function serve(workspace: str, port: int, open_browser: bool, block: bool) -> Live
  }

  module live_mcp {                            // the client side, the one who writes, and the MCP tools for an agent
    @requirement REQ-00091-3
    @requirement REQ-00103-1
    @requirement REQ-00104-1

    function call(port: int, path: str, data: dict | None) -> dict
    function open_workspace(port: int, args: dict, opened: dict) -> str
    function state(port: int) -> dict
    function asked(port: int, op: Operation, args: dict | None) -> object  // an operation asked with the body its tool makes
    function answering(op: Operation)          // the call of a tool of the contract
    function tool(port: int, name: str, args: dict, opened: dict) -> object
    function initialize(port: int, msg: dict, opened: dict) -> dict
    function called(port: int, msg: dict, opened: dict) -> dict
    function reply(stdout, i, result, error) -> None
    function answer(port: int, msg: dict, opened: dict, stdout) -> None
    function mcp(port: int, stdin, stdout) -> None
  }
}

diagram CL_LiveModule {                         // the live session's modules: the session and what serves it
  kind: class
  include: driftspec@driftspec@live::*
  include: driftspec@driftspec@live_session::*
  include: driftspec@driftspec@live_contract::*
  include: driftspec@driftspec@live_page::*
  include: driftspec@driftspec@live_http::*
  include: driftspec@driftspec@live_mcp::*
}

diagram CL_NativeModule {                       // the extension: the workspace it holds in the engine
  kind: class
  include: driftspec@driftspec@_native::*
}
