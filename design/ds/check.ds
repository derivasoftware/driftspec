// LLD of the check namespace (ds::check): the bound model resolved and checked.
// Every reference resolves outward through its scopes and then the extern
// catalogue; what nobody declares becomes an expected node reported once;
// behaviours are unified under their subject and checked against the static
// context (SREQ-00002-1, SREQ-00004-1).

package driftspec@ds {

  module check {

    class Checker {                          // realises the language rule by rule: each member names its requirement
      @requirement REQ-00053-1
      @requirement REQ-00012-1
      - owns renamed_: std::map<std::string, std::string>
      - refs model_: model::Model
      - owns reported_: std::set<std::string>
      - owns results_: std::map<std::string, std::map<std::string, std::pair<std::string, std::string>>>
      + Checker(model: model::Model)
      + run(binder: bind::Binder) -> void
      + resolve(name: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      + externsNamed(name: std::string) -> std::vector<std::string> {
        @requirement REQ-00024-2
      }
      + derives(derived: std::string, base: std::string) -> bool {
        @requirement REQ-00029-1
      }
      - resolveReference(reference: bind::Reference) -> void {
        @requirement REQ-00043-1
        @requirement REQ-00053-1
        @constraint CST-00006-1
      }
      - checkMessage(message: bind::Message) -> void {
        @requirement REQ-00037-1
        @requirement REQ-00056-1
      }
      - call(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00037-1
      }
      - checkEvent(event: bind::Event) -> void {
        @requirement REQ-00039-1
        @requirement REQ-00040-1
      }
      - checkLocals() -> void {
        @requirement REQ-00036-2
      }
      - checkArtefacts() -> void {
        @requirement REQ-00045-1
      }
      - checkExtensions() -> void {
        @constraint CST-00003-1
      }
      - unifyBehaviours() -> void {
        @requirement REQ-00035-1
      }
      - current(id: std::string) -> std::string {
        @requirement REQ-00035-1
      }
      - resolveTypeText(text: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      - subjectClass(sequence: model::Entity, subject: model::Entity) -> model::Entity {
        @requirement REQ-00036-2
      }
      - couple(sequence: model::Entity, type: model::Entity, transient: bool) -> void {
        @requirement REQ-00038-2
      }
      - typeOfName(sequence: model::Entity, cls: model::Entity, subject: model::Entity, name: std::string, value: std::pair<std::string, std::string>, transient: bool) -> bool {
        @requirement REQ-00036-2
      }
      - checkArguments(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00058-1
      }
      - compatible(argument: std::pair<std::string, std::string>, parameter: std::pair<std::string, std::string>) -> bool {
        @requirement REQ-00058-1
      }
      - rememberResult(message: bind::Message) -> void {
        @requirement REQ-00058-1
      }
      - expand(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00038-2
      }
      - checkReturn(message: bind::Message) -> void {
        @requirement REQ-00059-1
      }
      - checkInterfaces() -> void {
        @requirement REQ-00060-1
      }
      - outcomeOf(sequence: std::string, seen: std::set<std::string>) -> std::string {
        @requirement REQ-00060-1
      }
      - checkViews(state: model::Entity) -> void {
        @requirement REQ-00061-1
      }
      - checkTemplateBound(reference: bind::Reference) -> void {
        @requirement REQ-00029-1
      }
      - checkOwnershipCycles() -> void {
        @requirement REQ-00028-1
      }
      - classify() -> void {
        @requirement REQ-00031-1
      }
    }

    // What ds check does, in order: the first behaviour of this design. The results
    // of the messages are remembered as they go, since each exists only for the
    // messages after it.
    sequence Checker::run {
      self -> binder.references() -> references
      loop each reference {
        -> resolveReference(reference)
      }
      -> unifyBehaviours()
      loop each reference {
        -> checkTemplateBound(reference)
      }
      self -> binder.messages() -> messages
      loop each message {
        -> checkMessage(message)
        -> rememberResult(message)
      }
      -> checkLocals()
      self -> binder.events() -> events
      loop each event {
        -> checkEvent(event)
      }
      -> checkInterfaces()
      -> checkOwnershipCycles()
      -> classify()
      -> checkArtefacts()
      -> checkExtensions()
    }
  }
}

diagram SEQ_CheckerRun {
  kind: sequence
  include: driftspec@ds@check::Checker::run
}

diagram CL_CheckNamespace {
  kind: class
  include: driftspec@ds@check::*
  show: ownership
}
