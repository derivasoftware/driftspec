// LLD of the check namespace (ds::check): the bound model resolved and checked.
// Every reference resolves outward through its scopes and then the extern
// catalogue; what nobody declares becomes an expected node reported once;
// behaviours are unified under their subject and checked against the static
// context (SREQ-00002-1, SREQ-00004-1).

package driftspec@ds {

  module check {

    class Checker {                          // realises the language rule by rule: each member names its requirement
      @requirement REQ-00053-1
      @requirement REQ-00012-1
      - owns renamed_: std::map<std::string, std::string>
      - refs model_: model::Model
      - owns reported_: std::set<std::string>
      - owns results_: std::map<std::string, std::map<std::string, std::pair<std::string, std::string>>>
      + Checker(model: model::Model)
      + run(binder: bind::Binder) -> void
      + resolve(name: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      + externsNamed(name: std::string) -> std::vector<std::string> {
        @requirement REQ-00024-2
      }
      + derives(derived: std::string, base: std::string) -> bool {
        @requirement REQ-00029-1
      }
      - resolveReference(reference: bind::Reference) -> void {
        @requirement REQ-00043-1
        @requirement REQ-00053-1
        @constraint CST-00006-1
      }
      - checkMessage(message: bind::Message) -> void {
        @requirement REQ-00037-1
        @requirement REQ-00056-1
      }
      - call(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00037-1
      }
      - checkEvent(event: bind::Event) -> void {
        @requirement REQ-00039-1
        @requirement REQ-00040-1
      }
      - checkLocals() -> void {
        @requirement REQ-00036-2
      }
      - checkArtefacts() -> void {
        @requirement REQ-00045-1
      }
      - checkExtensions() -> void {
        @constraint CST-00003-1
      }
      - unifyBehaviours() -> void {
        @requirement REQ-00035-1
      }
      - current(id: std::string) -> std::string {
        @requirement REQ-00035-1
      }
      - resolveTypeText(text: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      - subjectClass(sequence: model::Entity, subject: model::Entity) -> model::Entity {
        @requirement REQ-00036-2
      }
      - couple(sequence: model::Entity, type: model::Entity, transient: bool) -> void {
        @requirement REQ-00038-2
      }
      - typeOfName(sequence: model::Entity, cls: model::Entity, subject: model::Entity, name: std::string, value: std::pair<std::string, std::string>, transient: bool) -> bool {
        @requirement REQ-00036-2
      }
      - checkArguments(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00058-2
      }
      - compatible(argument: std::pair<std::string, std::string>, parameter: std::pair<std::string, std::string>) -> bool {
        @requirement REQ-00058-2
      }
      - rememberResult(message: bind::Message) -> void {
        @requirement REQ-00058-2
      }
      - expand(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00038-2
      }
      - checkReturn(message: bind::Message) -> void {
        @requirement REQ-00059-1
      }
      - privateOnTheWay(from: std::string, target: std::string) -> std::string {
        @requirement REQ-00063-1
      }
      - checkVisibility(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
      - checkLeak(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
      - checkScenarios() -> void {
        @requirement REQ-00065-1
      }
      - checkDiagrams() -> void {
        @requirement REQ-00049-2
      }
      - checkInterfaces() -> void {
        @requirement REQ-00060-1
      }
      - outcomeOf(sequence: std::string, path: std::string, seen: std::set<std::string>) -> std::string {
        @requirement REQ-00060-1
      }
      - checkViews(state: model::Entity) -> void {
        @requirement REQ-00061-1
      }
      - checkTemplateBound(reference: bind::Reference) -> void {
        @requirement REQ-00029-1
      }
      - checkOwnershipCycles() -> void {
        @requirement REQ-00028-1
      }
      - classify() -> void {
        @requirement REQ-00031-1
      }
    }

    // What ds check does, in order: the first behaviour of this design. The results
    // of the messages are remembered as they go, since each exists only for the
    // messages after it.
    sequence Checker::run {
      self -> binder.references() -> references
      loop each reference {
        -> resolveReference(reference)
      }
      -> unifyBehaviours()
      self -> binder.references() -> references
      loop each reference {
        -> checkTemplateBound(reference)
      }
      self -> binder.messages() -> messages
      loop each message {
        -> checkMessage(message)
        -> rememberResult(message)
      }
      -> checkLocals()
      self -> binder.events() -> events
      loop each event {
        -> checkEvent(event)
      }
      -> checkInterfaces()
      -> checkDiagrams()
      -> checkScenarios()
      -> checkOwnershipCycles()
      -> classify()
      -> checkArtefacts()
      -> checkExtensions()
    }

    // How a name resolves, one scenario per place it can be found. The default is
    // the common one: found in a scope, walking outward from where it was written.
    // Stripping the revision and building each candidate are free helpers of the
    // implementation: bare and candidate appear here without their origin.
    // The heart of ds, as one behaviour: a chain of "if this, it ends here". Each named
    // branch is a scenario, a path through it; what they all share is written once.
    sequence Checker::checkMessage {
      local subject: model::Entity
      local value: std::pair<std::string, std::string>
      local transient: bool
      local home: std::string
      local typeId: std::string
      local opId: std::string
      local finding: model::Finding

      opt it is a return of the behaviour, not a call / a-return {
        -> checkReturn(message)
        return
      }

      -> current(message.sequence) -> sequenceId
      self -> model_.find(sequenceId) -> seq
      -> current(message.message) -> messageId
      self -> model_.find(messageId) -> msg
      opt the behaviour or the message is gone from the model / unknown-message {
        return
      }

      -> subjectClass(seq, subject) -> cls
      opt nothing declares the subject yet, it waits / subject-waits {
        return
      }

      // A call with no target, from a function always, from a method when its class does
      // not declare the name: a function of the module, resolved outward like any name.
      opt a call to self the class does not declare {
        -> resolve(message.op, home) -> id
        self -> model_.find(id) -> target
        opt it is a function of the module / function {
          -> couple(seq, target, true)
          -> call(msg, target, message)
          return
        }
        opt the caller is itself a function / no-function {
          self -> model_.report(finding)
          return
        }
      }

      // Who it is called on: self, or a name of the context of the behaviour.
      alt the target is self / on-self {
      } else {
        -> typeOfName(seq, cls, subject, message.to, value, transient) -> known
        opt the context has nothing by that name / unknown-participant {
          self -> model_.report(finding)
          return
        }
        -> resolveTypeText(value.first, value.second) -> typeId
      }

      opt a primitive or an unknown spelling, nothing to check / no-type {
        return
      }
      self -> model_.find(typeId) -> type
      opt the type is not declared yet, reported once it is / type-waits {
        return
      }

      opt the target is not self {
        -> couple(seq, type, transient)
      }
      self -> model_.find(opId) -> op
      opt the type does not declare the operation / undeclared-op {
        self -> model_.report(finding)
        return
      }
      -> call(msg, op, message)
    }

    sequence Checker::resolve {
      local bare: std::string
      local candidate: std::string
      self -> model_.find(name)
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      loop each scope, from the innermost outward, until one declares it {
        self -> model_.find(candidate)
      }
      return candidate
    }

    sequence Checker::resolve / declared {       // a full id, a global artefact, a package
      self -> model_.find(name)
      return name
    }

    sequence Checker::resolve / revision {       // the id, written with a revision the model does not key on
      local bare: std::string
      self -> model_.find(name)
      self -> model_.find(bare)
      return bare
    }

    sequence Checker::resolve / absolute {       // has a package path and nobody declares it: no scope is tried
      local bare: std::string
      self -> model_.find(name)
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      return ""
    }

    // The one extern of that name. The code returns externs.front(), an expression:
    // no return can say it, so this trace ends at the call.
    sequence Checker::resolve / extern {
      local bare: std::string
      local candidate: std::string
      self -> model_.find(name)
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      loop each scope, from the innermost outward {
        self -> model_.find(candidate)
      }
      -> externsNamed(name) -> externs
    }

    sequence Checker::resolve / unresolved {     // no scope has it, and no extern or several have that name
      local bare: std::string
      local candidate: std::string
      self -> model_.find(name)
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      loop each scope, from the innermost outward {
        self -> model_.find(candidate)
      }
      -> externsNamed(name) -> externs
      return ""
    }

    // Every extern class or enum of that simple name, in any arity. Filling out and
    // testing each entity are not messages: std is names only, and a loop variable
    // is not a participant.
    sequence Checker::externsNamed {
      local out: std::vector<std::string>
      self -> model_.entities() -> entities
      return out
    }

    sequence Checker::externsNamed / exact {     // exactly one of those found has the arity of the use
      local exact: std::vector<std::string>
      self -> model_.entities() -> entities
      return exact
    }

    sequence Checker::externsNamed / qualified { // a name with a path is no extern's simple name: out stays empty
      local out: std::vector<std::string>
      return out
    }

    // Walks the inherits relations up from derived. The stack of pending names and
    // the set of seen ones are std containers, whose operations the design does not have.
    sequence Checker::derives {
      loop while names are pending and the last taken is not base {
        opt the name was not seen before {
          self -> model_.relations() -> relations
        }
      }
      return true
    }

    sequence Checker::derives / itself {         // derived is base: no relation is read
      return true
    }

    sequence Checker::derives / unrelated {      // nothing pending is left, and base never came up
      loop while names are pending {
        opt the name was not seen before {
          self -> model_.relations() -> relations
        }
      }
      return false
    }

  }
}

diagram SEQ_CheckerRun {
  kind: sequence
  include: driftspec@ds@check::Checker::run
}

diagram CL_CheckNamespace {
  kind: class
  include: driftspec@ds@check::*
  show: ownership
}

diagram SEQ_CheckMessage {                 // the whole behaviour, every branch with its frame
  kind: sequence
  include: driftspec@ds@check::Checker::checkMessage
}

diagram SEQ_CheckMessageUndeclared {       // one scenario: what is shared, then its branch
  kind: sequence
  include: driftspec@ds@check::Checker::checkMessage / undeclared-op
}
