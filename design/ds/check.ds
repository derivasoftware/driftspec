    class StructureCheck : ACheck {        // ownership, artefacts, extensions and fields
      @requirement REQ-00028-2
      @requirement REQ-00045-1
      + StructureCheck(context: Context)                 // given what it reads once, when it is made (DS-425)
      @constraint CST-00003-2
      @requirement REQ-00067-1
      @requirement REQ-00118-1
      @requirement REQ-00168-1
      - refs context_: Context
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      - refs resolver_: Resolver
      - owns many found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
      - checkOwnershipCycles() -> void {
        @requirement REQ-00028-2
      }
      - checkCycles(relation: std::string, code: model::Code, verb: std::string) -> void {
        @requirement REQ-00118-1
      }
      - checkRefinesUpward() -> void {
        @requirement REQ-00118-1
      }
      - checkSatisfiesHome() -> void {
        @requirement REQ-00168-1
      }
      - checkArtefacts() -> void {
        @requirement REQ-00045-1
        @requirement REQ-00124-2
      }
      - realised(requirement: std::string, satisfied: std::set<std::string>, refinedBy: std::map<std::string, std::vector<std::string>>, seen: std::set<std::string>) -> bool {
        @requirement REQ-00124-2              // satisfied, or every requirement that refines it realised (DS-429)
      }
      - checkExtensions() -> void {
        @constraint CST-00003-2
      }
      - checkFields() -> void {
        @requirement REQ-00067-1
        @requirement REQ-00115-2
      }
