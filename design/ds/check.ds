// LLD of the check namespace (ds::check): the bound model resolved and checked.
// Every reference resolves outward through its scopes and then the extern
// catalogue; what nobody declares becomes an expected node reported once;
// behaviours are unified under their subject and checked against the static
// context (SREQ-00002-1, SREQ-00004-1).

package driftspec@ds {

  module check {

    // Datalog with stratified negation over the finite model: every structural rule is decided (DS-94).
    // The facts are the declared entities by kind, every relation both ways and containment; a
    // definition is computed bottom-up to its fixpoint, stratum by stratum, and a rule is broken by
    // each binding of its ranges where holds has no answer or never has one.
    // ---- the evaluator in its pieces (DS-380), as a requirement and the rule that holds it -------------------------
    requirement REQ-00192-1 {
      tags: architecture, check, rules
      status: approved
      @refines REQ-00096-1
      title: The evaluator shall direct four pieces, and the solver shall read the facts and never the model
      text:
        Facts reads the model once into what a rule is evaluated over: the declared entities of each kind, every
        relation both ways, the names a formula writes resolved, and what each definition holds for; it is the
        pieces' one reader of the model. RuleValidator checks each formula before it is evaluated, Strata orders the
        definitions, and Solver answers a body over the facts alone. Evaluator directs them: it records into the
        facts what the validator resolved and what the definitions derive, and writes the breaches and the tables
        into the model.
      rationale:
        Owner, 2026-11-24 (DS-378, DS-380): one class did five things; split, the solver can run over facts
        without a design, and each piece can be read and tested on its own.
      verification VER-00212-1 {
        status: approved
        title: Integration tests confirm the design of ds keeps the solver on the facts, and is told when the solver depends on the model
        method: test
        tests:
          tests/integration/ds/check/test_evaluator_principles.cpp::TestEvaluatorPrinciples.TheDesignOfDsKeepsTheSolverOnTheFacts
          tests/integration/ds/check/test_evaluator_principles.cpp::TestEvaluatorPrinciples.ASolverThatReadsTheModelIsTold
      }
    }

    rule the-solver-reads-facts {
      title: the solver reads facts and never the model, so the rule engine runs without a design
      @requirement REQ-00192-1
      for class c in driftspec@ds@check
      where c = driftspec@ds@check::Solver
      never depends(c, driftspec@ds@model::Model)
    }

    // ---- the check as a runner of steps, as requirements and the rules that hold them (DS-383) ----------------
    // The checker runs what it is given through IStep and knows no concrete step; StepFactory is the one place that names
    // them. A step reads what the steps it needs wrote into the model, never those steps; and every operation of
    // the check is a member of the class whose responsibility it is.
    requirement REQ-00194-2 {
      tags: architecture, check
      status: approved
      @refines REQ-00053-3
      title: The checker shall run each step of the check through IStep, and no step shall know another
      text:
        The checker is handed the steps, keyed by name, and runs each one after the steps it needs, knowing each only
        as an IStep; StepFactory is the one place that names the concrete steps. A step reads what the steps it needs
        wrote into the model, and never holds, calls or makes another step, so a step added, removed or split leaves
        the checker and the other steps as they are.
      rationale:
        Owner, 2026-11-24 (DS-378, DS-383): a requirement is often an architecture decision, and the rules make it
        hold. ContractCheck split into five (DS-382) without touching the checker, because the checker and the steps
        already kept to it.
      verification VER-00214-1 {
        status: approved
        title: Integration tests confirm the design of ds runs the steps through IStep with no step knowing another, and is told when the checker holds a concrete step or one step knows another
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheCheckerHoldingAConcreteStepIsTold
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.AStepThatKnowsAnotherIsTold
      }
    }

    requirement REQ-00195-2 {
      tags: architecture, check
      status: approved
      @refines REQ-00053-3
      title: Every operation of the check shall be a member of the class whose responsibility it is
      text:
        What a step checks is the step's, what resolves a name is the resolver's, what decides a rule is one of the
        evaluator's pieces, and what makes the steps is StepFactory's. A function of the module would be a responsibility
        no class names.
      rationale:
        Owner, 2026-11-24 (DS-378, DS-382, DS-383): the hidden helpers of the steps became members of their step;
        the rule keeps a new one from being written outside a class.
      verification VER-00215-1 {
        status: approved
        title: Integration tests confirm the design of the check holds no function of the module, and is told when one is written
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.AFunctionOfTheCheckIsTold
      }
    }

    definition is-step(x) {
      title: x is a step of the check: it inherits IStep, itself or through ACheck
      if x inherits driftspec@ds@check::IStep
      if x inherits driftspec@ds@check::ACheck
    }

    rule checker-knows-steps-as-istep {
      title: the checker holds the steps as IStep and names none of the concrete ones, so every step is run through the one interface
      @requirement REQ-00194-2
      for class c in driftspec@ds@check
      where c = driftspec@ds@check::Checker
      never depends(c, x), is-step(x)
    }

    rule no-step-knows-another {
      title: a step depends on no other step, so each reads what the steps it needs wrote into the model and never the steps themselves
      @requirement REQ-00194-2
      for class a in driftspec@ds@check, class b in driftspec@ds@check
      where is-step(a), is-step(b), a != b, b != driftspec@ds@check::ACheck
      never depends(a, b)
    }

    rule check-operations-belong-to-classes {
      title: no function is written in the check's module, so every operation of the check is a member of a class
      @requirement REQ-00195-2
      for function f in driftspec@ds@check
      never f in driftspec@ds@check
    }

    class Evaluator {                        // decides the structural rules over the model: it directs the four pieces (DS-380)
      @requirement REQ-00096-1
      @requirement REQ-00097-1
      @requirement REQ-00098-1
      @requirement REQ-00192-1
      - refs model_: model::Model            // written: the breaches and the tables; read through the facts
      - refs metamodel_: model::Metamodel     // the language of the rules: the kinds and relations they name (DS-351)
      - owns facts_: Facts
      - owns validator_: RuleValidator
      - owns strata_: Strata
      - owns solver_: Solver
      - owns many found_: std::vector<model::Finding>
      - owns invalid_: std::set<std::string>
      - owns variables_: std::map<std::string, Variables>   // each formula's variables and their slots (DS-381)
      - kReportsPerRule: std::size_t            // how many findings a broken rule gets; the rest are counted in one
      + Evaluator(model: model::Model, metamodel: model::Metamodel, resolver: Resolver)
      + run() -> std::vector<model::Finding>
      - computeDefinitions() -> void
      - evaluateRule(id: std::string, formula: model::Formula) -> void
      - tabulate(id: std::string, formula: model::Formula) -> void {
        @requirement REQ-00154-1
      }
      - report(code: model::Code, owner: std::string, message: std::string, at: model::Location) -> void
      - through(owner: std::string, claim: std::vector<model::Literal>, variables: Variables, answer: std::vector<const std::string*>) -> std::string {
        @requirement REQ-00096-1
      }
      - static describe(bindings: std::vector<std::pair<std::string, std::string>>) -> std::string
    }

    // Every text a binding points at lives in the facts or among the solver's own texts: storage the evaluation owns,
    // that does not move while it runs (DS-381). What holds what is copied from the index once, so no binding points
    // into the model, which the evaluator writes breaches and tables into while it runs.
    class Facts {                            // the model as facts a rule is evaluated over; the pieces' one reader of the model (DS-380)
      @requirement REQ-00096-1
      @requirement REQ-00192-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      - owns byKind_: std::map<std::string, std::vector<std::string>>
      - owns forward_: std::map<std::string, std::multimap<std::string, std::string>>
      - owns backward_: std::map<std::string, std::multimap<std::string, std::string>>
      - owns constants_: std::map<std::string, std::string>
      - owns patterns_: std::map<std::string, std::regex>                        // the patterns formulas match against, compiled (DS-403)
      - owns extension_: std::map<std::string, std::set<std::vector<std::string>>>
      - owns parent_: std::unordered_map<std::string, std::string>                 // what holds each entity, copied from the index (DS-381)
      - owns children_: std::unordered_map<std::string, std::vector<std::string>>  // what each entity holds, in the index's order
      - readers_: std::size_t                                                      // solves reading now: the facts do not grow meanwhile
      + Facts(model: model::Model, metamodel: model::Metamodel)
      + index() -> void
      + ofKind(kind: std::string) -> std::vector<std::string>
      + forward(relation: std::string) -> std::multimap<std::string, std::string>
      + backward(relation: std::string) -> std::multimap<std::string, std::string>
      + record(owner: std::string, written: std::string, identity: std::string) -> void
      + constant(owner: std::string, written: std::string, out_identity: std::string) -> bool
      + constantOf(owner: std::string, written: std::string) -> std::string   // where the facts keep it; none when never resolved
      + definitionOf(owner: std::string, name: std::string) -> std::string
      + derived(definition: std::string) -> std::set<std::vector<std::string>>
      + derive(definition: std::string, tuple: std::vector<std::string>) -> bool
      + reading() -> void                    // a solve starts reading the facts
      + done() -> void
      + formulas() -> std::map<std::string, model::Formula>
      + kindIs(id: std::string, kind: model::Kind) -> bool
      + kindOf(id: std::string, out_kind: model::Kind) -> bool
      + isOfKind(id: std::string, kind: std::string) -> bool
      + scopeOf(id: std::string) -> std::string
      + locationOf(id: std::string) -> model::Location
      + fieldOf(id: std::string, field: std::string) -> std::string
      + propertyOf(id: std::string, property: std::string) -> std::string {     // name(x), id(x), kind(x) (DS-403)
        @requirement REQ-00196-1
      }
      + flagged(id: std::string, flag: std::string) -> bool {                    // m is abstract (DS-403)
        @requirement REQ-00196-1
      }
      + learn(owner: std::string, written: std::string, pattern: std::regex) -> void {
        @requirement REQ-00196-1
      }
      + patternOf(owner: std::string, written: std::string) -> std::regex {       // as compiled; none when never compiled
        @requirement REQ-00196-1
      }
      + holds(rule: std::string) -> bool
      + parentOf(id: std::string) -> std::string                        // where the facts keep it; none at the top
      + childrenOf(id: std::string) -> std::vector<std::string>         // where the facts keep them; none when it holds nothing
      + contains(outer: std::string, inner: std::string) -> bool
      + argsTo(call: std::string) -> std::vector<std::pair<std::string, std::string>>
      - static key(owner: std::string, written: std::string) -> std::string
    }

    class RuleValidator {                    // whether each formula is well formed before it is evaluated (DS-380)
      @requirement REQ-00097-1
      - refs metamodel_: model::Metamodel
      - refs resolver_: Resolver
      - refs facts_: Facts
      - owns many found_: std::vector<model::Finding>
      - owns many patterns_: std::vector<std::pair<std::string, std::regex>>      // compiled since the last takePatterns (DS-403)
      + RuleValidator(metamodel: model::Metamodel, resolver: Resolver, facts: Facts)
      + validate(id: std::string, formula: model::Formula, out_resolved: std::vector<std::pair<std::string, std::string>>) -> bool
      + checkVacuity(id: std::string, formula: model::Formula) -> void {
        @requirement REQ-00117-1
      }
      + take() -> std::vector<model::Finding>
      + takePatterns() -> std::vector<std::pair<std::string, std::regex>> {     // each compiled once (DS-403)
        @requirement REQ-00196-1
      }
      - validateBody(id: std::string, body: std::vector<model::Literal>, out_bound: std::set<std::string>, out_resolved: std::vector<std::pair<std::string, std::string>>) -> bool
      - validatePattern(id: std::string, l: model::Literal) -> bool {          // a string that compiles (DS-403)
        @requirement REQ-00196-1
      }
      - report(code: model::Code, owner: std::string, message: std::string, at: model::Location) -> void
      - static joinsAtEnd(spec: model::RelationSpec, kind: model::Kind, from: bool) -> bool
    }

    class Strata {                           // the order the definitions are computed in (DS-380)
      @requirement REQ-00096-1
      - refs facts_: Facts
      - stratum_: std::map<std::string, int>
      + Strata(facts: Facts)
      + stratify(invalid: std::set<std::string>) -> std::vector<std::string>
      + levels(invalid: std::set<std::string>) -> std::map<int, std::vector<std::string>>
      + dependencyOrder(definitions: std::vector<std::string>) -> std::vector<std::string>  // a stratum in the order of what it applies; empty when it recurses (DS-338)
    }

    // A binding is a vector with one slot per variable of the formula, in the order Variables gives them: each slot
    // points at the text its variable is bound to, in the facts or among the solver's texts, or is none while unbound
    // (DS-381). A candidate copies a few pointers and never a string.
    class Solver {                           // answers a body over the facts, never the model (DS-380)
      @requirement REQ-00096-1
      @requirement REQ-00192-1
      - refs facts_: Facts
      - owns texts_: std::unordered_set<std::string>   // what it binds from outside the facts, each once; an element never moves (DS-381)
      + Solver(facts: Facts)
      + solve(owner: std::string, body: std::vector<model::Literal>, variables: Variables, bindings: std::vector<const std::string*>, first: bool) -> std::vector<std::vector<const std::string*>>
      + static compares(form: model::LiteralForm) -> bool
      // one working binding, bound, continued and undone: nothing copied per answer (DS-401)
      - solveFrom(owner: std::string, body: std::vector<model::Literal>, variables: Variables, done: std::vector<bool>, work: std::vector<const std::string*>, first: bool, out_answers: std::vector<std::vector<const std::string*>>) -> bool
      - ready(literal: model::Literal, variables: Variables, bindings: std::vector<const std::string*>) -> bool
      - answers<Next>(owner: std::string, literal: model::Literal, variables: Variables, work: std::vector<const std::string*>, next: Next) -> bool
      - value(owner: std::string, term: model::Term, variables: Variables, bindings: std::vector<const std::string*>) -> std::string
      - unify(owner: std::string, term: model::Term, variables: Variables, entity: std::string, out_bindings: std::vector<const std::string*>) -> bool
      - text(text: std::string) -> std::string
      - static number(text: std::string, out_number: double) -> bool
      - static literal(text: std::string) -> bool
      - static compare(form: model::LiteralForm, a: std::string, z: std::string) -> bool
    }

    class Variables {                        // a formula's variables, each given a fixed slot once, in the order of their names (DS-381)
      @requirement REQ-00096-1
      - owns many names_: std::vector<std::string>
      + Variables(formula: model::Formula)
      + size() -> std::size_t
      + slotOf(name: std::string) -> int
      + name(slot: std::size_t) -> std::string
      + before(a: std::vector<const std::string*>, b: std::vector<const std::string*>) -> bool   // as a map of name to text would sort them
      + pairs(bindings: std::vector<const std::string*>) -> std::vector<std::pair<std::string, std::string>>
      - collect(body: std::vector<model::Literal>) -> void
    }

    // Read-only questions about the model: what a name means where it is written, what a type inherits
    // and holds, what is private on a way down (DS-125). The checker and the evaluator ask it.
    class Resolver {
      @requirement REQ-00023-1
      - refs model_: model::Model
      + Resolver(model: model::Model)
      + resolve(name: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
        @requirement REQ-00169-2
      }
      // the classes a bare name could be when two or more of its package share it (DS-325)
      + ambiguous(name: std::string, scope: std::string) -> std::vector<std::string> {
        @requirement REQ-00169-2
        @requirement REQ-00253-1               // and the overloads an operation named bare could be (DS-455)
      }
      + derives(derived: std::string, base: std::string) -> bool {
        @requirement REQ-00029-2
      }
      + member(type: std::string, name: std::string, argc: int) -> model::Entity {   // of its overloads, the one a call of argc arguments can call (DS-455)
        @requirement REQ-00036-2
        @requirement REQ-00253-1
      }
      + overloadsOf(type: std::string, name: std::string, argc: int) -> std::vector<std::string> {   // DS-455
        @requirement REQ-00253-1
      }
      + resolveTypeText(text: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
        @requirement REQ-00058-3
      }
      // the one class of a name in the package of a scope, as argos finds it in the code (DS-18)
      - inPackage(name: std::string, scope: std::string) -> std::string {
        @requirement REQ-00169-2
      }
      - namesakes(name: std::string, scope: std::string) -> std::vector<std::string> {  // every class of the name in the package
        @requirement REQ-00169-2
      }
      + privateOnTheWay(from: std::string, target: std::string) -> std::string {
        @requirement REQ-00063-1
      }
    }

    // What a check of a workspace says: its findings in order and the counts of the model (DS-120);
    // built once from the model, written by its formats without it (DS-126)
    dataclass Report {
      @requirement REQ-00106-4
      + many findings: std::vector<model::Finding>
      + many coverage: std::vector<model::Finding>
      + entities: int
      + expected: int
      + relations: int
      + errors: int                          // findings of a severity that fails
      + many severities: std::vector<model::SeveritySpec>   // what each severity means, copied from the metamodel (DS-379)
      + static of(model: model::Model, metamodel: model::Metamodel) -> Report  // the report of a checked model
      + severityOf(severity: model::Severity) -> model::SeveritySpec          // what the formats ask (DS-379)
    }


    // One step of the check (DS-138): its key, the steps it needs done before it, and what it found,
    // which it gives back. The checker orders the steps by what they need and runs them, knowing none of them.
    class IStep {
      @requirement REQ-00012-1
      + ~IStep()
      + abstract name() -> std::string
      + abstract needs() -> std::vector<std::string>
      + abstract run() -> std::vector<model::Finding>   // over the context it was made with (DS-425)
    }

    // A step that only checks (DS-138): run hands check the context to read, whose model is const,
    // so no check can change the model; what it finds it gives back. The one abstract class here.
    class ACheck : IStep {
      @requirement REQ-00012-1
      + run() -> std::vector<model::Finding>
      - abstract check() -> std::vector<model::Finding>
    }

    // What every step of one check is given: the model, the metamodel it is written in, what the binder
    // collected, the resolver, the renames linking made, what was already reported as undeclared, and
    // what the running step found, until it takes it back.
    class Context {
      @requirement REQ-00199-1
      @requirement REQ-00012-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel     // the language, handed by the checker to every step (DS-351)
      - owns resolver_: Resolver              // made once with the context, for every run (DS-425)
      - owns renamed_: std::map<std::string, std::string>
      - owns reported_: std::set<std::string>
      - owns many found_: std::vector<model::Finding>
      + Context(model: model::Model, metamodel: model::Metamodel)   // once, for every run of one checker (DS-425)
      + reset(notes: bind::Notes) -> void {   // a run starts over: its notes, and nothing of the run before (DS-425)
        @requirement REQ-00012-1
      }
      + model() -> model::Model
      + metamodel() -> model::Metamodel
      + resolver() -> Resolver
      + current(id: std::string) -> std::string {
        @requirement REQ-00035-1
      }
      + renamed() -> std::map<std::string, std::string>
      + reported() -> std::set<std::string>
      + report(finding: model::Finding) -> void
      + take() -> std::vector<model::Finding>
      + checkVisibility(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
      + checkLeak(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
      - refs notes_: bind::Notes
      + notes() -> bind::Notes
    }

    // The check module's entry point (DS-138): what the rest of ds asks of a check.
    class IChecker {
      @requirement REQ-00053-3
      + ~IChecker()
      + abstract run(notes: bind::Notes) -> void
    }

    // The one place that makes the checker (DS-404): what asks for a check holds it as the IChecker it is.
    class CheckerFactory {
      @requirement REQ-00197-1
      @requirement REQ-00053-3
      + static make(model: model::Model, metamodel: model::Metamodel, selection: Selection) -> std::unique_ptr<IChecker>
    }

    // A checker made for a selection of steps (DS-425): it holds the context, the steps made with it and the checker
    // that runs them, so what the factory hands back lives as long as it is held.
    class SelectedChecker : IChecker {
      @requirement REQ-00199-1
      @requirement REQ-00053-3
      - owns context_: Context
      - owns many steps_: std::map<std::string, std::unique_ptr<IStep>>
      - owns checker_: Checker
      + SelectedChecker(model: model::Model, metamodel: model::Metamodel, selection: Selection)
      + run(notes: bind::Notes) -> void
    }

    // A runner of steps: it orders the steps it is given by what each needs, runs them over one
    // context and adds what each found to the model when it ends. The map is built outside and
    // outlives it.
    class Checker : IChecker {               // realises the language step by step: each step names its requirements
      @requirement REQ-00053-3
      @requirement REQ-00012-1
      - refs context_: Context                // the model, its language and the resolver, reset for each run (DS-425)
      - refs many steps_: std::map<std::string, std::unique_ptr<IStep>>
      + Checker(context: Context, steps: std::map<std::string, std::unique_ptr<IStep>>)
      + run(notes: bind::Notes) -> void
      + resolver() -> Resolver
      + order() -> std::vector<std::string>
    }

    // the one place that names each step: it pairs each with what it does, makes the ones a selection names and
    // every one they need, and keys them by name (DS-376); a class, as every operation of check is (DS-382)
    class StepFactory {
      @requirement REQ-00197-1
      @requirement REQ-00012-1
      @requirement REQ-00085-2
      + static of(context: Context, selection: Selection) -> std::map<std::string, std::unique_ptr<IStep>>   // each made with the context (DS-425)
    }

    // Each step of the check, by what it does (DS-376): what a selection is made of. StepFactory::of pairs each with the
    // step it makes, so the names the steps are keyed by stay theirs.
    enum Step {
      @requirement REQ-00085-2
      @constraint CST-00001-1
      Linker, Behaviour, Derivation, Failures, Interfaces, UseCases, Diagrams, Scenarios, FailureChecks, Structure, Dependencies, Rules, Levels, States, Order, Walkthroughs
    }

    // The steps of the check a load runs (DS-376): chosen by the Api for what the load is to give, and read by
    // StepFactory::of, which makes them and every step they need. The checker runs what it is given and knows nothing
    // of it; a drawing that runs fewer steps reads the same model where it looks.
    class Selection {
      @requirement REQ-00085-2
      @constraint CST-00001-1
      - owns steps_: std::set<Step>
      + static every() -> Selection                   // what the findings, the export, a query and the viewer read
      + static of(steps: std::vector<Step>) -> Selection   // the steps named, and no other
      + with(step: Step) -> Selection                 // the same steps and one more
      + joined(other: Selection) -> Selection         // the steps of both: what a workspace ran for every use case (DS-408)
      + has(step: Step) -> bool
      + covers(other: Selection) -> bool              // every step of other is among these
    }

    // the steps a selection names and every step they need: a step chosen never runs without what it reads
    sequence StepFactory::of {
      local step: IStep
      local made: std::map<std::string, std::unique_ptr<IStep>>
      loop each step of the check {
        self -> selection.has(kind) -> named
      }
      loop each step taken, until none it needs is missing {
        self -> step.needs() -> needs
      }
      return made
    }

    class Linker : IStep {                // references become relations, behaviours take their subject's identity
      @requirement REQ-00043-1
      @requirement REQ-00053-3
      + Linker(context: Context)                 // given what it reads once, when it is made (DS-425)
      @constraint CST-00006-1
      @constraint CST-00003-2
      @requirement REQ-00066-1
      @requirement REQ-00029-2
      @requirement REQ-00035-1
      - refs context_: Context
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      - refs resolver_: Resolver
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run() -> std::vector<model::Finding>
      - resolveReference(reference: bind::Reference) -> void {
        @requirement REQ-00043-1
        @requirement REQ-00053-3
        @constraint CST-00006-1
      }
      - reportAmbiguous(reference: bind::Reference) -> bool {  // a bare name two classes share, said once (DS-325)
        @requirement REQ-00169-2
      }
      - kindAllowed(reference: bind::Reference, target: std::string) -> bool {
        @requirement REQ-00066-1
      }
      - checkTemplateBound(reference: bind::Reference) -> void {
        @requirement REQ-00029-2
      }
      - unifyBehaviours() -> void {
        @requirement REQ-00035-1
      }
      - defineLoneExtensions() -> void {  // a class of annotations only that nothing else defines is the class (DS-20)
        @constraint CST-00003-2
      }
    }

    class BehaviourTyping : IStep {       // messages typed against the static context: calls, types, expansions
      @requirement REQ-00036-2
      @requirement REQ-00038-2
      @requirement REQ-00037-1
      @requirement REQ-00059-2
      @requirement REQ-00056-1
      @requirement REQ-00058-3
      @requirement REQ-00039-1
      @requirement REQ-00040-1
      @requirement REQ-00132-1
      @requirement REQ-00138-1
      + BehaviourTyping(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns results_: std::map<std::string, std::map<std::string, std::pair<std::string, std::string>>>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run() -> std::vector<model::Finding>
      - subjectClass(sequence: model::Entity, subject: model::Entity) -> model::Entity {
        @requirement REQ-00036-2
      }
      - couple(sequence: model::Entity, type: model::Entity, transient: bool) -> void {
        @requirement REQ-00038-2
      }
      - call(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00037-1
      }
      // a call two overloads could still be a call of, by its arguments: W-NAME-AMBIGUOUS (DS-455)
      - reportOverloads(seq: model::Entity, typeId: std::string, message: bind::Message) -> bool {
        @requirement REQ-00253-1
      }
      - expand(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00038-2
      }
      - checkReturn(message: bind::Message) -> void {
        @requirement REQ-00059-2
      }
      - checkMessage(message: bind::Message) -> void {
        @requirement REQ-00037-1
        @requirement REQ-00056-1
      }
      - callStatic(seq: model::Entity, msg: model::Entity, message: bind::Message, home: std::string) -> bool {
        @requirement REQ-00108-1
      }
      // a participant named as what it is: a box, an interface or a class the behaviour sees (DS-232)
      - namedEntity(name: std::string, home: std::string) -> std::string {
        @requirement REQ-00133-2
      }
      // who sends: the participant written before the arrow, typed like the receiver
      - typeSender(seq: model::Entity, cls: model::Entity, subject: model::Entity, msg: model::Entity, home: std::string) -> void {
        @requirement REQ-00134-1
      }
      // the operation a box offers under a name: a function of a module, an operation of one interface of a package
      - offered(box: model::Entity, op: std::string) -> model::Entity {
        @requirement REQ-00135-1
      }
      - typeOfName(sequence: model::Entity, cls: model::Entity, subject: model::Entity, name: std::string, value: std::pair<std::string, std::string>, transient: bool) -> bool {
        @requirement REQ-00036-2
      }
      - compatible(argument: std::pair<std::string, std::string>, parameter: std::pair<std::string, std::string>, literal: bool) -> bool {
        @requirement REQ-00058-3
      }
      - checkArguments(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00058-3
      }
      - rememberResult(message: bind::Message) -> void {
        @requirement REQ-00058-3
      }
      - checkLocals() -> void {
        @requirement REQ-00036-2
      }
      - checkEvent(event: bind::Event) -> void {
        @requirement REQ-00039-1
        @requirement REQ-00040-1
      }
    }

