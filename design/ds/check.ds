    // two levels of one behaviour, both written, agree (DS-233): the scenario of a use case is held to the
    // behaviour of the operation it is asked through, unfolded and lifted onto the scenario's participants
    class LevelCoherence : ACheck {
      @requirement REQ-00136-1
      + LevelCoherence(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context                // what it reads, given at construction (DS-425)
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
      - static calleeOf(model: model::Model, message: std::string) -> std::string     // the operation a message calls (DS-382)
      - static behaviourBelow(model: model::Model, scenario: model::Entity, entry: model::Entity) -> std::pair<std::string, std::string>
      - static collect(model: model::Model, sequence: std::string, path: std::string, on: On, stack: std::set<std::string>, out: Below) -> void
      - static same(said: Crossing, done: Crossing) -> bool
      - static placed(said: std::vector<Crossing>, done: std::vector<Crossing>) -> std::vector<int>   // the longest in-order matching
    }

    dataclass Crossing {                     // one message that crosses from a participant of a scenario to another (DS-382)
      @requirement REQ-00136-1
      + from: std::string
      + to: std::string
      + op: std::string                      // the operation it calls; empty for a label
      + label: std::string                   // the operation as written
      + owns location: model::Location
    }

    dataclass Below {                        // what happens below a scenario's entries (DS-382)
      @requirement REQ-00136-1
      + many crossings: std::vector<Crossing>   // in the order they happen
      + entered: std::set<std::string>          // the participants something is seen to happen in
      + open: std::set<std::string>             // those in which a call is made whose behaviour is not written
    }

    // the states of a machine, written as rules over what its subject holds (DS-249), held to each other
    // and to the structure
    class StateRules : ACheck {
      @requirement REQ-00141-1
      @requirement REQ-00142-1
      + StateRules(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context                // what it reads, given at construction (DS-425)
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
    }

    // the calls of the behaviours written, held to the machine of what they are made on (DS-250)
    class CallOrder : ACheck {
      @requirement REQ-00145-1
      + CallOrder(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context                // what it reads, given at construction (DS-425)
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
      - static either(names: std::vector<std::string>) -> std::string   // the states a call could come from: Open or Paid (DS-382)
    }

    class DependencyCheck : ACheck {       // what a box declares it uses against what its behaviours call
      @requirement REQ-00094-2
      + DependencyCheck(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns many found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
      - checkDependencies() -> void {
        @requirement REQ-00094-2
      }
    }

    class RuleCheck : IStep {             // rules and definitions, decided by the evaluator
      @requirement REQ-00095-2
      + RuleCheck(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      - refs resolver_: Resolver
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run() -> std::vector<model::Finding>
      - checkRules() -> void {
        @requirement REQ-00095-2
      }
    }

    // one failure escaping an operation: the operations it comes up through, and where it starts
    dataclass Escape {
      @requirement REQ-00111-1
      + through: std::vector<std::string>
      + origin: std::string
    }

    class FailureFlow : IStep {           // what failures escape each operation, and the path each comes by (DS-188)
      @requirement REQ-00111-1
      + FailureFlow(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context                // what it reads, given at construction (DS-425)
      - refs model_: model::Model
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run() -> std::vector<model::Finding>
      - handledAround(step: std::string) -> std::set<std::string>
      - originOf(step: std::string, sequence: std::string) -> std::string
      - hasBehaviour(operation: std::string) -> bool
      - callee(message: std::string) -> std::string
      - pass(out_escapes: std::map<std::string, std::map<std::string, Escape>>) -> bool
      - write(escapes: std::map<std::string, std::map<std::string, Escape>>) -> void
    }

    // Until nothing changes: a pass over every behaviour adds what starts in it and what its calls
    // let escape, unless an attempt around the call handles it; then each operation is written.
    sequence FailureFlow::run {
      self -> context_.model() -> model
      loop until a pass adds nothing {
        -> pass(escapes) -> changed
      }
      -> write(escapes)
      self -> context_.take() -> found
      return found
    }

    // What ds check does: the steps, each after the steps that write what it reads. The linker
    // first; behaviour typing and derivation each need only the linker; the checks of contracts and
    // dependencies need the calls typing made; structure and rules read the finished model.
    sequence Checker::run {
      local step: IStep
      local model: model::Model
      self -> context_.reset(notes)          // nothing of a run before stays (DS-425)
      self -> context_.model() -> model
      self -> order() -> keys
      loop each key, in order {
        -> step.run() -> found
        loop each finding found {
          self -> model.report(finding)
        }
      }
      // what is not yet written is no finding: the model keeps apart what its metamodel calls coverage (DS-216)
      self -> model.cover()
    }

    sequence Linker::run {
      -> defineLoneExtensions()
      self -> context_.notes() -> notes
      loop each reference the notes hold {
        -> reportAmbiguous(reference) -> ambiguous
        opt the name is no ambiguity of its package {
          -> resolveReference(reference)
        }
      }
      -> unifyBehaviours()
      loop each reference {
        -> checkTemplateBound(reference)
      }
    }

    // One reference becomes one relation, or a finding. An artefact is linked by its revision: the
    // declared one is asked of the model's index, with no pass over the entities (DS-171).
    sequence Linker::resolveReference {
      opt it names an artefact by its id {
        local name: model::ArtefactName
        self -> name.hasRevision() -> pinned
        opt it carries no revision / unpinned {
          self -> context_.report(finding)
          return
        }
        self -> model_.index() -> index
        self -> index.revisionOf(reference.target) -> declared
        opt the workspace declares another revision of it / drift {
          self -> context_.report(finding)
          self -> model_.relate(relation)
          return
        }
      }
      self -> resolver_.resolve(reference.target, reference.scope) -> target
      opt nothing declares it / undeclared {
        // an expected node takes its place, and it is said once
        self -> model_.declare(expected) -> node
        opt it is no use case and nobody said it yet {
          self -> context_.report(finding)
        }
      }
      opt a package reopened by its path / part-of {
        self -> model_.relate(relation)
        return
      }
      -> kindAllowed(reference, target) -> allowed
      opt the language does not join those two kinds that way / refused {
        return
      }
      self -> model_.relate(relation)
      opt a relation that reaches into another box {
        self -> context_.checkVisibility(reference.from, target, reference.location)
        self -> context_.checkLeak(reference.from, target, reference.location)
      }
    }

    // A member is found where it is declared: the type first, then its bases, nearest first (DS-105).
    sequence Resolver::member {
      loop each level of types, the type first {
        loop each type of the level not seen before {
          self -> model_.find(id) -> found
          opt the type declares it / found {
            return found
          }
          // its bases are the next level, asked of the index
          self -> model_.index() -> index
          self -> index.from(type) -> leaving
        }
      }
      return found
    }

    sequence Facts::contains {
      self -> model_.index() -> index
      loop each holder of inner, outward {
        self -> index.parent(inner) -> up
        opt it is outer / held {
          return true
        }
      }
      return false
    }

    // The results of the messages are remembered as they go: each exists only for the messages after it.
    sequence BehaviourTyping::run {
      self -> context_.notes() -> notes
      loop each message the notes hold {
        -> checkMessage(message)
        -> rememberResult(message)
      }
      -> checkLocals()
      loop each event the notes hold {
        -> checkEvent(event)
      }
    }

    sequence InterfaceContracts::check {
      -> checkInterfaces()
      -> checkRealisations()
    }

    sequence UseCaseContracts::check {
      -> checkUseCases()
    }

    sequence DiagramCheck::check {
      -> checkDiagrams()
    }

    sequence ScenarioCheck::check {
      -> checkScenarios()
    }

    // what FailureFlow wrote, read: the handlers, each operation, method and function, then each use case
    sequence FailureCheck::check {
      -> checkHandlers()
      loop each operation, method and function {
        -> checkFailures(operation)
      }
      loop each use case {
        -> checkScenario(usecase)
      }
    }

    sequence StructureCheck::check {
      -> checkOwnershipCycles()
      -> checkArtefacts()
      -> checkExtensions()
      -> checkFields()
    }

    // The heart of ds, as one behaviour: a chain of "if this, it ends here". Each named
    // branch is a scenario, a path through it; what they all share is written once.
    sequence BehaviourTyping::checkMessage {
      local subject: model::Entity
      local value: std::pair<std::string, std::string>
      local transient: bool
      local home: std::string
      local typeId: std::string
      local opId: std::string
      local finding: model::Finding

      opt it is a return of the behaviour, not a call / a-return {
        -> checkReturn(message)
        return
      }

      self -> context_.current(message.sequence) -> sequenceId
      self -> model_.find(sequenceId) -> seq
      self -> context_.current(message.message) -> messageId
      self -> model_.find(messageId) -> msg
      opt the behaviour or the message is gone from the model / unknown-message {
        return
      }

      -> subjectClass(seq, subject) -> cls
      opt nothing declares the subject yet, it waits / subject-waits {
        return
      }

      // A call with no target, from a function always, from a method when its class does
      // not declare the name: a function of the module, resolved outward like any name.
      opt a call to self the class does not declare {
        self -> resolver_.resolve(message.op, home) -> id
        self -> model_.find(id) -> target
        opt it is a function of the module / function {
          -> couple(seq, target, true)
          -> call(msg, target, message)
          return
        }
        opt the caller is itself a function / no-function {
          self -> context_.report(finding)
          return
        }
      }

      // Who it is called on: self, or a name of the context of the behaviour.
      alt the target is self / on-self {
      } else {
        -> typeOfName(seq, cls, subject, message.to, value, transient) -> known
        opt the context has nothing by that name / unknown-participant {
          self -> context_.report(finding)
          return
        }
        self -> resolver_.resolveTypeText(value.first, value.second) -> typeId
      }

      opt a primitive or an unknown spelling, nothing to check / no-type {
        return
      }
      self -> model_.find(typeId) -> type
      opt the type is not declared yet, reported once it is / type-waits {
        return
      }
      // the message is typed by its target, written through the model that keeps it (DS-346)
      self -> model_.annotate(messageId, key, typeId)

      opt the target is not self {
        -> couple(seq, type, transient)
      }
      self -> model_.find(opId) -> op
      opt the type does not declare the operation / undeclared-op {
        self -> context_.report(finding)
        return
      }
      -> call(msg, op, message)
    }

    // How a name resolves: one scenario per place it can be found. The default is the
    // common one, found in a scope, walking outward from where it was written.
    sequence Resolver::resolve {
      local bare: std::string
      local s: model::Scope
      local written: model::ArtefactName
      self -> model_.find(name)
      opt the model declares it as written: a full id, a global artefact, a package / declared {
        return name
      }
      self -> written.withoutRevision() -> bare
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      opt the model declares the id without its revision / revision {
        return bare
      }
      opt the name has a package path and nobody declares it: no scope is tried / absolute {
        return ""
      }
      loop each scope, from the innermost outward, until one declares it {
        self -> s.qualify(name) -> candidate
        self -> model_.find(candidate)
        self -> s.outer() -> s
      }
      opt no scope declares it, and the name is bare: the one class of that name in the package / package {
        -> inPackage(name, scope) -> found
        return found
      }
      return candidate
    }

    // The class or enum of a bare name in the package of the scope it is written in, as argos finds a class in
    // the code: one of that name and arity, or none when two share it (DS-18). Testing each entity is no message.
    sequence Resolver::inPackage {
      -> namesakes(name, scope) -> found
      opt two classes of the package have that name / ambiguous {
        return ""
      }
      return found
    }

    // Every class or enum of a name and arity in the package of the scope: the model keeps them by package and
    // name, and the arity is told on that short list (DS-336).
    sequence Resolver::namesakes {
      local package: model::Scope
      self -> package.package() -> box
      self -> model_.index() -> index
      self -> index.named(box, name) -> named
      return found
    }

    // A bare name is ambiguous when it resolves to nothing and two or more classes of its package share it (DS-325)
    sequence Resolver::ambiguous {
      -> resolve(name, scope) -> resolved
      opt the name is qualified, an artefact, or resolves / resolved {
        return candidates
      }
      -> namesakes(name, scope) -> candidates
      return candidates
    }

    // A bare name two classes of its package share relates nothing, and is said once for each place it is written
    sequence Linker::reportAmbiguous {
      self -> resolver_.ambiguous(reference.target, reference.scope) -> candidates
      opt no candidates: the name is no ambiguity / clear {
        return false
      }
      self -> context_.reported() -> said
      opt it was said for that place already / said {
        return true
      }
      self -> context_.report(finding)
      return true
    }

    // Walks the inherits relations up from derived. The stack of pending names and
    // the set of seen ones are std containers, whose operations the design does not have.
    sequence Resolver::derives {
      opt derived is base: the first name taken ends the walk / itself {
        return true
      }
      loop while names are pending and the last taken is not base {
        opt the name was not seen before {
          // what it inherits from, asked of the index: no pass over the relations
          self -> model_.index() -> index
          self -> index.from(name) -> leaving
        }
      }
      opt nothing pending is left and base never came up / unrelated {
        return false
      }
      return true
    }

  }
}

diagram SEQ_CheckerRun {
  kind: sequence
  include: driftspec@ds@check::Checker::run
}

diagram SEQ_Load {                         // a load from the command line, two levels down: parse, then the Api's steps (DS-383)
  kind: sequence
  include: driftspec@ds@app::load
  depth: 2
}

diagram CL_CheckNamespace {
  kind: class
  include: driftspec@ds@check::*
  show: ownership
}

diagram SEQ_CheckMessage {                 // the whole behaviour, every branch with its frame
  kind: sequence
  include: driftspec@ds@check::BehaviourTyping::checkMessage
}

diagram SEQ_CheckMessageUndeclared {       // one scenario: what is shared, then its branch
  kind: sequence
  include: driftspec@ds@check::BehaviourTyping::checkMessage / undeclared-op
}
