    // what each walkthrough's steps show and light, against the design (DS-469): what a diagram draws is the
    // diagram's own filter's, asked through IFilter; each finding's subject is the step (DS-426)
    class WalkthroughCheck : ACheck {
      @requirement REQ-00242-1
      + WalkthroughCheck(context: Context)                 // given what it reads once, when it is made (DS-425)
      - refs context_: Context
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      - refs resolver_: Resolver
      - owns many found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check() -> std::vector<model::Finding>
      - checkStep(step: model::Entity) -> void
      - drawn(id: std::string, shown: std::set<std::string>) -> bool    // a box taken, or a member in the box taken
      - report(code: model::Code, step: model::Entity, message: std::string) -> void
    }

    sequence WalkthroughCheck::checkStep {
      local filter: query::IFilter
      -> query::FilterFactory::of(metamodel_, diagram) -> filter      // what the shown diagram draws is its filter's
      -> filter.select(model_) -> shown
      loop each name it focuses or highlights {
        -> drawn(id, shown) -> drawnHere
      }
    }

