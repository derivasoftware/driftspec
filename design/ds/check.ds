// LLD of the check namespace (ds::check): the bound model resolved and checked.
// Every reference resolves outward through its scopes and then the extern
// catalogue; what nobody declares becomes an expected node reported once;
// behaviours are unified under their subject and checked against the static
// context (SREQ-00002-1, SREQ-00004-1).

package driftspec@ds {

  module check {

    // Datalog with stratified negation over the finite model: every structural rule is decided (DS-94).
    // The facts are the declared entities by kind, every relation both ways and containment; a
    // definition is computed bottom-up to its fixpoint, stratum by stratum, and a rule is broken by
    // each binding of its ranges where holds has no answer or never has one.
    class Evaluator {                        // decides the structural rules over the model
      @requirement REQ-00096-1
      @requirement REQ-00097-1
      @requirement REQ-00098-1
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns byKind_: std::map<std::string, std::vector<std::string>>
      - owns forward_: std::map<std::string, std::multimap<std::string, std::string>>
      - owns backward_: std::map<std::string, std::multimap<std::string, std::string>>
      - owns constants_: std::map<std::string, std::string>
      - owns extension_: std::map<std::string, std::set<std::vector<std::string>>>
      - stratum_: std::map<std::string, int>
      - owns invalid_: std::set<std::string>
      - owns found_: std::vector<model::Finding>
      + Evaluator(model: model::Model, resolver: Resolver)
      + run() -> std::vector<model::Finding>
      - index() -> void
      - validate(id: std::string, formula: model::Formula) -> bool
      - validateBody(id: std::string, body: std::vector<model::Literal>, out_bound: std::set<std::string>) -> bool
      - stratify() -> bool
      - computeDefinitions() -> void
      - evaluateRule(id: std::string, formula: model::Formula) -> void
      - solve(owner: std::string, body: std::vector<model::Literal>, bindings: std::map<std::string, std::string>, first: bool) -> std::vector<std::map<std::string, std::string>>
      - solveFrom(owner: std::string, body: std::vector<model::Literal>, done: std::vector<bool>, bindings: std::map<std::string, std::string>, first: bool, out_answers: std::vector<std::map<std::string, std::string>>) -> void
      - ready(literal: model::Literal, bindings: std::map<std::string, std::string>) -> bool
      - answers(owner: std::string, literal: model::Literal, bindings: std::map<std::string, std::string>) -> std::vector<std::map<std::string, std::string>>
      - value(owner: std::string, term: model::Term, bindings: std::map<std::string, std::string>, out_value: std::string) -> bool
      - unify(owner: std::string, term: model::Term, entity: std::string, out_bindings: std::map<std::string, std::string>) -> bool
      - definitionOf(owner: std::string, name: std::string) -> std::string
      - scopeOf(owner: std::string) -> std::string
      - contains(outer: std::string, inner: std::string) -> bool
      - report(code: std::string, owner: std::string, message: std::string, at: model::Location) -> void
    }

    // Read-only questions about the model: what a name means where it is written, what a type inherits
    // and holds, what is private on a way down (DS-125). The checker and the evaluator ask it.
    class Resolver {
      @requirement REQ-00023-1
      - refs model_: model::Model
      + Resolver(model: model::Model)
      + resolve(name: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      + externsNamed(name: std::string) -> std::vector<std::string> {
        @requirement REQ-00024-2
      }
      + derives(derived: std::string, base: std::string) -> bool {
        @requirement REQ-00029-1
      }
      + member(type: std::string, name: std::string) -> model::Entity {
        @requirement REQ-00036-2
      }
      + resolveTypeText(text: std::string, scope: std::string) -> std::string {
        @requirement REQ-00023-1
      }
      + privateOnTheWay(from: std::string, target: std::string) -> std::string {
        @requirement REQ-00063-1
      }
    }

    // What a check of a workspace says: its findings in order and the counts of the model (DS-120);
    // built once from the model, written by its formats without it (DS-126)
    dataclass Report {
      @requirement REQ-00106-1
      + findings: std::vector<model::Finding>
      + entities: int
      + expected: int
      + relations: int
      + errors: int
    }

    function reportOf(model: model::Model) -> Report {
      @requirement REQ-00106-1
    }

    // One step of the check (DS-138): its key, the steps it needs done before it, and what it found,
    // which it gives back. The checker orders the steps by what they need and runs them, knowing none of them.
    class IStep {
      @requirement REQ-00012-1
      + ~IStep()
      + abstract name() -> std::string
      + abstract needs() -> std::vector<std::string>
      + abstract run(context: Context) -> std::vector<model::Finding>
    }

    // A step that only checks (DS-138): run hands check the context to read, whose model is const,
    // so no check can change the model; what it finds it gives back. The one abstract class here.
    class ACheck : IStep {
      @requirement REQ-00012-1
      + run(context: Context) -> std::vector<model::Finding>
      - abstract check(context: Context) -> std::vector<model::Finding>
    }

    // What every step of one check is given: the model, what the binder collected, the resolver,
    // the renames linking made, what was already reported as undeclared, and what the running step
    // found, until it takes it back.
    class Context {
      @requirement REQ-00012-1
      - refs model_: model::Model
      - refs resolver_: Resolver
      - refs binder_: bind::Binder
      - owns renamed_: std::map<std::string, std::string>
      - owns reported_: std::set<std::string>
      - owns found_: std::vector<model::Finding>
      + Context(model: model::Model, resolver: Resolver, binder: bind::Binder)
      + model() -> model::Model
      + resolver() -> Resolver
      + binder() -> bind::Binder
      + current(id: std::string) -> std::string {
        @requirement REQ-00035-1
      }
      + renamed() -> std::map<std::string, std::string>
      + reported() -> std::set<std::string>
      + report(finding: model::Finding) -> void
      + take() -> std::vector<model::Finding>
      + checkVisibility(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
      + checkLeak(from: std::string, target: std::string, location: model::Location) -> void {
        @requirement REQ-00063-1
      }
    }

    // The check module's entry point (DS-138): what the rest of ds asks of a check.
    class IChecker {
      @requirement REQ-00053-1
      + ~IChecker()
      + abstract run(binder: bind::Binder) -> void
    }

    // A runner of steps: it orders the steps it is given by what each needs, runs them over one
    // context and adds what each found to the model when it ends. The map is built outside and
    // outlives it.
    class Checker : IChecker {               // realises the language step by step: each step names its requirements
      @requirement REQ-00053-1
      @requirement REQ-00012-1
      - refs model_: model::Model
      - owns resolver_: Resolver
      - refs steps_: std::map<std::string, std::unique_ptr<IStep>>
      + Checker(model: model::Model, steps: std::map<std::string, std::unique_ptr<IStep>>)
      + run(binder: bind::Binder) -> void
      + resolver() -> Resolver
      + order() -> std::vector<std::string>
    }

    // the one place that names each step: it makes them and keys them by name
    function steps() -> std::map<std::string, std::unique_ptr<IStep>> {
      @requirement REQ-00012-1
    }

    class Linker : IStep {                // references become relations, behaviours take their subject's identity
      @requirement REQ-00043-1
      @requirement REQ-00053-1
      @constraint CST-00006-1
      @constraint CST-00003-2
      @requirement REQ-00066-1
      @requirement REQ-00029-1
      @requirement REQ-00035-1
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run(context: Context) -> std::vector<model::Finding>
      - resolveReference(reference: bind::Reference) -> void {
        @requirement REQ-00043-1
        @requirement REQ-00053-1
        @constraint CST-00006-1
      }
      - kindAllowed(reference: bind::Reference, target: std::string) -> bool {
        @requirement REQ-00066-1
      }
      - checkTemplateBound(reference: bind::Reference) -> void {
        @requirement REQ-00029-1
      }
      - unifyBehaviours() -> void {
        @requirement REQ-00035-1
      }
      - defineLoneExtensions() -> void {  // a class of annotations only that nothing else defines is the class (DS-20)
        @constraint CST-00003-2
      }
    }

    class BehaviourTyping : IStep {       // messages typed against the static context: calls, types, expansions
      @requirement REQ-00036-2
      @requirement REQ-00038-2
      @requirement REQ-00037-1
      @requirement REQ-00059-1
      @requirement REQ-00056-1
      @requirement REQ-00058-2
      @requirement REQ-00039-1
      @requirement REQ-00040-1
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns results_: std::map<std::string, std::map<std::string, std::pair<std::string, std::string>>>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run(context: Context) -> std::vector<model::Finding>
      - subjectClass(sequence: model::Entity, subject: model::Entity) -> model::Entity {
        @requirement REQ-00036-2
      }
      - couple(sequence: model::Entity, type: model::Entity, transient: bool) -> void {
        @requirement REQ-00038-2
      }
      - call(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00037-1
      }
      - expand(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00038-2
      }
      - checkReturn(message: bind::Message) -> void {
        @requirement REQ-00059-1
      }
      - checkMessage(message: bind::Message) -> void {
        @requirement REQ-00037-1
        @requirement REQ-00056-1
      }
      - callStatic(seq: model::Entity, msg: model::Entity, message: bind::Message, home: std::string) -> bool {
        @requirement REQ-00108-1
      }
      - typeOfName(sequence: model::Entity, cls: model::Entity, subject: model::Entity, name: std::string, value: std::pair<std::string, std::string>, transient: bool) -> bool {
        @requirement REQ-00036-2
      }
      - compatible(argument: std::pair<std::string, std::string>, parameter: std::pair<std::string, std::string>) -> bool {
        @requirement REQ-00058-2
      }
      - checkArguments(msg: model::Entity, op: model::Entity, message: bind::Message) -> void {
        @requirement REQ-00058-2
      }
      - rememberResult(message: bind::Message) -> void {
        @requirement REQ-00058-2
      }
      - checkLocals() -> void {
        @requirement REQ-00036-2
      }
      - checkEvent(event: bind::Event) -> void {
        @requirement REQ-00039-1
        @requirement REQ-00040-1
      }
    }

    class ContractCheck : ACheck {         // interfaces, use cases, scenarios, outcomes and diagrams
      @requirement REQ-00060-1
      @requirement REQ-00082-1
      @requirement REQ-00061-1
      @requirement REQ-00109-1
      @requirement REQ-00065-1
      @requirement REQ-00049-2
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check(context: Context) -> std::vector<model::Finding>
      - outcomeOf(sequence: std::string, path: std::string, seen: std::set<std::string>) -> std::string {
        @requirement REQ-00060-1
      }
      - checkUseCases() -> void {
        @requirement REQ-00082-1
      }
      - checkInterfaces() -> void {
        @requirement REQ-00060-1
      }
      - checkViews(state: model::Entity) -> void {
        @requirement REQ-00061-1
      }
      - checkStates(state: model::Entity) -> void {
        @requirement REQ-00109-1
      }
      - checkScenarios() -> void {
        @requirement REQ-00065-1
      }
      - checkDiagrams() -> void {
        @requirement REQ-00049-2
      }
    }

    class Derivation : IStep {            // what the model says without writing it: the stereotypes, the languages
      @requirement REQ-00031-1
      @requirement REQ-00084-1
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run(context: Context) -> std::vector<model::Finding>
      - classify() -> void {
        @requirement REQ-00031-1
      }
      - fillLanguages() -> void {
        @requirement REQ-00084-1
      }
    }

    class StructureCheck : ACheck {        // ownership, artefacts, extensions and fields
      @requirement REQ-00028-1
      @requirement REQ-00045-1
      @constraint CST-00003-2
      @requirement REQ-00067-1
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check(context: Context) -> std::vector<model::Finding>
      - checkOwnershipCycles() -> void {
        @requirement REQ-00028-1
      }
      - checkArtefacts() -> void {
        @requirement REQ-00045-1
      }
      - checkExtensions() -> void {
        @constraint CST-00003-2
      }
      - checkFields() -> void {
        @requirement REQ-00067-1
      }
    }

    class DependencyCheck : ACheck {       // what a box declares it uses against what its behaviours call
      @requirement REQ-00094-2
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      - owns found_: std::vector<model::Finding>
      + name() -> std::string
      + needs() -> std::vector<std::string>
      - check(context: Context) -> std::vector<model::Finding>
      - checkDependencies() -> void {
        @requirement REQ-00094-2
      }
    }

    class RuleCheck : IStep {             // rules and definitions, decided by the evaluator
      @requirement REQ-00095-2
      - refs context_: Context
      - refs model_: model::Model
      - refs resolver_: Resolver
      + name() -> std::string
      + needs() -> std::vector<std::string>
      + run(context: Context) -> std::vector<model::Finding>
      - checkRules() -> void {
        @requirement REQ-00095-2
      }
    }

    // What ds check does: the steps, each after the steps that write what it reads. The linker
    // first; behaviour typing and derivation each need only the linker; the checks of contracts and
    // dependencies need the calls typing made; structure and rules read the finished model.
    sequence Checker::run {
      local context: Context
      local step: IStep
      self -> order() -> keys
      loop each key, in order {
        -> step.run(context) -> found
        loop each finding found {
          self -> model_.report(finding)
        }
      }
    }

    sequence Linker::run {
      -> defineLoneExtensions()
      self -> context_.binder() -> binder
      self -> binder.references() -> references
      loop each reference {
        -> resolveReference(reference)
      }
      -> unifyBehaviours()
      loop each reference {
        -> checkTemplateBound(reference)
      }
    }

    // One reference becomes one relation, or a finding. An artefact is linked by its revision: the
    // declared one is asked of the model's index, with no pass over the entities (DS-171).
    sequence Linker::resolveReference {
      opt it names an artefact by its id {
        -> model::hasRevision(reference.target) -> pinned
        opt it carries no revision / unpinned {
          self -> context_.report(finding)
          return
        }
        self -> model_.index() -> index
        self -> index.revisionOf(reference.target) -> declared
        opt the workspace declares another revision of it / drift {
          self -> context_.report(finding)
          self -> model_.relate(relation)
          return
        }
      }
      self -> resolver_.resolve(reference.target, reference.scope) -> target
      opt nothing declares it and several extern modules name it / ambiguous {
        self -> resolver_.externsNamed(reference.target) -> externs
        self -> context_.report(finding)
        return
      }
      opt nothing declares it / undeclared {
        // an expected node takes its place, and it is said once
        self -> model_.declare(expected) -> node
        opt it is no use case and nobody said it yet {
          self -> context_.report(finding)
        }
      }
      opt a package reopened by its path / part-of {
        self -> model_.relate(relation)
        return
      }
      -> kindAllowed(reference, target) -> allowed
      opt the language does not join those two kinds that way / refused {
        return
      }
      self -> model_.relate(relation)
      opt a relation that reaches into another box {
        self -> context_.checkVisibility(reference.from, target, reference.location)
        self -> context_.checkLeak(reference.from, target, reference.location)
      }
    }

    // A member is found where it is declared: the type first, then its bases, nearest first (DS-105).
    sequence Resolver::member {
      loop each level of types, the type first {
        loop each type of the level not seen before {
          self -> model_.find(id) -> found
          opt the type declares it / found {
            return found
          }
          // its bases are the next level, asked of the index
          self -> model_.index() -> index
          self -> index.from(type) -> leaving
        }
      }
      return found
    }

    sequence Evaluator::contains {
      self -> model_.index() -> index
      loop each holder of inner, outward {
        self -> index.parent(inner) -> up
        opt it is outer / held {
          return true
        }
      }
      return false
    }

    // The results of the messages are remembered as they go: each exists only for the messages after it.
    sequence BehaviourTyping::run {
      self -> context_.binder() -> binder
      self -> binder.messages() -> messages
      loop each message {
        -> checkMessage(message)
        -> rememberResult(message)
      }
      -> checkLocals()
      self -> binder.events() -> events
      loop each event {
        -> checkEvent(event)
      }
    }

    sequence ContractCheck::check {
      -> checkInterfaces()
      -> checkUseCases()
      -> checkDiagrams()
      -> checkScenarios()
    }

    sequence StructureCheck::check {
      -> checkOwnershipCycles()
      -> checkArtefacts()
      -> checkExtensions()
      -> checkFields()
    }

    // The heart of ds, as one behaviour: a chain of "if this, it ends here". Each named
    // branch is a scenario, a path through it; what they all share is written once.
    sequence BehaviourTyping::checkMessage {
      local subject: model::Entity
      local value: std::pair<std::string, std::string>
      local transient: bool
      local home: std::string
      local typeId: std::string
      local opId: std::string
      local finding: model::Finding

      opt it is a return of the behaviour, not a call / a-return {
        -> checkReturn(message)
        return
      }

      self -> context_.current(message.sequence) -> sequenceId
      self -> model_.find(sequenceId) -> seq
      self -> context_.current(message.message) -> messageId
      self -> model_.find(messageId) -> msg
      opt the behaviour or the message is gone from the model / unknown-message {
        return
      }

      -> subjectClass(seq, subject) -> cls
      opt nothing declares the subject yet, it waits / subject-waits {
        return
      }

      // A call with no target, from a function always, from a method when its class does
      // not declare the name: a function of the module, resolved outward like any name.
      opt a call to self the class does not declare {
        self -> resolver_.resolve(message.op, home) -> id
        self -> model_.find(id) -> target
        opt it is a function of the module / function {
          -> couple(seq, target, true)
          -> call(msg, target, message)
          return
        }
        opt the caller is itself a function / no-function {
          self -> context_.report(finding)
          return
        }
      }

      // Who it is called on: self, or a name of the context of the behaviour.
      alt the target is self / on-self {
      } else {
        -> typeOfName(seq, cls, subject, message.to, value, transient) -> known
        opt the context has nothing by that name / unknown-participant {
          self -> context_.report(finding)
          return
        }
        self -> resolver_.resolveTypeText(value.first, value.second) -> typeId
      }

      opt a primitive or an unknown spelling, nothing to check / no-type {
        return
      }
      self -> model_.find(typeId) -> type
      opt the type is not declared yet, reported once it is / type-waits {
        return
      }

      opt the target is not self {
        -> couple(seq, type, transient)
      }
      self -> model_.find(opId) -> op
      opt the type does not declare the operation / undeclared-op {
        self -> context_.report(finding)
        return
      }
      -> call(msg, op, message)
    }

    // How a name resolves: one scenario per place it can be found. The default is the
    // common one, found in a scope, walking outward from where it was written.
    sequence Resolver::resolve {
      local bare: std::string
      local s: std::string
      self -> model_.find(name)
      opt the model declares it as written: a full id, a global artefact, a package / declared {
        return name
      }
      -> model::withoutRevision(name) -> bare
      opt the name carries a revision {
        self -> model_.find(bare)
      }
      opt the model declares the id without its revision / revision {
        return bare
      }
      opt the name has a package path and nobody declares it: no scope is tried / absolute {
        return ""
      }
      loop each scope, from the innermost outward, until one declares it {
        -> model::qualify(s, name) -> candidate
        self -> model_.find(candidate)
        -> model::outer(s) -> s
      }
      opt no scope declares it: the extern catalogue {
        -> externsNamed(name) -> externs
        alt exactly one extern has that name / extern {
          // the code returns externs.front(), an expression no return can say
          return
        } else / unresolved {
          return ""
        }
      }
      return candidate
    }

    // Every extern class or enum of that simple name, in any arity. Filling the lists
    // and testing each entity are not messages: a loop variable is not a participant.
    sequence Resolver::externsNamed {
      local out: std::vector<std::string>
      local exact: std::vector<std::string>
      opt the name has a path, so it is no extern's simple name / qualified {
        return out
      }
      self -> model_.entities() -> entities
      opt exactly one of those found has the arity of the use / exact {
        return exact
      }
      return out
    }

    // Walks the inherits relations up from derived. The stack of pending names and
    // the set of seen ones are std containers, whose operations the design does not have.
    sequence Resolver::derives {
      opt derived is base: the first name taken ends the walk / itself {
        return true
      }
      loop while names are pending and the last taken is not base {
        opt the name was not seen before {
          // what it inherits from, asked of the index: no pass over the relations
          self -> model_.index() -> index
          self -> index.from(name) -> leaving
        }
      }
      opt nothing pending is left and base never came up / unrelated {
        return false
      }
      return true
    }

  }
}

diagram SEQ_CheckerRun {
  kind: sequence
  include: driftspec@ds@check::Checker::run
}

diagram CL_CheckNamespace {
  kind: class
  include: driftspec@ds@check::*
  show: ownership
}

diagram SEQ_CheckMessage {                 // the whole behaviour, every branch with its frame
  kind: sequence
  include: driftspec@ds@check::Checker::checkMessage
}

diagram SEQ_CheckMessageUndeclared {       // one scenario: what is shared, then its branch
  kind: sequence
  include: driftspec@ds@check::Checker::checkMessage / undeclared-op
}
