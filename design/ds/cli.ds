// The interface of ds for a person or a script: its command line. What they see: each
// command, what it prints and how it exits. Each operation has its trace, and each
// exit code names the scenario that ends in it, so `ds check` keeps saying what it does.

package driftspec@ds {
  interface cli {
    kind: cli
    transport: process
    encoding: utf-8 text
    @constraint CST-00001-1

    operation check(workspace: path) -> none : UC-00001-1 {
      @requirement SREQ-00002-1
      command: ds check <workspace> [--json]
      stdout: one line per finding, then the counts of the model; with --json, both as JSON
      stderr: why nothing was read: a path that is no workspace (exit 2)
      exit 0: default
      exit 1: errors
      exit 2: bad-usage
    }

    operation export(workspace: path) -> none : UC-00005-1 {
      @requirement SREQ-00006-1
      command: ds export <workspace>
      stdout: the model as JSON, with its relations, findings and metamodel
      exit 0: default
      exit 2: no-workspace
    }

    operation render(input: path, diagram: string) -> none : UC-00002-1 {
      @requirement SREQ-00005-1
      @requirement SREQ-00010-1
      @requirement SREQ-00013-1
      command: ds render <workspace|ir.json> [diagram] [-f html|json|svg|text|cells|ir|layout] [-w N] [-o file] [--embed [--height N]] [--css file]
      stdout: html, the viewer of the whole model, framed on the diagram when one is named; json, its scene; svg, text or cells, the diagram drawn; ir or layout, its data
      exit 0: default
      exit 1: no-diagram
      exit 2: no-workspace
    }

    operation query(workspace: path, question: string, subject: string) -> none : UC-00004-1 {
      @requirement SREQ-00011-1
      @requirement SREQ-00004-1
      command: ds query <workspace> <question> [subject] [--json]
      stdout: one answer per line, or JSON; coupling answers what every behaviour touches outside its module
      exit 0: default
      exit 1: unknown-question
      exit 2: no-workspace
    }

    operation manual(topic: string) -> none : UC-00006-1 {
      @requirement SREQ-00014-1
      command: ds manual [topic] [--json]
      stdout: the index, or the page of a kind, a finding code, the commands, the annotations or the codes
      exit 0: default
      exit 1: no-topic
    }
  }

  // each operation is its verb's command, run by the command line that main starts (app::main, CommandLine::run): the
  // command's outcome is the exit code the operation names, and what the command fails with is said, exit 2 (DS-409)
  sequence cli::check {
    local check: app::CheckCommand
    attempt {
      -> check.run() -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::check / errors {
    local check: app::CheckCommand
    attempt {
      -> check.run() / errors -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::check / bad-usage {
    local check: app::CheckCommand
    attempt {
      -> check.run() / bad-usage -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::export {
    local exporting: app::ExportCommand
    attempt {
      -> exporting.run() -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::export / no-workspace {
    local exporting: app::ExportCommand
    attempt {
      -> exporting.run() / no-workspace -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::render {
    local render: app::RenderCommand
    attempt {
      -> render.run() -> outcome
    } on std::runtime_error {
      return 2
    } on std::invalid_argument {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::render / no-diagram {
    local render: app::RenderCommand
    attempt {
      -> render.run() / no-diagram -> outcome
    } on std::runtime_error {
      return 2
    } on std::invalid_argument {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::render / no-workspace {
    local render: app::RenderCommand
    attempt {
      -> render.run() / no-workspace -> outcome
    } on std::runtime_error {
      return 2
    } on std::invalid_argument {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::query {
    local query: app::QueryCommand
    attempt {
      -> query.run() -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::query / unknown-question {
    local query: app::QueryCommand
    attempt {
      -> query.run() / unknown-question -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::query / no-workspace {
    local query: app::QueryCommand
    attempt {
      -> query.run() / no-workspace -> outcome
    } on std::runtime_error {
      return 2
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::manual {
    local manual: app::ManualCommand
    attempt {
      -> manual.run() -> outcome
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }

  sequence cli::manual / no-topic {
    local manual: app::ManualCommand
    attempt {
      -> manual.run() / no-topic -> outcome
    } on BadRequest {
      return 2
    } on NotImplemented {
      return 2
    } on emit::NotImplemented {
      return 2
    }
  }
}

diagram IF_Cli {
  kind: interface
  include: driftspec@ds@cli
}

diagram SEQ_Check {
  kind: sequence
  include: driftspec@ds@cli::check
  depth: *
}

diagram SEQ_CheckSyntaxError {
  kind: sequence
  include: driftspec@ds@cli::check / errors
  depth: 2
}

diagram SEQ_Render {
  kind: sequence
  include: driftspec@ds@cli::render
  depth: 2
}

diagram SEQ_Query {
  kind: sequence
  include: driftspec@ds@cli::query
  depth: 2
}

diagram HLD_Ds {                     // every box closed: who depends on whom, derived
  kind: class
  include: driftspec@ds@*
  open: driftspec@ds
}
