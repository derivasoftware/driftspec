// LLD of the render namespace (ds::render): the model drawn. A diagram selects
// and decides what to print (IrExport → the render-IR of the plantuml family,
// SREQ-00006-1, SREQ-00010-1); the IR is laid out once and drawn twice, as SVG
// and as terminal text, wrapping to a width (SREQ-00005-1). Layout projects the IR
// into a graph for the layout module's layered engine and reads the places back (DS-392).

package driftspec@ds {


  module render {
    @requirement REQ-00006-1                 // a diagram turned into the render-IR of its kind
    @requirement REQ-00007-1                 // the IR drawn as SVG and as terminal text
    @requirement REQ-00214-1                 // every operation of render is a member of a class (DS-372)
    @requirement REQ-00215-1                 // a projector is reached through IProjector, the tour's parts too (DS-372)
    @requirement REQ-00216-1                 // the drawings read the IR alone (DS-372)

    requirement REQ-00006-1 {
      status: approved
      @refines SREQ-00010-1
      title: The export shall turn a diagram into the render-IR of its kind: class, requirement or sequence
      text:
        A diagram's include and exclude select entities by id, module or
        package; hide and show decide what is printed. A class diagram prints
        boxes with their sections inside the containers of their modules and
        nested packages, and the edges lifted from members to classes; a
        requirement diagram prints the artefacts and what refines, verifies
        and realises them; a sequence diagram prints lifelines, messages and
        frames at the depth and level asked for. The IR carries ids, links by
        identity and locations.
      rationale:
        If the drawing is a projection of the model, it cannot drift from it;
        the IR keeps the family's renderers interchangeable.
      tags: render, diagrams
    }

    requirement REQ-00007-1 {
      status: approved
      @refines SREQ-00005-1
      title: The renderers shall draw one layout of the IR as SVG and as terminal text, within a given width
      text:
        One layered layout places every node inside its container with no two
        leaves overlapping, bases above subtypes, wholes above parts, and
        routes every edge orthogonally around the nodes it crosses, bundling
        parallel relations; given a width it wraps the layers. The SVG carries
        stable ids, links, tooltips and the script to fold and focus; the text
        draws the same layout with box characters and optional colour, and
        can hand out the cell grid for a host that draws itself. Both are
        deterministic.
      rationale:
        The same drawing in a browser, an editor and a terminal is what makes
        the model usable where it is written.
      tags: render, svg, terminal
    }

    verification VER-00006-2 {
      status: approved
      @requirement REQ-00006-1
      title: Unit tests cover the class, requirement and sequence projections of the corpora
      method: test
      tests:
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.ListsTheDeclaredDiagrams
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.IncludeSelectsAndTheModuleBecomesAContainer
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.DerivedStereotypesAndMembersArePrinted
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.EdgesAreLiftedFromMembersToClasses
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.TheDiagramReadsARelationAsTheViewerDoes
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.AnEnumIsAValueSoItIsAssociatedNotOwned
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.TheUmbrellaOfARequirement
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.ThePackageTreeWithoutDesign
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.AClassDiagramHangsItsArtefactsAsANote
    }

    verification VER-00007-3 {
      status: approved
      @requirement REQ-00007-1
      title: Unit tests cover placement, routing, wrapping, the lanes a gap keeps and the determinism of both drawings
      method: test
      tests:
        tests/integration/ds/render/test_layout.cpp::TestLayout.EveryNodeIsPlacedAndNoTwoLeavesOverlap
        tests/integration/ds/render/test_layout.cpp::TestLayout.ChildrenSitInsideTheirContainer
        tests/integration/ds/render/test_layout.cpp::TestLayout.BasesAreDrawnAboveSubtypesAndWholesAboveParts
        tests/integration/ds/render/test_layout.cpp::TestLayout.EveryEdgeBetweenPlacedNodesGetsAnOrthogonalRoute
        tests/integration/ds/render/test_layout.cpp::TestLayout.LongEdgesStepAroundTheNodesTheyCross
        tests/integration/ds/render/test_layout.cpp::TestLayoutLanes.AStraightLongEdgeReservesNoLaneRow
        tests/integration/ds/render/test_layout.cpp::TestLayout.ParallelRelationsAreBundledWithTheirLabelsStacked
        tests/integration/ds/render/test_layout.cpp::TestLayout.TheSvgIsDeterministicAndCarriesStableIds
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.DrawsLifelinesRowsFramesAndTheCaller
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.CarriesLinksSpansLocationsAndTheScript
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.IsDeterministic
        tests/integration/ds/render/test_text.cpp::TestText.DrawsEveryBoxWithItsNameAndMembers
        tests/integration/ds/render/test_text.cpp::TestText.IsDeterministicAndPlainWithoutColor
        tests/integration/ds/render/test_text.cpp::TestText.MarksAChangeOnARelationOrAMessageAsOnABox
        tests/integration/ds/render/test_layout.cpp::TestLayout.EveryChangeOfARelationHasItsStyleInTheSvg
        tests/integration/ds/render/test_text.cpp::TestText.BoxesDoNotCollideOnTheGrid
        tests/integration/ds/render/test_text.cpp::TestText.FramesOpeningAtTheSameMessageStackTheirHeaders
    }

    // ---- the IR: what a diagram prints, in the plantuml family's vocabulary ----

    dataclass IrNode {
      @requirement REQ-00006-1
      + id: std::string
      + kind: std::string
      + label: std::string
      + classifier: std::string
      + stereotype: std::string
      + parent: std::string
      + title: std::string
      + href: std::string
      + part: std::string                   // the part of the drawing it belongs to, in a drawing made of several
      + abstract: std::optional<bool>        // said of a class or an interface, either way; of anything else not said (DS-418)
      + refs: std::map<std::string, std::string>
      + sections: std::vector<std::vector<std::string>>
      + sectionKinds: std::vector<std::string>
      + span: std::pair<int, int>
      + dividers: std::vector<std::pair<int, std::string>>
      // whether a section of a box holds members, written as signatures; any other holds what a closed box
      // offers, all of one kind (DS-244)
      + static holdsMembers(sectionKind: std::string) -> bool {
        @requirement REQ-00064-5
      }
      + static badgeOf(classifier: std::string, abstract: bool) -> std::string {   // the same letter in every drawing (DS-118)
        @requirement REQ-00006-1
      }
    }

    dataclass IrEdge {
      @requirement REQ-00006-1
      + from: std::string
      + to: std::string
      + kind: std::string
      + label: std::string
      + title: std::string
      + href: std::string
      + part: std::string                   // the part of the drawing it belongs to, in a drawing made of several
      + dashed: bool
      + order: int
      + refs: std::map<std::string, std::string>
      + static between(from: std::string, to: std::string, kind: std::string) -> IrEdge   // an edge saying nothing else yet (DS-418)
    }

    // a drawing that is a table (DS-251): a corner, the headings of its columns, and its rows; a cell
    // says what it is, and the renderers draw each kind its own way
    dataclass IrCell {
      @requirement REQ-00006-1
      + text: std::string
      + kind: std::string
      + title: std::string
    }

    dataclass IrRow {
      @requirement REQ-00006-1
      + label: std::string
      + title: std::string
      + owns many cells: std::vector<IrCell>
    }

    dataclass IrTable {
      @requirement REQ-00006-1
      + corner: std::string
      + columns: std::vector<std::string>
      + owns many rows: std::vector<IrRow>
    }

    dataclass IrDocument {
      @requirement REQ-00006-1
      @requirement REQ-00251-1
      + kind: std::string                    // the diagram's kind, how it is drawn (DS-443)
      + title: std::string
      + notice: std::string
      + table: std::optional<IrTable>        // when written and with columns, the document is drawn as this table (DS-418)
      + owns many nodes: std::vector<IrNode>
      + owns many edges: std::vector<IrEdge>
      // a drawing made of several, each drawn as itself and placed beside the last: a tour (DS-245)
      + parts: std::vector<std::string>
      + static parse(json: std::string) -> IrDocument
      + part(name: std::string) -> IrDocument
      + bundled() -> IrDocument
    }

    // All of it is JSON reads and field writes, so only what it creates can be told.
    sequence IrDocument::parse {
      local doc: IrDocument
      loop each node of the JSON {
        local node: IrNode
      }
      loop each edge of the JSON {
        local edge: IrEdge
      }
      return doc
    }

    sequence IrDocument::bundled {
      local out: IrDocument                  // title, notice and nodes copied
      loop each edge {
        alt same ends, kind, dash and link as an earlier edge {
          // its label and title are joined to the first one's, a line each
        } else {
          // kept as it is
        }
      }
      return out
    }

    // ---- render's architecture (DS-372): what holds it together, each decision a rule that fires when it is broken ----

    requirement REQ-00214-1 {
      tags: architecture, render
      status: draft
      @refines REQ-00007-1
      title: Every operation of render shall be a member of the class whose responsibility it is
      text:
        The export chooses and writes, each projector draws its kind, the layout places, Svg and Text draw and the
        grid holds the cells: every operation is one of theirs. A function of the module would be a responsibility
        no class names.
      rationale:
        Owner, 2026-11-24 (DS-368, DS-371): every operation is a member of the class whose responsibility it is.
      verification VER-00234-1 {
        status: draft
        title: Integration tests confirm the design of ds keeps it, and is told when a function of render is written
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.AFunctionOfRenderIsTold
      }
    }

    requirement REQ-00215-1 {
      tags: architecture, render
      status: draft
      @refines REQ-00006-1
      title: A projector shall be reached only through IProjector, from ProjectorFactory, by every class of render, the projectors themselves included
      text:
        The export asks ProjectorFactory for the projector of a diagram's kind, and the tour asks it for the
        projectors of its two parts. No class of render holds a concrete projector, so a kind of diagram is added or
        changed without the export or another projector knowing.
      rationale:
        Owner, 2026-11-24 (DS-368, DS-369): one projector per diagram kind behind one interface, each independent of
        the others.
      verification VER-00235-1 {
        status: draft
        title: Integration tests confirm the design of ds keeps it, and is told when the tour or the export holds a projector
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.AProjectorHeldByAnotherClassOfRenderIsTold
      }
    }

    requirement REQ-00216-1 {
      tags: architecture, render
      status: draft
      @refines REQ-00007-1
      title: The drawings shall read the render-IR alone, knowing nothing of the model, the query or the axis
      text:
        What projects a diagram (the export, the projectors and what they are built of) reads the model through the
        query and lifts it onto the cut; everything else in render (the layout, Svg, Text, the grid and the IR itself)
        draws a document, whoever wrote it. A drawing that knew the model would draw what the IR does not say, and
        another tool's IR would draw differently.
      rationale:
        Owner, 2026-11-24 (DS-368): the drawings read only the IR.
      verification VER-00236-1 {
        status: draft
        title: Integration tests confirm the design of ds keeps it, and is told when a drawing knows the model, the query or the axis
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.ADrawingThatKnowsTheModelIsTold
      }
    }

    // what projects a diagram: the export, the projectors and what they are built of (DS-372)
    definition projects(c) {
      title: c is the export, a projector, the one that names them, or what a projector is built of
      if c = driftspec@ds@render::IrExport
      if c = driftspec@ds@render::IProjector
      if c = driftspec@ds@render::ProjectorFactory
      if c inherits driftspec@ds@render::IProjector
      if c = driftspec@ds@render::SequenceBuilder
    }

    rule render-operations-belong-to-classes {
      title: no function is written in render's module, so every operation of render is a member of a class
      @requirement REQ-00214-1
      for function f in driftspec@ds@render
      never f in driftspec@ds@render
    }

    rule projectors-reach-each-other-through-iprojector {
      title: no class of render but the factory depends on a projector, so a projector, the tour's parts included, is reached through IProjector
      @requirement REQ-00215-1
      for class c in driftspec@ds@render, class x in driftspec@ds@render
      where x inherits driftspec@ds@render::IProjector, c != x, c != driftspec@ds@render::ProjectorFactory
      never depends(c, x)
    }

    rule the-drawings-read-only-the-ir {
      title: no class of render that draws depends on the model, so the drawings read the IR alone
      @requirement REQ-00216-1
      for class c in driftspec@ds@render
      where not projects(c)
      never depends(c, x), x in driftspec@ds@model
    }

    rule the-drawings-ask-no-query {
      title: no class of render that draws depends on the query, so what a drawing shows is what its IR says
      @requirement REQ-00216-1
      for class c in driftspec@ds@render
      where not projects(c)
      never depends(c, x), x in driftspec@ds@query
    }

    rule the-drawings-know-no-cut {
      title: no class of render that draws depends on the axis, so a cut is the projection's and the drawing sees what it lifted
      @requirement REQ-00216-1
      for class c in driftspec@ds@render
      where not projects(c)
      never depends(c, x), x in driftspec@ds@axis
    }

    // the projection (DS-369): the projector of a diagram's kind draws its body, from what the query's filter of the
    // diagram takes; this one chooses the projector and heads the document, a value format::IrDescription writes (DS-418)
    class IrExport {
      @requirement REQ-00198-1
      @requirement REQ-00251-1               // every document says its diagram's kind (DS-443)
      @requirement REQ-00006-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel     // the language of the model: the kinds it draws by name (DS-351)
      + IrExport(model: model::Model, metamodel: model::Metamodel)
      + diagrams() -> std::vector<std::string>
      + document(diagramId: std::string) -> std::optional<IrDocument> {
        @requirement REQ-00057-1
      }
      - static documentHead(diagram: model::Entity, out_document: IrDocument) -> void   // the diagram's kind and title, filled in one place (DS-443)
    }

    sequence IrExport::diagrams {
      local out: std::vector<std::string>
      self -> model_.entities() -> entities
      return out
    }

    // The kind written in the diagram picks the projector; whatever it draws is headed here, and handed on as a value
    // for its door to describe into the sink it chose (DS-418).
    sequence IrExport::document {
      local projector: IProjector
      self -> model_.find(diagramId) -> diagram
      opt there is no such diagram / no-diagram {
        return none
      }
      -> ProjectorFactory::of(kind, model_, metamodel_) -> made
      -> projector.project(diagram) -> ir
      -> documentHead(diagram, ir) -> headed
      return ir
    }

    // what draws one kind of diagram (DS-369): a diagram of the model in, the body of its render-IR out
    class IProjector {
      @requirement REQ-00006-1
      + ~IProjector()
      + abstract project(diagram: model::Entity) -> IrDocument   // the body, as a document IrDescription writes (DS-418)
    }

    // the one place that names the projectors, by the kind of diagram they draw: a class diagram for any other kind
    class ProjectorFactory {
      @requirement REQ-00006-1
      + static of(kind: std::string, model: model::Model, metamodel: model::Metamodel) -> std::unique_ptr<IProjector>
    }

    sequence ProjectorFactory::of {
      local sequence: SequenceProjector
      local tour: TourProjector
      local requirements: RequirementProjector
      local state: StateProjector
      local table: TableProjector
      local boxes: ClassProjector
      opt it is a sequence diagram / sequence-diagram {
        return sequence
      }
      opt it is a tour / tour {
        return tour
      }
      opt it is a requirement diagram / requirement-diagram {
        return requirements
      }
      opt it is a state diagram / state-diagram {
        return state
      }
      opt it is a table / table-diagram {
        return table
      }
      return boxes
    }

    // a class diagram: the boxes a diagram takes, and the cut it is lifted onto
    class ClassProjector : IProjector {
      @requirement REQ-00121-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + ClassProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00057-1
      }
      - closeBoxes(doc: IrDocument, cut: axis::Cut) -> IrDocument {
        @requirement REQ-00064-5
        @requirement REQ-00126-1
        @requirement REQ-00137-1
        @requirement REQ-00155-1
      }
      - static isBox(e: model::Entity) -> bool                        // a class, an enum, an interface or a function of a module
      - static displayName(e: model::Entity) -> std::string            // a template with its params
      - static memberLine(m: model::Entity) -> std::string
      - static classifierOf(e: model::Entity) -> std::string           // what a box is drawn as (DS-244)
      - static edgeKind(relation: std::string) -> std::string
    }

    sequence ClassProjector::project {
      local filter: query::IFilter
      -> query::FilterFactory::of(metamodel_, diagram) -> made
      -> filter.boxes(model_) -> selected
      -> query::ClassBoxes::containers(model_, selected) -> containers   // what is drawn around, never a filter's (DS-423)
      loop each selected id {
        self -> model_.find(id) -> entity
      }
      loop each container {
        self -> model_.find(id) -> container
      }
      loop each selected box {
        self -> model_.find(id) -> entity
        // its members and what it answers to are asked of the model's index (DS-171)
        self -> model_.index() -> index
        opt it is a class or an interface {
          self -> index.members(id) -> members
        }
        opt requirements are shown {
          self -> index.from(id) -> leaving
        }
      }
      self -> model_.index() -> all
      self -> all.all() -> relations
      opt a cut is written / open-boxes {
        self -> all.ofKinds(coupling) -> behaviourCoupling
        -> closeBoxes(out, cut) -> closed
        return closed
      }
      return out
    }

    // a sequence diagram: the lifelines a behaviour stands on and its messages, followed as deep as it says
    class SequenceProjector : IProjector {
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + SequenceProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00049-3
        @requirement REQ-00056-1
        @requirement REQ-00129-1
        @requirement REQ-00130-1
        @requirement REQ-00134-1
      }
    }

    sequence SequenceProjector::project {
      local builder: SequenceBuilder
      -> query::SequenceFilter::levelsOf(diagram) -> depth
      -> builder.emit(seq, self, caller, path, depth, stack) -> emitted
      return out
    }

    // what a sequence diagram is built of, behaviour by behaviour: its lifelines and messages, as the sequence projector
    // follows the calls
    class SequenceBuilder {
      @requirement REQ-00049-3
      + owns many nodes: std::vector<IrNode>   // the lifelines, in the order they are met
      + owns many edges: std::vector<IrEdge>   // the messages, each with its order
      + order: int                             // the order the next message takes
      - refs model_: model::Model
      - refs cut_: axis::Cut                   // the cut the lifelines stand on, and the calls it follows (DS-231)
      - lifelineOf_: std::map<std::string, std::string>
      - boxLines_: std::set<std::string>       // the lifelines that are closed boxes
      + SequenceBuilder(model: model::Model, cut: axis::Cut)
      + closedAround(typeId: std::string) -> std::string
      + boxLine(box: std::string) -> std::string
      + lineOf(typeId: std::string, name: std::string, behaviour: std::string) -> std::string
      + followed(behaviour: std::string, depth: int) -> bool
      + lifeline(key: std::string, label: std::string, classifier: std::string, typeId: std::string) -> std::string
      + shortName(id: std::string) -> std::string
      + emit(seq: model::Entity, selfLine: std::string, backLine: std::string, path: std::string, depth: int, stack: std::set<std::string>) -> void
    }

    // a tour (DS-245): the boxes that take part in a behaviour and its sequence, two parts of one drawing on one cut,
    // each drawn by its own projector
    class TourProjector : IProjector {
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + TourProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00139-1
      }
    }

    // the sequence of the same fields, and who takes part in it drawn as boxes on the same cut, each from the
    // projector of its kind
    sequence TourProjector::project {
      local sequences: IProjector
      local classes: IProjector
      -> ProjectorFactory::of(kind, model_, metamodel_) -> sequenceProjector
      -> sequences.project(tour) -> sequence
      -> query::SequenceFilter::levelsOf(tour) -> depth
      -> ProjectorFactory::of(kind, model_, metamodel_) -> classProjector
      -> classes.project(boxes) -> drawn
      return out
    }

    // a state diagram: each state with the rule that computes it, and the jumps between them
    class StateProjector : IProjector {
      @requirement REQ-00234-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + StateProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00062-1
        @requirement REQ-00144-1
        @requirement REQ-00146-1
      }
    }

    // a machine as a table: what machine::Table says, written as the table of the IR
    class TableProjector : IProjector {
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + TableProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00006-1
      }
    }

    // a requirement diagram: the requirements and what answers to each
    class RequirementProjector : IProjector {
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel
      + RequirementProjector(model: model::Model, metamodel: model::Metamodel)
      + project(diagram: model::Entity) -> IrDocument {
        @requirement REQ-00050-1
        @requirement REQ-00131-1
      }
      - static isArtefact(e: model::Entity) -> bool                   // a requirement, a constraint or a verification
    }

    // ---- the layout: geometry the two drawings share ----

    dataclass Point {
      @requirement REQ-00007-1
      + x: int
      + y: int
    }

    dataclass Rect {
      @requirement REQ-00007-1
      + x: int
      + y: int
      + w: int
      + h: int
    }

    dataclass Route {
      @requirement REQ-00007-1
      @requirement REQ-00251-1
      + owns many points: std::vector<Point>
      + curve: bool                          // a smooth curve through the points (DS-443)
      + label: std::optional<Point>          // where its label goes, when the router chose
    }

    dataclass Placed {
      @requirement REQ-00007-1
      + refs node: IrNode
      + owns rect: Rect
    }

    dataclass LayoutResult {
      @requirement REQ-00007-1
      + owns many placed: std::vector<Placed>
      + owns many routes: std::map<size_t, Route>
    }

    // ---- what a drawing draws: a figure composed below it (DS-400) ------------------------------------------------

    // a diagram composed: the document it draws and where each node and route lands, in the metrics of the technology
    // that draws it; a drawing draws a figure and places nothing. It owns a document composing made, and refers to one
    // it draws as it is, which outlives it; where a node lands points into that document, so a figure is moved, never
    // copied
    dataclass Figure {
      @requirement REQ-00007-1
      + owns owned: IrDocument               // the document composing made, when it made one: boxes bundle what a closed box holds
      + refs source: IrDocument              // the document composed from, when it is drawn as it is; it outlives the figure
      + owns layout: LayoutResult
      + owns sequence: std::optional<SequenceLayout>   // a sequence's lanes, rows and frames, when the figure is one
      + Figure()
      + document() -> IrDocument             // the one it was composed from, or the one composing made
    }

    // what composes one kind of diagram for one technology: a document in, its figure out, within a width
    class IComposer {
      @requirement REQ-00007-1
      + ~IComposer()
      + abstract compose(doc: IrDocument, width: int) -> Figure
    }

    // a box diagram composed for SVG: in pixels, its edges routed as its kind is drawn (DS-443)
    class BoxesSvgComposer : IComposer {
      @requirement REQ-00007-1
      - owns metrics_: Metrics
      + BoxesSvgComposer(metrics: Metrics)
      + compose(doc: IrDocument, width: int) -> Figure
    }

    // a box diagram composed for a terminal: in cells, its edges orthogonal, as a terminal draws every kind
    class BoxesTextComposer : IComposer {
      @requirement REQ-00007-1
      - owns metrics_: Metrics
      + BoxesTextComposer(metrics: Metrics)
      + compose(doc: IrDocument, width: int) -> Figure
    }

    sequence BoxesSvgComposer::compose {
      local figure: Figure
      local layout: Layout
      self -> doc.bundled() -> bundled
      self -> layout.place(bundled, width, true) -> placed           // routed as its kind is drawn (DS-443)
      return figure
    }

    sequence BoxesTextComposer::compose {
      local figure: Figure
      local layout: Layout
      self -> doc.bundled() -> bundled
      self -> layout.place(bundled, width, false) -> placed
      return figure
    }

    // the one place that names the composers, one per kind of diagram and technology
    class ComposerFactory {
      @requirement REQ-00007-1
      + static of(kind: std::string, technology: std::string, metrics: Metrics) -> std::unique_ptr<IComposer>
    }

    sequence ComposerFactory::of {
      local svg: BoxesSvgComposer
      local text: BoxesTextComposer
      local sequence: SequenceComposer
      opt boxes drawn in SVG / boxes-svg {
        return svg
      }
      opt boxes drawn in a terminal / boxes-text {
        return text
      }
      opt a sequence, in SVG or in a terminal / sequence {
        return sequence                      // one engine: the sink's metrics make the difference (DS-464)
      }
      fail std::invalid_argument
    }

    // a sequence of the render-IR as the layout's sequence graph: lifelines as lanes, messages between two of them by
    // row, frames that span rows as blocks; what each stands for kept beside it, in the same order (DS-464)
    class SequenceProjection {
      @requirement REQ-00007-1
      - owns graph_: layout::SequenceGraph
      - refs many lanes_: std::vector<const IrNode*>
      - refs many messages_: std::vector<const IrEdge*>
      - refs many blocks_: std::vector<const IrNode*>
      - laneOf_: std::map<std::string, std::size_t>
      + SequenceProjection(doc: IrDocument)
      + graph() -> layout::SequenceGraph
      + lanes() -> std::vector<const IrNode*>
      + messages() -> std::vector<const IrEdge*>
      + blocks() -> std::vector<const IrNode*>
      + laneOf() -> std::map<std::string, std::size_t>   // a lifeline's lane, by its id
      + takeLaneOf() -> std::map<std::string, std::size_t>   // handed over: the projection keeps none after
    }

    // a sequence composed for a sink: projected into the layout's graph and placed by its sequence engine with the
    // sink's metrics, the same proportions in pixels or in cells, its marks given the least room they need (DS-464)
    class SequenceComposer : IComposer {
      @requirement REQ-00007-1
      - owns metrics_: Metrics
      + SequenceComposer(metrics: Metrics)
      + compose(doc: IrDocument, width: int) -> Figure
    }

    // what each place stands for read back from the projection
    sequence SequenceComposer::compose {
      local projection: SequenceProjection
      local engine: layout::ISequenceEngine
      opt there is no lifeline / no-lane {
        return figure
      }
      -> layout::SequenceSpacing::of(advance, lineHeight, smallAdvance, least) -> spacing
      -> layout::EngineFactory::sequence(spacing) -> made
      -> engine.place(graph) -> placed
      return figure
    }

    // where a sequence lands, composed for one technology: its lanes, its messages in order and the row each lands on,
    // its frames, its size and the proportions its marks are drawn with; everything points into the figure's document
    dataclass SequenceLayout {
      @requirement REQ-00007-1
      + owns many lanes: std::vector<Lane>
      + laneOf: std::map<std::string, size_t>
      + refs many messages: std::vector<const IrEdge*>
      + owns many rows: std::vector<SequenceRow>
      + owns many frames: std::vector<SequenceFrame>
      + width: int
      + height: int
      + margin: int                          // around the drawing, above the heads
      + headHeight: int
      + selfWidth: int                       // how far a message to its own lane loops out
    }

    // where one message of a sequence lands: the top of its row, the line its arrow runs on, the bottom of its row
    dataclass SequenceRow {
      @requirement REQ-00007-1
      + top: int
      + line: int
      + bottom: int
    }

    // where a frame of a sequence lands: the messages it spans, its four sides and its elses
    dataclass SequenceFrame {
      @requirement REQ-00007-1
      + refs node: IrNode
      + first: int
      + last: int
      + top: int
      + bottom: int
      + left: int
      + right: int
      + owns many dividers: std::vector<SequenceDivider>
    }

    // an else of a frame: the message it comes before, where its line lands, and the condition it says
    dataclass SequenceDivider {
      @requirement REQ-00007-1
      + row: int
      + y: int
      + label: std::string
    }

    dataclass Metrics {                      // the runtime table of sizes: one for SVG pixels, one for terminal cells
      @requirement REQ-00007-1
      @requirement REQ-00231-1              // its text measures are the theme's (DS-393)
      + CHAR_W: int
      + LINE_H: int
      + SMALL_W: int                         // a character of small text: the theme's measures (DS-464)
      + SEQ_PAD_LEAST: int                   // the least room around a sequence head's label: a terminal's box needs 4
      + SEQ_HEAD_LEAST: int                  // the least room a head is drawn in: a terminal's box, 3 rows
      + SEQ_SELF_LEAST: int                  // the least room a message to its own lane is drawn in: a terminal's loop, 3 rows
      + SEQ_FRAME_LEAST: int                 // the least room between a frame's edge and the next: a terminal's row
      + PAD_X: int
      + PAD_Y: int
      + SECTION_GAP: int
      + BADGE_W: int
      + DOT_W: int
      + NOTE_FOLD: int
      + GAP_X: int
      + GAP_Y: int
      + LANE: int
      + LANE_PAD: int
      + CONTAINER_PAD: int
      + CONTAINER_LABEL_H: int
      + ASPECT: double
      + static svg(text: theme::Measures) -> Metrics
      + static text(text: theme::Measures) -> Metrics
    }

    // The layout itself, in one table of metrics (DS-185).
    class Layout {
      @requirement REQ-00007-1
      - m_: Metrics
      + Layout(m: Metrics)
      + sizeOf(node: IrNode) -> Rect                                  // from its text alone
      + place(doc: IrDocument, maxWidth: int, asItsKind: bool) -> LayoutResult   // layered, wrapped to the width, routed as its kind asks (DS-443)
    }

    // the IR as a graph for the layout's layered engine (DS-392): each node a frame under its parent, a container
    // layered with the width of its label, any other node sized from its text, every edge told whether it points up;
    // the places come back in whole units
    sequence Layout::place {
      local node: IrNode
      local engine: layout::IEngine           // from the layout's EngineFactory
      local graph: layout::Graph
      loop each node of the document {
        -> sizeOf(node) -> size
      }
      -> engine.place(graph) -> placed
      return result
    }

    class Svg {                              // the SVG drawing, with its links, tooltips and script
      @requirement REQ-00007-1
      @requirement REQ-00251-1               // a curve drawn as a smooth path, its label where its router put it
      @requirement REQ-00234-1
      @requirement REQ-00231-1
      - owns metrics_: Metrics                 // in pixels, its text measured as the theme measures it
      - style_: std::string                    // the stylesheet every drawing carries, written from the theme
      - sequenceStyle_: std::string            // what a sequence adds to it
      + Svg(theme: theme::Theme)
      + render(doc: IrDocument, maxWidth: int) -> std::string   // a box diagram through the composer of boxes in SVG
      + draw(figure: Figure) -> std::string                          // a figure as it is composed: nothing placed here (DS-400)
      - kMarkerByKind: std::map<std::string, std::string>   // the marker an edge of each kind ends in
      - kSeqScript: char                     // the script a sequence carries, so it folds and links wherever it is shown
      - static idPrefix(title: std::string) -> std::string           // FNV-1a of the title in base 36: several drawings share a page
      - static markers(px: std::string) -> std::string               // the arrowheads and diamonds, defined once per drawing
      - static splitParams(text: std::string) -> std::vector<std::string>   // on top-level commas
      - static typed(type: std::string) -> std::string
      - static memberMarkup(line: std::string) -> std::pair<std::string, std::string>   // a member's line as coloured tspans
      - static num(v: int) -> std::string                            // and a double: whole pixels
      - emitNode(p: Placed, px: std::string) -> std::string          // a box, a container or a note where it was placed
      - static emitEdge(e: IrEdge, route: Route, px: std::string) -> EdgeMarkup
      - static dataAttrs(refs: std::map<std::string, std::string>) -> std::string
      - sequenceSvg(figure: Figure) -> std::string                   // a sequence where its figure placed it
      - tableSvg(doc: IrDocument) -> std::string                     // a table, drawn cell by cell (DS-251)
      - static besideEachOther(drawings: std::vector<std::pair<std::string, std::string>>, maxWidth: int) -> std::string   // the parts of a drawing (DS-245)
    }

    // an edge drawn in SVG: its path, and its label written apart so every label goes above every path
    - dataclass EdgeMarkup {
      @requirement REQ-00007-1
      + path: std::string
      + label: std::string
    }

    // a lifeline of a sequence drawn in SVG: its node, the x of its centre and the width of its head
    dataclass Lane {                         // a lifeline's lane: in a sequence's composed layout (DS-400)
      @requirement REQ-00007-1
      + refs node: IrNode
      + cx: int
      + headW: int
    }

    class Text {                             // the terminal drawing, box characters and optional colour
      @requirement REQ-00007-1
      @requirement REQ-00234-1
      @requirement REQ-00231-1
      - owns pen_: TextPen
      + Text(theme: theme::Theme)
      + render(doc: IrDocument, color: bool, maxWidth: int) -> std::string   // a box diagram through the composer of boxes in text
      + draw(figure: Figure, color: bool) -> std::string             // a figure as it is composed: nothing placed here (DS-400)
      + cells(doc: IrDocument, maxWidth: int, out_sink: emit::ISink) -> void   // as one value where the sink lent stands (DS-397)
      - member(g: Grid, x: int, y: int, line: std::string) -> void       // a member's line: visibility and types coloured
      - box(g: Grid, p: Placed) -> void                                 // its frame, its header and its sections
      - container(g: Grid, p: Placed) -> void                           // its frame and its label
      - static marker(kind: std::string, dx: int, dy: int) -> std::string   // the glyph of an edge entering its target moving in (dx, dy)
      - edge(g: Grid, e: IrEdge, route: Route, byId: std::map<std::string, const Placed*>) -> void
      - sequenceGrid(figure: Figure) -> Grid                            // lifelines as columns, messages as rows, where its figure placed them
      - classGrid(figure: Figure) -> Grid                              // the boxes and edges where the figure placed them
      - static isSequence(doc: IrDocument) -> bool                      // a node of it is a lifeline
      - static contentWidth(maxWidth: int) -> int                       // the grid keeps a one-cell margin on each side
      - tableGrid(doc: IrDocument) -> Grid                              // a row of headings, a rule, a row for each row (DS-251)
      - partsGrid(doc: IrDocument, maxWidth: int) -> Grid               // the parts one under the other (DS-245)
    }

    // What a change a diff marks is drawn as in a terminal (DS-419): its mark and its colour.
    dataclass ChangeMark {
      @requirement REQ-00007-1
      + mark: std::string
      + colour: std::string
    }

    // What the terminal drawing draws with (DS-393): the metrics in cells and each role's colour, read from the theme once.
    dataclass TextPen {
      @requirement REQ-00007-1
      @requirement REQ-00231-1
      + owns M: Metrics
      + muted: std::string
      + name: std::string
      + type: std::string
      + publicMember: std::string
      + privateMember: std::string
      + protectedMember: std::string
      + badge: std::string
      + note: std::string
      + container: std::string
      + edge: std::string
      + against: std::string
      + owns added: ChangeMark
      + owns removed: ChangeMark
      + owns renamed: ChangeMark
      + owns changed: ChangeMark
      + cellColours: std::map<std::string, std::uint32_t>   // what a host that paints cells gives each colour
      + badges: std::map<std::string, std::string>          // a badge's colour by its classifier, one per kind (DS-441)
      + abstractBadge: std::string
      + TextPen(t: theme::Theme)
      + changeMarkOf(change: std::string) -> ChangeMark      // one it does not name is drawn as changed
      + badgeColour(classifier: std::string, abstract: bool) -> std::string   // its kind's, an abstract class's, or the badge's
    }

    // ---- what the drawings keep to their source files ----


    // the character grid Text fills, cell by cell (DS-371): each cell a glyph, its colour and what an edge drew there
    - class Grid {
      @requirement REQ-00007-1
      - minX_: int
      - minY_: int
      - w_: int
      - h_: int
      - cells_: std::vector<Cell>
      - palette_: std::vector<std::string>   // the colours the cells name, "" first: the default
      - long_: std::vector<std::string>      // the glyphs longer than one code point
      - kMaxCells: std::size_t               // the most it holds, some 128 million characters (DS-350)
      + Grid(minX: int, minY: int, w: int, h: int)
      + at(x: int, y: int) -> Cell              // none outside the grid
      + put(x: int, y: int, glyph: std::string_view, color: std::string) -> void   // a glyph read where it is, never copied first
      + text(x: int, y: int, s: std::string, color: std::string) -> void   // one code point per cell
      + line(x: int, y: int, horizontal: bool, dashed: bool, color: std::string) -> void   // joins with what another edge drew
      + encode(rgb: std::map<std::string, std::uint32_t>) -> std::string
      + columns() -> int
      + rows() -> int
      + paste(other: Grid, row: int) -> void    // another grid copied onto this one, its first row at row
      + dump(color: bool) -> std::string
      + frame(r: Rect, rounded: bool, color: std::string) -> void
      + clear(r: Rect) -> void                  // what a box covers is not drawn through
      - static sized(w: int, h: int) -> std::size_t   // a drawing too large to hold as text is refused (DS-350)
      - paint(color: std::string) -> std::uint8_t     // the colour's index in the palette, added the first time
      - setGlyph(c: Cell, glyph: std::string_view) -> void
      - glyphOf(c: Cell) -> std::string_view
    }

    // one character of the drawing, in 7 bytes (DS-350): its UTF-8 bytes inline, the index of its colour in the grid's
    // palette and what an edge drew there; a longer glyph is kept in the grid's list and found by its index
    - dataclass Cell {
      @requirement REQ-00007-1
      + kLong: std::uint8_t                   // the size that says glyph holds the index of a long glyph
      + glyph: std::array<char, 4>
      + size: std::uint8_t
      + colour: std::uint8_t
      + line: std::uint8_t                    // 1 horizontal, 2 vertical, 3 both
    }

    // a lifeline of a sequence drawn as text: its id, its label, the column of its centre and its width
    - dataclass SeqLine {
      @requirement REQ-00007-1
      + id: std::string
      + label: std::string
      + centre: int
      + width: int
    }

    // metrics is the pixel table, made from the theme's measures with the Svg. A box diagram is composed below
    // and drawn as it is composed (DS-400); the drawing comes back as a name.
    sequence Svg::render {
      opt the document is a table / table-document {
        -> tableSvg(doc) -> drawing
        return drawing
      }
      local composer: IComposer
      opt a node of the document is a lifeline / sequence-document {
        -> ComposerFactory::of(kind, technology, metrics_) -> sequence   // a sequence, in SVG (DS-400)
        -> composer.compose(doc, maxWidth) -> composed
        -> draw(composed) -> drawn
        return drawn
      }
      -> ComposerFactory::of(kind, technology, metrics_) -> made     // boxes, in SVG (DS-400)
      -> composer.compose(doc, maxWidth) -> figure
      -> draw(figure) -> drawing
      return drawing
    }

    // metrics is the cell table, the pen's, and width is maxWidth less the grid's margin. A box diagram is composed
    // below and drawn as it is composed (DS-400).
    sequence Text::render {
      opt the document is a table / table-document {
        -> tableGrid(doc) -> grid
        self -> grid.dump(color) -> drawing
        return drawing
      }
      local composer: IComposer
      opt a node of the document is a lifeline / sequence-document {
        -> ComposerFactory::of(kind, technology, pen_.M) -> sequence     // a sequence, in text (DS-400)
        -> composer.compose(doc, width) -> composed
        -> draw(composed, color) -> drawn
        return drawn
      }
      -> ComposerFactory::of(kind, technology, pen_.M) -> made       // boxes, in text (DS-400)
      -> composer.compose(doc, width) -> figure
      -> draw(figure, color) -> drawing
      return drawing
    }

    // The grid is written into the sink lent, its fields in byte order; nothing comes back (DS-397).
    sequence Text::cells {
      local composer: IComposer
      alt a node of the document is a lifeline / sequence-document {
        -> ComposerFactory::of(kind, technology, pen_.M) -> sequence     // a sequence, in text (DS-400)
        -> composer.compose(doc, width) -> composed
        -> sequenceGrid(composed) -> grid
      } else {
        -> ComposerFactory::of(kind, technology, pen_.M) -> made     // boxes, in text (DS-400)
        -> composer.compose(doc, width) -> figure
        -> classGrid(figure) -> grid
      }
      self -> grid.encode(pen_.cellColours) -> encoded
      self -> grid.columns() -> columns
      self -> grid.rows() -> rows
      self -> grid.dump(false) -> text
      -> out_sink.beginRecord()
      -> out_sink.endRecord()
    }
  }
}

// The render box drawn inside, names only: every class of the namespace.
diagram CL_RenderNamespace {
  kind: class
  include: driftspec@ds@render::*
  hide: fields, methods
}

// Two views, one per intent: the namespace mixes the projection (REQ-00006-1)
// and the drawing (REQ-00007-1), two requirement families in one namespace;
// splitting the namespace is a backlog task.
diagram CL_RenderIr {
  kind: class
  include: driftspec@ds@render::IrNode, driftspec@ds@render::IrEdge, driftspec@ds@render::IrDocument, driftspec@ds@render::IrExport, driftspec@ds@render::IrTable, driftspec@ds@render::IrRow, driftspec@ds@render::IrCell
  show: ownership
}

diagram CL_RenderDrawing {
  kind: class
  include: driftspec@ds@render::Point, driftspec@ds@render::Rect, driftspec@ds@render::Route, driftspec@ds@render::Placed, driftspec@ds@render::LayoutResult, driftspec@ds@render::Metrics, driftspec@ds@render::Svg, driftspec@ds@render::Text, driftspec@ds@render::TextPen, driftspec@ds@render::ChangeMark
  show: ownership
  hide: fields
}
