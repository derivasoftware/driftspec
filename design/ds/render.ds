// LLD of the render namespace (ds::render): the model drawn. A diagram selects
// and decides what to print (IrExport → the render-IR of the plantuml family,
// SREQ-00006-1, SREQ-00010-1); the IR is laid out once and drawn twice, as SVG
// and as terminal text, wrapping to a width (SREQ-00005-1). Layout itself is the
// function layout, over the types below.

package driftspec@ds {

  extern module std {
    class set<T>
  }

  module render {

    requirement REQ-00006-1 {
      status: approved
      @refines SREQ-00010-1
      title: The export shall turn a diagram into the render-IR of its kind: class, requirement or sequence
      text:
        A diagram's include and exclude select entities by id, module or
        package; hide and show decide what is printed. A class diagram prints
        boxes with their sections inside the containers of their modules and
        nested packages, and the edges lifted from members to classes; a
        requirement diagram prints the artefacts and what refines, verifies
        and realises them; a sequence diagram prints lifelines, messages and
        frames at the depth and level asked for. The IR carries ids, links by
        identity and locations.
      rationale:
        If the drawing is a projection of the model, it cannot drift from it;
        the IR keeps the family's renderers interchangeable.
      tags: render, diagrams
    }

    requirement REQ-00007-1 {
      status: approved
      @refines SREQ-00005-1
      title: The renderers shall draw one layout of the IR as SVG and as terminal text, within a given width
      text:
        One layered layout places every node inside its container with no two
        leaves overlapping, bases above subtypes, wholes above parts, and
        routes every edge orthogonally around the nodes it crosses, bundling
        parallel relations; given a width it wraps the layers. The SVG carries
        stable ids, links, tooltips and the script to fold and focus; the text
        draws the same layout with box characters and optional colour, and
        can hand out the cell grid for a host that draws itself. Both are
        deterministic.
      rationale:
        The same drawing in a browser, an editor and a terminal is what makes
        the model usable where it is written.
      tags: render, svg, terminal
    }

    verification VER-00006-1 {
      status: approved
      @requirement REQ-00006-1
      title: Unit tests cover the class, requirement and sequence projections of the corpora
      method: test
      tests:
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.ListsTheDeclaredDiagrams
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.IncludeSelectsAndTheModuleBecomesAContainer
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.DerivedStereotypesAndMembersArePrinted
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.EdgesAreLiftedFromMembersToClasses
        tests/integration/ds/render/test_irexport.cpp::TestIrExport.AnEnumIsAValueSoItIsAssociatedNotOwned
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.TheUmbrellaOfARequirement
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.ThePackageTreeWithoutDesign
        tests/integration/ds/render/test_requirements_view.cpp::TestRequirementsView.AClassDiagramHangsItsArtefactsAsANote
    }

    verification VER-00007-2 {
      status: draft
      @requirement REQ-00007-1
      title: Unit tests cover placement, routing, wrapping and the determinism of both drawings
      method: test
      tests:
        tests/integration/ds/render/test_layout.cpp::TestLayout.EveryNodeIsPlacedAndNoTwoLeavesOverlap
        tests/integration/ds/render/test_layout.cpp::TestLayout.ChildrenSitInsideTheirContainer
        tests/integration/ds/render/test_layout.cpp::TestLayout.BasesAreDrawnAboveSubtypesAndWholesAboveParts
        tests/integration/ds/render/test_layout.cpp::TestLayout.EveryEdgeBetweenPlacedNodesGetsAnOrthogonalRoute
        tests/integration/ds/render/test_layout.cpp::TestLayout.LongEdgesStepAroundTheNodesTheyCross
        tests/integration/ds/render/test_layout.cpp::TestLayout.ParallelRelationsAreBundledWithTheirLabelsStacked
        tests/integration/ds/render/test_layout.cpp::TestLayout.TheSvgIsDeterministicAndCarriesStableIds
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.DrawsLifelinesRowsFramesAndTheCaller
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.CarriesLinksSpansLocationsAndTheScript
        tests/integration/ds/render/test_layout.cpp::TestSequenceSvg.IsDeterministic
        tests/integration/ds/render/test_text.cpp::TestText.DrawsEveryBoxWithItsNameAndMembers
        tests/integration/ds/render/test_text.cpp::TestText.IsDeterministicAndPlainWithoutColor
        tests/integration/ds/render/test_text.cpp::TestText.BoxesDoNotCollideOnTheGrid
        tests/integration/ds/render/test_text.cpp::TestText.FramesOpeningAtTheSameMessageStackTheirHeaders
    }

    // ---- the IR: what a diagram prints, in the plantuml family's vocabulary ----

    dataclass IrNode {
      @requirement REQ-00006-1
      + id: std::string
      + kind: std::string
      + label: std::string
      + classifier: std::string
      + stereotype: std::string
      + parent: std::string
      + title: std::string
      + href: std::string
      + abstract: bool
      + refs: std::map<std::string, std::string>
      + sections: std::vector<std::vector<std::string>>
      + sectionKinds: std::vector<std::string>
      + span: std::pair<int, int>
      + dividers: std::vector<std::pair<int, std::string>>
    }

    dataclass IrEdge {
      @requirement REQ-00006-1
      + from: std::string
      + to: std::string
      + kind: std::string
      + label: std::string
      + title: std::string
      + href: std::string
      + dashed: bool
      + order: int
      + refs: std::map<std::string, std::string>
    }

    dataclass IrDocument {
      @requirement REQ-00006-1
      + title: std::string
      + notice: std::string
      + owns nodes: std::vector<IrNode>
      + owns edges: std::vector<IrEdge>
      + static parse(json: std::string) -> IrDocument
      + bundled() -> IrDocument
    }

    // All of it is JSON reads and field writes, so only what it creates can be told.
    sequence IrDocument::parse {
      local doc: IrDocument
      loop each node of the JSON {
        local node: IrNode
      }
      loop each edge of the JSON {
        local edge: IrEdge
      }
      return doc
    }

    sequence IrDocument::bundled {
      local out: IrDocument                  // title, notice and nodes copied
      loop each edge {
        alt same ends, kind, dash and link as an earlier edge {
          // its label and title are joined to the first one's, a line each
        } else {
          // kept as it is
        }
      }
      return out
    }

    class IrExport {                         // the projection: selects, decides what to print, writes the IR
      @requirement REQ-00006-1
      - refs model_: model::Model
      + IrExport(model: model::Model)
      + diagrams() -> std::vector<std::string>
      + render(diagramId: std::string, pretty: bool) -> std::string {
        @requirement REQ-00057-1
      }
      + select(diagram: model::Entity) -> std::set<std::string> {
        @requirement REQ-00047-1
        @requirement REQ-00019-1
        @requirement REQ-00048-1
      }
      - matches(pattern: std::string, entity: model::Entity) -> bool
      - closeBoxes(ir: std::string, open: std::vector<std::string>, pretty: bool) -> std::string {
        @requirement REQ-00064-2
      }
      - renderState(diagram: model::Entity, pretty: bool) -> std::string {
        @requirement REQ-00062-1
      }
      - renderSequence(diagram: model::Entity, pretty: bool) -> std::string {
        @requirement REQ-00049-2
        @requirement REQ-00056-1
      }
      - renderRequirements(diagram: model::Entity, pretty: bool) -> std::string {
        @requirement REQ-00050-1
      }
    }

    sequence IrExport::diagrams {
      local out: std::vector<std::string>
      self -> model_.entities() -> entities
      return out
    }

    sequence IrExport::select {
      local selected: std::set<std::string>
      loop each pattern of include {
        self -> model_.entities() -> entities
        loop each entity {
          opt it is drawable and not expected {
            -> matches(pattern, entity) -> matched
          }
        }
      }
      loop each pattern of exclude {
        loop each selected id {
          self -> model_.find(id) -> entity
          -> matches(pattern, entity) -> matched
        }
      }
      return selected
    }

    // The kind written in the diagram picks the scenario. The default is a class diagram
    // with no open: field, told by its main steps. What comes back is the JSON dumped,
    // so a name for it, not a checked value.
    sequence IrExport::render {
      self -> model_.find(diagramId) -> diagram
      opt there is no such diagram / no-diagram {
        return ""
      }
      opt it is a sequence diagram / sequence-diagram {
        -> renderSequence(diagram, pretty) -> ir
        return ir
      }
      opt it is a requirement diagram / requirement-diagram {
        -> renderRequirements(diagram, pretty) -> ir
        return ir
      }
      opt it is a state diagram / state-diagram {
        -> renderState(diagram, pretty) -> ir
        return ir
      }
      -> select(diagram) -> selected
      opt neighbours is written {
        loop each step {
          self -> model_.relations() -> relations
        }
      }
      loop each selected id {
        self -> model_.find(id) -> entity
      }
      loop each container {
        self -> model_.find(id) -> container
      }
      loop each selected box {
        self -> model_.find(id) -> entity
        opt it is a class or an interface {
          self -> model_.entities() -> entities
        }
        opt requirements are shown {
          self -> model_.relations() -> relations
        }
      }
      self -> model_.relations() -> relations
      opt open: is written / open-boxes {
        self -> model_.relations() -> behaviourCoupling
        -> closeBoxes(ir, open, pretty) -> closed
        return closed
      }
      return ir
    }

    // ---- the layout: geometry the two drawings share ----

    dataclass Point {
      @requirement REQ-00007-1
      + x: int
      + y: int
    }

    dataclass Rect {
      @requirement REQ-00007-1
      + x: int
      + y: int
      + w: int
      + h: int
    }

    dataclass Route {
      @requirement REQ-00007-1
      + owns points: std::vector<Point>
    }

    dataclass Placed {
      @requirement REQ-00007-1
      + refs node: IrNode
      + owns rect: Rect
    }

    dataclass LayoutResult {
      @requirement REQ-00007-1
      + owns placed: std::vector<Placed>
      + owns routes: std::map<size_t, Route>
    }

    dataclass Metrics {                      // the runtime table of sizes: one for SVG pixels, one for terminal cells
      @requirement REQ-00007-1
      + CHAR_W: int
      + LINE_H: int
      + PAD_X: int
      + PAD_Y: int
      + SECTION_GAP: int
      + BADGE_W: int
      + DOT_W: int
      + NOTE_FOLD: int
      + GAP_X: int
      + GAP_Y: int
      + LANE: int
      + LANE_PAD: int
      + CONTAINER_PAD: int
      + CONTAINER_LABEL_H: int
      + ASPECT: double
      + static svg() -> Metrics
      + static text() -> Metrics
    }

    // The layout itself: two public functions of Layout.hpp.
    function sizeOf(node: IrNode, m: Metrics) -> Rect
    function layout(doc: IrDocument, m: Metrics, maxWidth: int) -> LayoutResult

    class Svg {                              // the SVG drawing, with its links, tooltips and script
      @requirement REQ-00007-1
      + render(doc: IrDocument, maxWidth: int) -> std::string   // also over a layout already made: one identity per member
    }

    class Text {                             // the terminal drawing, box characters and optional colour
      @requirement REQ-00007-1
      + render(doc: IrDocument, color: bool, maxWidth: int) -> std::string   // also over a layout already made
      + cells(doc: IrDocument, maxWidth: int) -> std::string
    }

    // ---- what the drawings keep to their source files ----

    - function sequenceSvg(doc: IrDocument) -> std::string     // a sequence document, drawn without the layout

    - class Grid {                           // the character grid Text fills, cell by cell
      + dump(color: bool) -> std::string
      + encode() -> std::string
      + columns() -> int
      + rows() -> int
    }

    - function sequenceGrid(doc: IrDocument) -> Grid
    - function classGrid(doc: IrDocument, lay: LayoutResult) -> Grid

    // metrics is the pixel table, Metrics::svg(), a static call. The drawing over the
    // layout is the second render, an overload: neither can be told, so the drawing of a
    // class document comes back as a name.
    sequence Svg::render {
      opt a node of the document is a lifeline / sequence-document {
        -> sequenceSvg(doc) -> drawing
        return drawing
      }
      self -> doc.bundled() -> bundled
      -> layout(bundled, metrics, maxWidth) -> lay
      return drawing
    }

    // metrics is the cell table, Metrics::text(), and width is maxWidth less the grid's
    // margin. The drawing over the layout is the second render, an overload.
    sequence Text::render {
      opt a node of the document is a lifeline / sequence-document {
        -> sequenceGrid(doc) -> grid
        self -> grid.dump(color) -> drawing
        return drawing
      }
      self -> doc.bundled() -> bundled
      -> layout(bundled, metrics, width) -> lay
      return drawing
    }

    // What comes back is the JSON of the grid, so a name for it.
    sequence Text::cells {
      self -> doc.bundled() -> bundled
      alt a node of the document is a lifeline / sequence-document {
        -> sequenceGrid(doc) -> grid         // bundled all the same, and not used
      } else {
        -> layout(bundled, metrics, width) -> lay
        -> classGrid(bundled, lay) -> grid
      }
      self -> grid.columns() -> columns
      self -> grid.rows() -> rows
      self -> grid.encode() -> encoded
      self -> grid.dump(false) -> text
      return json
    }
  }
}

// Two views, one per intent: the namespace mixes the projection (REQ-00006-1)
// and the drawing (REQ-00007-1), which argos reads as two requirement families
// in one aggregate; splitting the namespace is a backlog task.
diagram CL_RenderIr {
  kind: class
  include: driftspec@ds@render::IrNode, driftspec@ds@render::IrEdge, driftspec@ds@render::IrDocument, driftspec@ds@render::IrExport
  show: ownership
}

diagram CL_RenderDrawing {
  kind: class
  include: driftspec@ds@render::Point, driftspec@ds@render::Rect, driftspec@ds@render::Route, driftspec@ds@render::Placed, driftspec@ds@render::LayoutResult, driftspec@ds@render::Metrics, driftspec@ds@render::Svg, driftspec@ds@render::Text
  show: ownership
  hide: fields
}
