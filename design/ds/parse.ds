// LLD of the parse namespace (ds::parse): every .ds file of a workspace read
// into a tree-sitter tree (SREQ-00001-1). The tree-sitter C API is borrowed
// through the extern catalogue; its names stay as the code writes them.

package driftspec@ds {



  module parse {
    @requirement REQ-00008-1

    requirement REQ-00008-1 {
      status: approved
      @refines SREQ-00001-1
      title: The parser shall read every .ds file under a directory into a tree, in any order, marking the files that do not parse
      text:
        A directory is walked recursively; every .ds file is read whole and
        parsed with the DriftSpec grammar into a tree that lives as long as
        the parsed file. A file with a syntax error is still returned, marked,
        so the workspace loads whole and the error is reported once at the
        file. Text is parsed the same way without a file.
      rationale:
        Loading never fails on one file; the model absorbs the rest and says
        which file did not parse.
      tags: parse, workspace
    }

    verification VER-00008-2 {
      status: approved
      @requirement REQ-00008-1
      title: Integration tests cover a whole workspace parsed without errors and a syntax error marked
      method: test
      tests:
        tests/integration/ds/parse/test_workspace_parsing.cpp::TestWorkspaceParsing.AWholeWorkspaceIsReadWithoutSyntaxErrors
        tests/integration/ds/parse/test_workspace_parsing.cpp::TestWorkspaceParsing.ASyntaxErrorIsReportedWhereTheFileStopsParsing
    }

    requirement REQ-00080-1 {
      status: approved
      @refines SREQ-00002-1
      title: The parser shall say where a syntax error sits and what the grammar takes there
      text:
        The detail of a syntax error names the declaration it is in (in a
        module, in a class, in a sequence...) and the words the grammar takes
        at that place, read from the parse state: its keywords, an annotation
        when it takes one, a field when it takes key: value. A block the
        parser had to close early says what it would have taken. When the
        parser has lost its place the list is left out, rather than naming
        the whole language.
      rationale:
        Owner, 2026-11-06 (DS-79): a newcomer agent wrote a design in three
        attempts with the manual, and two of them were spent on syntax errors
        that said what was wrong but not what was allowed.
      tags: parse, syntax, manual
    }

    verification VER-00089-1 {
      status: approved
      @requirement REQ-00080-1
      title: Integration tests confirm a syntax error names the declaration it is in and what the grammar takes there
      method: test
      tests:
        tests/integration/ds/parse/test_syntax_errors.cpp::TestSyntaxErrors.AWordTheGrammarDoesNotTakeNamesWhatTheModuleTakes
        tests/integration/ds/parse/test_syntax_errors.cpp::TestSyntaxErrors.ADeclarationAnInterfaceDoesNotHoldNamesWhatItHolds
    }

    dataclass ParsedFile {                   // one file read: its path, text, tree and whether it parsed
      @requirement REQ-00008-1
      @requirement REQ-00080-1
      + path: std::string
      + text: std::string
      + owns tree: std::shared_ptr<TSTree>
      + hasSyntaxErrors: bool
      + errorLine: int                       // where it stops parsing (SREQ-00002-1: a finding at its place)
      + errorColumn: int
      + errorDetail: std::string             // where it sits and what the grammar takes there (REQ-00080-1)
      + textOf(node: TSNode) -> std::string  // the text a node of its tree spans
    }

    class Parser {                           // the tree-sitter parser with the DriftSpec language set
      @requirement REQ-00008-1
      @requirement REQ-00012-1
      @constraint CST-00007-1
      - owns parser_: TSParser
      + Parser()
      + parseText(path: std::string, text: std::string) -> ParsedFile
      + parseFile(path: std::string) -> ParsedFile
      + parseDirectory(directory: std::string) -> std::vector<ParsedFile>
      + expectedAt(text: std::string, line: int, column: int) -> std::vector<std::string> {
        @requirement REQ-00085-1                 // what the grammar takes at a place: what an editor completes with
      }
    }

    - function firstError(node: TSNode, text: std::string, file: ParsedFile) -> bool {
      @requirement REQ-00080-1
    }

    // Most of parsing is the tree-sitter C API, whose functions the design does not declare: what
    // is left of parseText is the file it fills and, when the tree has an error, where it is.
    sequence Parser::parseText {
      local file: ParsedFile
      opt the tree has an error {
        local root: TSNode
        -> firstError(root, text, file) -> placed
      }
      return file
    }

    // An error node may wrap a whole block: a narrower error inside it is found first.
    sequence firstError {
      opt the node is an error {
        loop each child with an error {
          -> firstError(child, text, file) -> found
          opt the child placed it {
            return true
          }
        }
      }
      opt the node is an error or a missing token {
        return true
      }
      opt nothing under the node has an error {
        return false
      }
      loop each child {
        -> firstError(child, text, file) -> found
        opt the child placed it {
          return true
        }
      }
      return false
    }

    // The file cannot be opened: it throws, and nothing comes back.
    sequence Parser::parseFile {
      opt the file cannot be opened / unreadable {
        return
      }
      -> parseText(path, text) -> file
      return file
    }

    // The directory does not exist: walking it throws before any file is read. One file
    // cannot be opened: the exception goes up and no file comes back.
    sequence Parser::parseDirectory {
      local paths: std::vector<std::string>
      opt the directory does not exist / no-directory {
        return
      }
      loop each entry under the directory, recursively {
        opt a regular file ending in .ds {
        }
      }
      // the paths are sorted here, so the order of the files is the order of the paths
      local files: std::vector<ParsedFile>
      loop each path {
        alt the file cannot be opened / unreadable {
          -> parseFile(path) / unreadable
          return
        } else {
          -> parseFile(path) -> file
        }
      }
      return files
    }

    dataclass Span {                         // where a node is written in its file: lines and columns from 1, its end included
      @requirement REQ-00008-1
      + line: int
      + column: int
      + endLine: int
      + endColumn: int
    }
    class TreeReader {                       // the syntax tree of one parsed file, read; it knows no model (DS-354)
      @requirement REQ-00008-1
      - refs file_: ParsedFile
      + TreeReader(file: ParsedFile)
      + static is(node: TSNode, type: char) -> bool
      + static child(node: TSNode, field: Field) -> TSNode
      + static childrenNamed(node: TSNode, field: Field) -> std::vector<TSNode>
      + fieldText(node: TSNode, field: Field) -> std::string
      + textOf(node: TSNode) -> std::string
      + static spanOf(node: TSNode) -> Span
      + root() -> TSNode
      + file() -> ParsedFile
      + static nameOf(field: Field) -> char       // the name grammar.js gives the field
      - static idOf(field: Field) -> TSFieldId
      - static ids() -> std::vector<TSFieldId>     // each field's id, resolved once from its name
      - static resolve() -> std::vector<TSFieldId>
    }

    enum Field {                             // a field of the grammar, as grammar.js names it, read by its id (DS-360)
      @requirement REQ-00008-1
      action, base, body, bound, call, code, condition, default_, definition, else_scenario, entity, event, fails, failure, family, field, from, guard, id, key, kind, left, many, modifier, name, negated, of, op, operator_, operators, optional, otherwise, ownership, package, parameter, params, prefix, realises, relation, result, returns, right, scenario, scope, show, subject, symbol, target, text, title, to, type, value, variable, visibility
    }
  }
}

diagram CL_ParseNamespace {
  kind: class
  include: driftspec@ds@parse::*
  show: ownership
}
