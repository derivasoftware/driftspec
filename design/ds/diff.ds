// LLD of the diff namespace (ds::diff): two models compared by identity
// (SREQ-00007-1). Nothing here reads files: the models arrive resolved, the
// result is a list of changes and a marked model for the drawings.

package driftspec@ds {

  module diff {

    requirement REQ-00004-1 {
      status: approved
      @refines SREQ-00007-1
      title: The diff shall compare two models by identity and mark the second with every change
      text:
        Entities and relations present in one model and not the other are
        added or removed; an entity with the same identity and a different
        shape is changed; an entity removed and one added with the same shape
        are a rename, the referrers deciding between candidates. A
        declaration moved or reordered is no change. An artefact whose text
        changed under the same revision is a finding, W-REVISION-STALE. The
        marked model is the second with a change on every entity and relation
        the result names, so a diagram draws the difference.
      rationale:
        A review needs the design's changes in the design's terms; only
        identities make that possible, and only a marked model lets the
        drawing show it without a second renderer.
      tags: diff, identity
    }

    verification VER-00004-3 {
      status: approved
      @requirement REQ-00004-1
      title: Unit tests cover no-change on moves, add/remove/change, renames by shape and referrers, the stale revision and the marked model
      method: test
      tests:
        tests/integration/ds/diff/test_diff.cpp::TestDiff.AMovedOrReorderedDeclarationIsNoChange
        tests/integration/ds/diff/test_diff.cpp::TestDiff.AddedRemovedAndChangedByIdentity
        tests/integration/ds/diff/test_diff.cpp::TestDiff.ARenameIsRecognisedByShapeAndByWhoFollows
        tests/integration/ds/diff/test_diff.cpp::TestDiff.AnArtefactChangedWithoutANewRevisionIsAFinding
        tests/integration/ds/diff/test_diff.cpp::TestDiff.TheMarkedModelCarriesTheChangesForADrawing
        tests/integration/ds/diff/test_diff.cpp::TestDiff.WhatTheCheckDerivesIsNoChangeOfItsOwn
        tests/integration/ds/diff/test_diff.cpp::TestDiff.AUseCaseChangedWithoutANewRevisionIsAFinding
    }

    dataclass Change {                       // one difference: what changed, on which identity, how
      @requirement REQ-00004-1
      + kind: std::string
      + what: std::string
      + id: std::string
      + entity: std::string
      + scope: std::string
      + detail: std::string
      + from: std::string
      + label: std::string
    }

    dataclass DiffResult {                   // the changes and the findings of a comparison
      @requirement REQ-00004-1
      + owns changes: std::vector<Change>
      + findings: std::vector<model::Finding>
      + added() -> int
      + removed() -> int
      + changed() -> int
      + empty() -> bool
    }

    class Diff {                             // the comparison, stateless
      @requirement REQ-00004-1
      + static compare(a: model::Model, b: model::Model) -> DiffResult
      + static marked(a: model::Model, b: model::Model, diff: DiffResult) -> model::Model
      + static report(diff: DiffResult) -> std::string
    }

    // What two declarations of one identity differ in, as "key: a -> b" items.
    - function differences(a: model::Entity, b: model::Entity) -> std::vector<std::string>

    // A class's shape: its members' names and signatures, to recognise a rename.
    - function shapeOf(m: model::Model, classId: std::string) -> std::set<std::string>

    // The lambda referrers, who points at a class, is left out: lambdas are not declared.
    // So the tie it breaks between look-alikes shows only in the comment that scores them.
    sequence Diff::compare {
      local out: DiffResult
      self -> a.entities() -> before
      loop each entity of a that is not expected {
        self -> b.find(id) -> counterpart
        opt b has it {
          -> differences(entity, counterpart) -> diffs
          opt they differ and it is an artefact {
            // out gets W-REVISION-STALE beside the change
          }
        }
      }
      self -> b.entities() -> after
      loop each entity of b that is not expected {
        self -> a.find(id) -> counterpart
      }
      loop each class removed from a {
        -> shapeOf(a, removedId) -> shape
        loop each class added to b in the same scope and not yet matched {
          -> shapeOf(b, addedId) -> candidate
          // scored by shape and referrers; the best with 60 % of its members alike is the rename
        }
      }
      loop each rename {
        self -> a.entities() -> before
        loop each member of the old class {
          self -> b.find(newId) -> counterpart
          opt b has it {
            local moved: model::Entity       // the old member, under its new scope
            -> differences(moved, counterpart) -> diffs
          }
        }
        self -> b.entities() -> after
        loop each member of the new class {
          self -> a.find(oldId) -> counterpart
        }
      }
      self -> a.entities() -> before
      loop each entity of a neither expected nor renamed {
        self -> b.find(id) -> counterpart
      }
      self -> b.entities() -> after
      loop each entity of b neither expected nor matched by a rename {
        self -> a.find(id) -> counterpart
      }
      // every relation of each, through the one way into a model's relations (DS-171)
      self -> a.index() -> indexBefore
      self -> b.index() -> indexAfter
      self -> indexBefore.all() -> relationsBefore
      self -> indexAfter.all() -> relationsAfter
      self -> indexBefore.all() -> relationsBefore
      loop each relation of a {
        self -> a.find(source) -> sourceEntity
      }
      loop each relation key only in b {
        self -> b.find(source) -> sourceEntity
      }
      return out
    }

    sequence Diff::marked {
      local out: model::Model                // starts as a copy of b
      self -> b.entities() -> entities
      loop each entity of b the diff names {
        self -> out.find(id) -> entity
      }
      loop each change that removed an entity {
        self -> a.find(id) -> ghost
        opt a has it {
          self -> out.declare(ghost)
        }
      }
      local rebuilt: model::Model
      self -> out.entities() -> entities
      loop each entity of out {
        self -> rebuilt.declare(entity)
      }
      self -> out.index() -> marked
      self -> marked.all() -> relations
      loop each relation of out {
        self -> rebuilt.relate(relation)
      }
      self -> a.index() -> before
      self -> before.all() -> relations
      loop each relation of a {
        opt the diff removed it {
          self -> rebuilt.relate(relation)
        }
      }
      self -> out.findings() -> findings
      loop each finding of out {
        self -> rebuilt.report(finding)
      }
      return rebuilt
    }

    // The text is built on a stream, so what comes back is a name for it, not a checked value.
    sequence Diff::report {
      self -> diff.empty() -> nothing
      opt the diff is empty / no-change {
        return "no design change\n"
      }
      loop each scope with its changes {
        loop each change of the scope {
          // one line: its mark, its entity, its name, its detail
        }
      }
      self -> diff.added() -> added
      self -> diff.removed() -> removed
      self -> diff.changed() -> changed
      loop each finding of the diff {
        // one line: where, code, message
      }
      return text
    }
  }
}

diagram CL_DiffNamespace {
  kind: class
  include: driftspec@ds@diff::*
  show: ownership
}
