// LLD of the model namespace (ds::model): the resolved workspace and the
// entities it is made of. Types are written as argos's C++ reader renders them
// (std::string, std::map<std::string, Entity>), so design and code compare
// without noise; references and const are not part of the type.

package driftspec@ds {


  // What it is to depend, said once for every rule of the tool (a definition of a package is in scope
  // in its modules): through a member that owns, refers to or uses, or through a behaviour that uses.
  definition depends(a, b) {
    title: a depends on b itself, through one of its members or through its behaviours
    if a uses b
    if m in a, m owns b
    if m in a, m refs b
    if m in a, m uses b
    if m in a, s behaviour-of m, s uses b
  }

  definition changes-the-model(b) {
    title: b is one of the model's operations that change what it keeps (DS-367)
    if b = driftspec@ds@model::Model::declare
    if b = driftspec@ds@model::Model::annotate
    if b = driftspec@ds@model::Model::refine
    if b = driftspec@ds@model::Model::relate
    if b = driftspec@ds@model::Model::report
    if b = driftspec@ds@model::Model::rename
    if b = driftspec@ds@model::Model::cover
    if b = driftspec@ds@model::Model::withdrawEchoes
    if b = driftspec@ds@model::Model::sortFindings
    if b = driftspec@ds@model::Model::state
    if b = driftspec@ds@model::Model::breach
    if b = driftspec@ds@model::Model::tabulate
  }

  requirement REQ-00264-1 {
    status: draft
    @refines REQ-00066-1
    title: The metamodel shall say what each kind is part of, in one of five categories, and the export, the manual, the scene and the editor shall read it there
    text:
      Each kind of the language is part of one category, the Owner's five: structure (package, module,
      interface, operation, class, enum, function, method, attribute, operator), artefact (requirement,
      verification, constraint, usecase, outcome), behaviour (sequence, message, frame, view), logic (rule,
      definition, state) and view (diagram, and a walkthrough's step). The metamodel says it once, KindSpec's category; the export writes
      it with each kind, as ds manual <kind> --json does, and the scene carries each kind's category for the
      viewer to group by, its perspectives drawing what they drew. A door keeps no table of kinds of its own:
      the editor finds what a line is written in whatever its kind, and draws an artefact as a requirement.
    rationale: Owner, 2026-11-25 (DS-427: the five categories, logic its own as the manual's perspectives have it); code-62, 2026-11-25 (D1 operator and outcome join, D2 the innermost entity whatever its kind, D3 the scene's layers keep what they draw).
    tags: metamodel, editor, viewer
    verification VER-00284-1 {
      status: draft
      title: Integration tests confirm the export and the scene say each kind's category as the metamodel gives it, and the editor finds a line's entity whatever its kind
      method: test
      tests:
        tests/integration/ds/model/test_kind_categories.cpp::TestKindCategories.TheExportAndTheSceneSayEachKindsCategoryAsTheMetamodelGivesIt
        tests/integration/python/test_editor_kinds.py::test_a_line_finds_what_it_is_written_in_whatever_its_kind
    }
  }

  module model {
    @requirement REQ-00175-1                 // every operation of the model is a member of a class (DS-365)

    // the other checks name their subject too (DS-478, phase b of DS-426): a verification of its own, beside the
    // approved one, so REQ-00240-1's text is not touched
    verification VER-00267-1 {
      @requirement REQ-00240-1
      status: draft
      title: An integration test confirms every check names the entity its finding is about, and one about a file or a word names none
      method: test
      tests:
        tests/integration/ds/check/test_finding_subject.cpp::TestFindingSubjects.EveryCheckNamesTheEntityItsFindingIsAbout
    }

    // the doors attach a finding to its subject (DS-488, phase c of DS-426): one requirement per capability
    requirement REQ-00330-1 {
      tags: finding, subject, editor
      status: draft
      @refines REQ-00240-1
      title: The editor shall show a finding on the entity it is about
      text:
        Each diagnostic the language server publishes carries, as data.subject, the identity of the entity its finding
        is about, when it names one. Hover on an entity lists its own problems, the findings and coverage whose subject
        it is, wherever they are written, five at most and then how many more.
      rationale:
        A problem written in one file about an entity declared in another reaches the entity, not only the line.
      verification VER-00380-1 {
        status: draft
        title: Integration tests confirm a diagnostic carries its subject and hover on an entity lists a problem written in another file
        method: test
        tests:
          tests/integration/python/test_lsp.py::TestAFindingOnItsSubject::test_each_diagnostic_carries_the_entity_it_is_about
          tests/integration/python/test_lsp.py::TestAFindingOnItsSubject::test_hover_on_an_entity_lists_a_problem_written_in_another_file
      }
    }

    requirement REQ-00331-1 {
      tags: finding, subject, live
      status: draft
      @refines REQ-00240-1
      title: The live viewer shall frame the entity a finding is about
      text:
        The live state gives each finding and coverage item its subject. Clicked, a finding with a subject frames that
        entity on the map. With something selected and the selection filter on, the findings and the coverage keep
        only those about what is selected or what it holds.
      rationale:
        The live viewer's rules panel attaches by subject since DS-426; the findings follow it.
      verification VER-00381-1 {
        status: draft
        title: Integration tests confirm the live state carries each finding's subject and the page frames and keeps it on the selection
        method: test
        tests:
          tests/integration/python/test_live_subjects.py::TestAFindingOnItsSubject::test_the_state_gives_each_finding_and_coverage_item_its_subject
          tests/integration/python/test_live_subjects.py::TestAFindingOnItsSubject::test_a_finding_about_an_entity_is_drawn_to_frame_it_and_kept_on_its_selection
      }
    }

    requirement REQ-00240-1 {
      tags: findings, model
      status: approved
      @refines SREQ-00002-1
      title: A finding about an entity shall name it by identity as its subject, and a finding about a file or a word shall name none
      text:
        Each finding carries a subject: the identity of the entity it is about, so a door attaches it to that entity by
        identity and not by where it is written or by how its message begins. A finding between two entities takes the
        one where it is written; a rule's finding, a breach included, takes the rule, whose breach carries the entities
        it binds. A finding about a file or a word (it does not parse, it is not UTF-8, an annotation no one knows)
        names none. The message is unchanged. The report and the export write the subject only when there is one.
      rationale:
        Owner, 2026-11-25 (DS-426, from DS-421): the live viewer attached a rule's problems by place and by message
        prefix; a subject lets every door do it by identity. The rule pipeline says it first; the other checks follow
        with the service layer (DS-406).
      verification VER-00262-1 {
        status: approved
        title: Integration tests confirm a rule's findings, a breach included, name the rule, a finding about a file names none, and the report and the export write the subject only when there is one
        method: test
        tests:
          tests/integration/ds/check/test_finding_subject.cpp::TestFindingSubject.ARulesFindingsNameTheRuleABreachIncluded
          tests/integration/ds/check/test_finding_subject.cpp::TestFindingSubject.AFindingAboutAFileNamesNoneAndTheKeyIsLeftOut
          tests/integration/ds/check/test_finding_subject.cpp::TestFindingSubject.TheExportWritesTheSubjectAsTheReportDoes
      }
    }

    requirement REQ-00001-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall hold one entity per identity, letting a declaration take the place of the expected node that preceded it
      text:
        Declaring an identity the model does not hold adds it. Declaring one
        held as expected (referenced before, declared nowhere) replaces the
        expected node. A second reference to an expected node keeps the one
        node. Packages and modules reopen: a second declaration returns the
        first. Any other second declaration of one identity is reported as
        E-DUPLICATE-IDENTITY at the second location, naming the first.
      rationale:
        References arrive before declarations in any order of files; the
        model absorbs them without losing either, and still says where an
        identity was declared twice.
      tags: identity, model
    }

    requirement REQ-00002-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall rename an entity carrying its members and every relation that names it
      text:
        Renaming an identity moves the entity, every entity whose identity or
        scope begins with it (members, scenarios) and every relation end that
        names it or a member of it. Renaming onto an identity another
        declared entity holds is refused with E-DUPLICATE-IDENTITY; onto an
        expected node, the node gives way.
      rationale:
        An identity can only be known late: a behaviour is identified by its
        subject, which resolves after binding, so the checker renames it to the
        resolved identity and the model keeps everything that named it whole.
      tags: identity, behaviour
    }

    verification VER-00001-2 {
      status: approved
      @requirement REQ-00001-1
      title: Integration tests cover declaring once, a name used before its declaration ending as one declared entity, and the duplicate reported with where the first is
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.WhatIsNamedBeforeItIsDeclaredIsOneEntityAndNotExpected
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ASecondDeclarationIsReportedWithWhereTheFirstIs
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.AnEntityKeepsTheFlagsItWasDeclaredWith
    }

    verification VER-00002-2 {
      status: approved
      @requirement REQ-00002-1
      title: Integration tests cover a behaviour renamed onto its subject with its steps and relations, and the rename refused onto a declared identity
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ABehaviourWrittenInAnotherModuleIsRenamedOntoItsSubjectWithItsStepsAndRelations
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ARenameOntoADeclaredIdentityIsRefused
    }

    // identities, written in one place (DS-124), as three values (DS-184): packages join with @, the
    // rest with ::, a behaviour is its subject with ::sequence[/scenario] or ::state, a template
    // carries its arity, a diagram is diagram:NAME. An entity keeps its id as text; these wrap it.
    class Identity <<==>> {       // what an entity is called: p@m::C, p@m::C::run::sequence/out
      @constraint CST-00004-1
      @requirement REQ-00035-1
      - text_: std::string
      + Identity(text: std::string)
      + static ofDiagram(name: std::string) -> Identity
      + text() -> std::string
      + empty() -> bool
      + lastName() -> std::string
      + scope() -> Scope
      + isQualified() -> bool
      + isAbsolute() -> bool
      + within(outer: Identity) -> bool          // read in place: nothing is built per comparison (DS-346)
      + withArity(arity: std::size_t) -> Identity {
        @requirement REQ-00029-2
      }
      + withParameters(types: std::string) -> Identity {   // an overload's identity: name(T1, T2) (DS-455)
        @requirement REQ-00252-1
      }
      + bare() -> Identity {                     // without the parameter list that closes it (DS-455)
        @requirement REQ-00252-1
      }
      // where :: or @ is found outside a parameter list: an overload's types never split its identity (DS-455)
      + static findOutsideParameters(text: std::string, what: std::string, last: bool) -> std::size_t {
        @requirement REQ-00252-1
      }
      + diagramName() -> std::string
      + sequence(scenario: std::string) -> Identity
      + state() -> Identity
      + withScenario(scenario: std::string) -> Identity
      + behaviour() -> Identity
      + scenario() -> std::string
      + subject() -> Identity
      + machineSubject() -> Identity
      + branch(elseSide: bool) -> Identity      // alt::b0, or alt::b1 after its else (DS-345)
      operator ==(other: Identity) -> bool
      - kSequence: std::string      // what a sequence adds to its subject: ::sequence
      - kState: std::string         // what a state machine adds to its subject: ::state
      - kDiagram: std::string       // what a diagram's identity starts with: diagram:
    }
    class Scope <<==>> {          // where a name is written: p@, app@core@, p@m, p@m::C
      @constraint CST-00004-1
      @requirement REQ-00018-1
      - text_: std::string
      + Scope(text: std::string)
      + static inside(package: Identity) -> Scope
      + text() -> std::string
      + empty() -> bool
      + qualify(name: std::string) -> Identity
      + outer() -> Scope
      + package() -> Scope
      + box() -> Identity
      + isSystem() -> bool
      operator ==(other: Scope) -> bool
      // the scope outside a text, which outer() steps to and an identity's scope() is its own text stepped out of
      - static outerOf(text: std::string) -> std::string {
        @requirement REQ-00035-1
      }
    }
    class ArtefactName <<==>> {   // a process artefact's name: REQ-00001-2
      @requirement REQ-00043-1
      - text_: std::string
      + ArtefactName(text: std::string)
      + static matches(text: std::string) -> bool
      + text() -> std::string
      + hasRevision() -> bool
      + withoutRevision() -> ArtefactName
      operator ==(other: ArtefactName) -> bool
      - static writtenWithRevision(text: std::string, stem: std::string) -> bool   // PREFIX(-PART)*-NUMBER-REVISION
      - static writtenBare(text: std::string) -> bool                              // PREFIX(-PART)*-NUMBER
      - static numberParts(text: std::string, lastDash: std::size_t) -> int         // the number parts after the letter parts, or -1 (DS-335)
    }
    class WrittenType {            // a type as the design writes it: std::vector<model::Entity>, the code's text (DS-390)
      @requirement REQ-00119-2                 // a contract compares the idea each type commits to; the scene's rows read it too
      - text_: std::string
      + WrittenType(text: std::string)
      + unqualified() -> std::string            // std::vector<model::Entity> is vector<Entity>
      - static inWord(c: char) -> bool
      - static startsName(c: char) -> bool
    }

    // a walkthrough as written, its steps resolved: built once and written by each document in its own
    // convention, the export by identity and the scene by index (DS-471)
    dataclass Walkthrough {
      @requirement REQ-00243-1
      + id: std::string
      + name: std::string
      + title: std::string
      + owns many steps: std::vector<WalkStep>
    }

    dataclass WalkStep {                     // one step of a walkthrough
      @requirement REQ-00243-1
      + id: std::string
      + n: int
      + title: std::string
      + show: std::string
      + diagram: std::string
      + scenario: std::string
      + focus: std::vector<std::string>
      + highlight: std::vector<std::string>
      + at: std::string
      + text: std::string
    }

    // the one place a walkthrough's steps are resolved, from the steps and the relations the linker made (DS-471)
    class Walkthroughs {
      @requirement REQ-00243-1
      + static of(model: Model) -> std::vector<Walkthrough>
    }

    // The walks of a model's behaviours (DS-343): which scenarios a behaviour names, the steps the path of one
    // takes, and who a behaviour runs on, which the check and the state machines ask the same. Made over a model
    // that outlives it, which it reads and never changes; it holds nothing else, so whoever asks makes one where
    // it asks.
    class Paths {
      - refs model_: Model
      + Paths(model: Model)
      + hasScenario(sequence: std::string, scenario: std::string) -> bool {
        @requirement REQ-00065-1
      }
      + pathOf(sequence: std::string, scenario: std::string, kept: std::set<std::string>) -> std::vector<const Entity*> {
        @requirement REQ-00065-1
      }
      // a method's class, a function's module, an operation's interface, or its subject; "" when it is declared nowhere
      + holderOf(sequence: std::string) -> std::string
      // the value of a field of an entity; "" when it does not carry it
      - static fieldIn(e: Entity, key: std::string) -> std::string
    }

    // the frames of one behaviour, read from its tree, and for each what its two sides name: Paths's own, defined
    // in src/ds/model/Paths.cpp and in no header, and made by pathOf over the tree it walks
    - class Branches {
      @requirement REQ-00065-1
      - refs tree_: SequenceTree
      + Branches(tree: SequenceTree)
      + names(f: Entity, elseSide: bool) -> std::set<std::string>
      + decide(f: Entity, scenario: std::string) -> Way
    }

    // A behaviour's steps are kept as the tree they are written in (DS-172): each message and frame
    // contained by what encloses it, the sequence or a frame, in the order written; an alt holds its
    // sides as frames of kind branch. Read once here: whoever asks the order of a message, the frame
    // around a step or where an alt's else begins asks the same tree, and none rebuilds it.
    class SequenceTree {
      @requirement REQ-00065-1
      @requirement REQ-00049-3
      - refs model_: Model
      - messages_: std::vector<std::string>
      - frames_: std::vector<std::string>
      - order_: std::map<std::string, int>
      - frameOf_: std::map<std::string, std::string>
      - at_: std::map<std::string, int>
      - first_: std::map<std::string, std::string>
      - onElse_: std::set<std::pair<std::string, std::string>>   // (frame, step) on the else side of a frame, told by the walk (DS-345)
      - elseFirst_: std::map<std::string, std::string>
      - sides_: std::vector<std::string>
      + SequenceTree(model: Model, sequence: std::string)
      + model() -> Model
      + messages() -> std::vector<std::string>
      + frames() -> std::vector<std::string>
      + orderOf(message: std::string) -> int
      + frameOf(id: std::string) -> std::string
      + at(frame: std::string) -> int
      + first(frame: std::string) -> std::string
      + elseOf(frame: std::string) -> std::string
      + twoSides(frame: std::string) -> bool
      + onElse(frame: std::string, id: std::string) -> bool
      + scenario(frame: std::string, elseSide: bool) -> std::string
      + inside(frame: std::string, elseSide: bool) -> std::vector<std::string>
      - walk(holder: std::string, frame: std::string) -> void
      - static isBranch(e: Entity) -> bool
    }

    // What the sequence or a frame holds, asked of the index in the order written: a message takes the
    // next place, a frame opens before what it holds, a branch is a side of the frame around it.
    sequence SequenceTree::walk {
      self -> model_.index() -> index
      self -> index.children(holder) -> held
      loop each step held, in the order written {
        self -> model_.find(id) -> step
        alt a message / message {
          // it takes the next place; it is the first of every frame around it that has none yet
        } else {
          opt a branch / branch {
            -> walk(id, frame)
          }
          opt a loop, an alt or an opt / frame {
            -> walk(id, id)
          }
        }
      }
    }

    verification VER-00121-2 {
      status: approved
      @requirement REQ-00065-1
      @requirement REQ-00049-3
      title: Integration tests read one behaviour's tree the same for every reader: messages in the order written, the frame around each step, where a frame opens, an alt's sides and what each names
      method: test
      tests:
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.TheMessagesComeInTheOrderWrittenAtAnyDepth
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.TheFramesAreTheLoopsAltsAndOptsAndEachStepKnowsTheInnermostAroundIt
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.AFrameKnowsWhereItOpensAndWhatItHoldsFirst
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.AnAltKnowsItsElseSideAndWhatEachSideNames
    }

    verification VER-00122-1 {
      status: approved
      @requirement REQ-00001-1
      title: An integration test holds every entity to where it ends as well as where it starts
      method: test
      tests:
        tests/integration/ds/check/test_behaviour.cpp::TestBehaviour.EveryEntityKnowsWhereItEndsAsWellAsWhereItStarts
    }

    // ---- the metamodel (REQ-00066-1): the language declared once ----
    enum FieldType {                         // how to read a field's text
      @requirement REQ-00066-1
      Text, Name, Names, Type, Params, Number, Status, Patterns, Records   // Records: a list of records of named fields (DS-384)
    }

    enum FieldSource {                       // who sets a field: the author, the syntax, or the checker
      @requirement REQ-00066-1
      Written, Syntax, Derived
    }

    dataclass FieldSpec {                    // one field of a kind; a name ending in * is a family
      @requirement REQ-00066-1
      + name: std::string
      + type: FieldType
      + source: FieldSource
      + meaning: std::string
      + values: std::vector<std::string>
      + identity: bool                       // it holds an entity's identity, which a rename carries along (DS-346)
    }

    // what a kind is part of: the Owner's five (DS-427), read by every door instead of a table of kinds of its own
    enum Category {
      @requirement REQ-00264-1
      structure, artefact, behaviour, logic, view
    }

    dataclass KindSpec {                     // one kind: its fields, the flags it takes, what it may be declared inside
      @requirement REQ-00066-1
      + kind: Kind
      + meaning: std::string
      + many fields: std::vector<FieldSpec>
      + flags: std::vector<std::string>
      + many parents: std::vector<Kind>
      + top: bool
      + syntax: std::string                  // how it is written (REQ-00079-2)
      + example: std::string                 // a minimal workspace that declares one and checks clean
      + category: Category                   // what it is part of (DS-427)
    }

    dataclass RelationSpec {                 // one relation and the kinds it may join; no ends is any kind
      @requirement REQ-00066-1
      + kind: std::string
      + meaning: std::string
      + many from: std::vector<Kind>
      + many to: std::vector<Kind>
      + many pairs: std::vector<std::pair<Kind, Kind>>
    }

    // the metamodel's tables (DS-340): the catalogue of finding codes, the annotations that mean something
    // and how each kind is written. The binder, the checker and the kinds read them here; the manual
    // derives its pages from them and the metamodel never reads the manual
    // ---- a finding is made from its code (DS-379), as requirements and the rules that hold them ------------------
    requirement REQ-00193-1 {
      tags: architecture, model, findings
      status: approved
      @refines REQ-00001-1
      title: The findings and the coverage shall be ordered by where they are written and then by what they say, never by the order the check's steps ran in
      text:
        Both lists are ordered by file, then by line, and on one line by code, then by message. Which step found a
        finding, and when it ran, leaves no trace in the order: steps can be split, added or scheduled otherwise and
        every output reads the same.
      rationale:
        Owner, 2026-11-24 (DS-382): splitting one step into five reordered the coverage, which no sort ever ordered,
        and could reorder two findings on one line; the order of the output should follow the design, not the engine.
      verification VER-00213-1 {
        status: approved
        title: Integration tests confirm the findings and the coverage of a design are ordered by file, line, code and message, and the same findings reported in another order come out in the same order
        method: test
        tests:
          tests/integration/ds/check/test_finding_order.cpp::TestFindingOrder.TheFindingsAndTheCoverageOfADesignAreInTheOrderOfWhereAndWhat
          tests/integration/ds/check/test_finding_order.cpp::TestFindingOrder.TheOrderTheyWereReportedInLeavesNoTrace
      }
    }

    requirement REQ-00190-1 {
      tags: architecture, model, findings
      status: approved
      @refines REQ-00079-2
      title: Every finding shall be made from its code by the metamodel, which reads its printed code and its severity from the catalogue
      text:
        A finding is made by Metamodel::finding from a Code, the message and where it is: the catalogue's row for
        the code gives the code as it is printed and its severity, one slot read by the code's place. Nobody writes
        a code as text or a severity by hand, and a code the catalogue does not hold is no Code, so it does not
        compile. Outside the model, nothing reads a code's row.
      rationale:
        Owner, 2026-11-24 (DS-378, DS-379): seventy sites wrote the code and the severity as two strings, and agreed
        with the catalogue only by discipline; the catalogue was read for coverage alone.
      verification VER-00210-1 {
        status: approved
        title: Tests confirm every finding is made from its code with the catalogue's severity, the catalogue holds one row per code in its order, and a class outside the model that reads a code's row is told
        method: test
        tests:
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.EveryFindingOfADesignCarriesTheSeverityOfItsCode
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.TheDesignOfDsKeepsTheRulesOfFindings
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.AClassOutsideTheModelThatReadsTheCatalogueIsTold
      }
    }

    requirement REQ-00191-1 {
      tags: architecture, model, findings
      status: approved
      @refines REQ-00079-2
      title: What a severity means shall be a row of the metamodel's severity table, which every reader asks
      text:
        Severity is a value, and its row says its printed name, whether a finding of it fails the check, whether it
        is kept apart as coverage and what an editor shows it as. The check counts what fails, the model keeps apart
        what is kept apart, and the exports, the formats and the manual print the name. A report carries the table it
        was built in, so a format asks it without the metamodel. A new severity is one value and one row.
      rationale:
        Owner, 2026-11-24 (DS-379): a severity read as a string was compared by its spelling in each reader; asked as
        a row, a reader never names one, and a severity added later reaches each of them.
      verification VER-00211-1 {
        status: approved
        title: Tests confirm each severity is a row that says what it means, the report carries the table, and a class outside the model and the report that holds a row is told
        method: test
        tests:
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.TheReportCountsWhatFailsAndPrintsEachSeverityByName
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.TheDesignOfDsKeepsTheRulesOfFindings
          tests/integration/ds/check/test_finding_principles.cpp::TestFindingPrinciples.AClassThatHoldsASeverityRowIsTold
      }
    }

    rule findings-come-from-the-catalogue {
      title: no class outside the model depends on a code's row, so every finding is made from its code by the metamodel
      @requirement REQ-00190-1
      for class c in driftspec@ds
      where not c in driftspec@ds@model
      never depends(c, driftspec@ds@model::CodeSpec)
    }

    rule severities-are-asked-of-their-table {
      title: what a severity means is held only by the metamodel and by the report it hands to the formats, so every reader asks the row
      @requirement REQ-00191-1
      for class c in driftspec@ds
      where not c in driftspec@ds@model, c != driftspec@ds@check::Report
      never depends(c, driftspec@ds@model::SeveritySpec)
    }

    enum Code {                              // a finding code of the catalogue, in its order: E-SYNTAX is E_SYNTAX (DS-379)
      @requirement REQ-00190-1
      E_SYNTAX, E_ENCODING, E_NAME_RESERVED, E_DUPLICATE_IDENTITY, E_MSG_ARITY, E_MODIFIER_CONFLICT, E_OPERATOR_UNDECLARED,
      E_OWNERSHIP_CYCLE, E_RELATION_KIND, E_REF_UNPINNED, E_REFINES_CYCLE, E_INHERITANCE_CYCLE, E_TEMPLATE_BOUND,
      E_DATACLASS_ABSTRACT, W_REF_UNDECLARED, W_NAME_AMBIGUOUS, W_REVISION_DRIFT, W_PARENT_IGNORED, W_FIELD_UNKNOWN,
      W_ANNOTATION_UNKNOWN, W_DIAGRAM_UNDECLARED, W_RULE_NEVER_MATCHES, W_REFINES_UPWARD, W_SATISFIES_OUTSIDE_HOME,
      W_INTERFACE_SIGNATURE, W_HANDLER_UNREACHED, W_FIELD_VALUE, W_MSG_UNDECLARED, W_MSG_NOT_STATIC, W_ARG_TYPE,
      W_RETURN_TYPE, W_SCENARIO_UNDECLARED, W_SCENARIO_TWICE, W_LEVEL_NO_CROSSING, W_LEVEL_ORDER, W_LEVEL_NOT_BELOW,
      W_STATE_OVERLAP, W_STATE_VALUE, W_STATE_UNDECLARED, W_STATE_IMPOSSIBLE, W_STATE_ORDER, W_MESSAGE_NO_OPERATION,
      W_OPERATION_NO_BEHAVIOUR, W_OUTCOME_MISMATCH, W_EVENT_UNDECLARED, W_ACTION_UNDECLARED, W_VIEW_UNDECLARED,
      W_VIEW_UNREACHABLE, W_STATE_UNREACHABLE, W_FAILURE_UNDECLARED, W_FAILURE_UNREACHED, W_VIEW_NO_WAY_OUT,
      W_NOT_VISIBLE, W_PRIVATE_LEAK, W_DIAGRAM_DEPTH, W_DIAGRAM_NEIGHBOURS, W_REQ_NO_VERIFICATION, W_VER_NO_TEST,
      W_RULE_NO_REQUIREMENT, W_RULE_NO_CLAIM, W_DEFINITION_NO_CASE, E_RULE_BROKEN, E_RULE_UNKNOWN, E_RULE_ARITY,
      E_RULE_UNSAFE, E_RULE_UNSTRATIFIED, W_CONSUMES_UNDECLARED, W_CONSUMES_UNUSED, W_CONSUMES_BYPASS,
      W_LANGUAGE_UNKNOWN, W_USECASE_UNDECLARED, W_USECASE_SIGNATURE, W_USECASE_OUTCOME_UNHANDLED,
      W_SCENARIO_NO_OUTCOME, W_USECASE_UNREALISED, E_RULE_PATTERN, E_RULE_RESERVED, W_REQ_UNREALISED,
      W_CST_NO_VERIFICATION, W_WALK_UNDECLARED, W_WALK_NOT_SHOWN, W_WALK_AT, W_WALK_EMPTY
    }

    enum Severity {                          // how much a finding weighs; what it means is its row of the severity table (DS-379)
      @requirement REQ-00191-1
      error, warning, coverage
    }

    dataclass CodeSpec {                     // a finding code: what it means and what to do about it
      @requirement REQ-00079-2
      @requirement REQ-00190-1
      + id: Code
      + code: std::string                    // as it is printed: E-SYNTAX
      + severity: Severity
      + meaning: std::string
      + fix: std::string
    }

    dataclass SeveritySpec {                 // what a severity means: its name, whether it fails, whether it is kept apart, how an editor shows it
      @requirement REQ-00191-1
      + id: Severity
      + name: std::string
      + fails: bool
      + keptApart: bool
      + editor: std::string                  // error, warning, information or hint
    }

    dataclass AnnotationSpec {               // an annotation that means something, and the relation it makes
      @requirement REQ-00079-2
      @requirement REQ-00088-1
      + name: std::string
      + relation: std::string
      + meaning: std::string
      + onVerification: std::string
      + target: Kind
    }

    requirement REQ-00175-1 {
      tags: architecture, model
      status: approved
      @refines REQ-00001-1
      title: Every operation of the model shall be a member of the class whose responsibility it is
      text:
        What the model holds and answers is the Model's, what it is indexed by is the Index's, a path through a
        behaviour is the Paths', an identity's form is the Identity's and the language is the Metamodel's. A
        function of the module would be a responsibility no class names.
      rationale:
        Owner, 2026-11-24 (DS-339, DS-365): every module has its architecture decisions and patterns, and its rules
        check that they hold; a free function means a responsibility is missing.
      verification VER-00192-1 {
        status: approved
        title: Integration tests confirm the design of the model holds no function of the module, and is told when one is written
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.AFunctionOfTheModelIsTold
      }
    }

    rule model-operations-belong-to-classes {
      title: no function is written in the model's module, so every operation of the model is a member of a class
      @requirement REQ-00175-1
      for function f in driftspec@ds@model
      never f in driftspec@ds@model
    }

    requirement REQ-00174-1 {
      tags: architecture, model
      status: approved
      @refines REQ-00066-1
      title: The metamodel shall build its own tables when it is created
      text:
        The kinds, the relations, the codes, the annotations and how each kind is written are built by the
        metamodel's own builders when it is made, once where the engine starts, and read from then on through its
        questions. What builds them belongs to the metamodel and nothing outside the model calls it.
      rationale:
        Owner, 2026-11-24 (DS-339, DS-365): the language is declared once (DS-341); a metamodel that others could
        build or change would no longer be the one every reader is handed.
      verification VER-00190-1 {
        status: approved
        title: Integration tests confirm the design of ds builds the metamodel's tables in the metamodel, and is told when something outside the model calls what builds them
        method: test
        tests:
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.TheDesignOfDsKeepsEveryPrinciple
          tests/integration/ds/check/test_engine_principles.cpp::TestEnginePrinciples.ACallFromOutsideTheModelToWhatBuildsTheMetamodelIsTold
      }
    }

    rule the-metamodel-is-built-once {
      title: nothing outside the model calls what builds the metamodel's tables, so the metamodel builds them itself when it is made
      @requirement REQ-00174-1
      for class c in driftspec@ds, method b in driftspec@ds@model::Metamodel
      where not c in driftspec@ds@model, b.visibility = "-"
      never m in c, s behaviour-of m, x in s, x calls b
    }

    // The language declared once (DS-341): a class whose tables are built when it is made, one made where
    // the engine starts (the command line's run, the Python module, the page's engine) and handed by const
    // reference to the model, the binder, the checker and the manual. No static accessor reaches it.
    class Metamodel {
      @requirement REQ-00174-1
      @requirement REQ-00066-1
      @requirement REQ-00079-2
      - owns many names_: std::vector<std::string>                          // each kind's name, by its place in Kind
      - owns forms_: std::map<Kind, std::pair<std::string, std::string>>   // how each kind is written, and its example
      - owns many kinds_: std::vector<KindSpec>
      - owns many identityFields_: std::vector<std::string>             // the fields that hold an identity, from the kinds
      - owns many relations_: std::vector<RelationSpec>
      - owns many codes_: std::vector<CodeSpec>
      - owns many severities_: std::vector<SeveritySpec>
      - owns many known_: std::vector<AnnotationSpec>
      - owns other_: AnnotationSpec
      - owns many annotations_: std::vector<AnnotationSpec>
      + Metamodel()
      + kinds() -> std::vector<KindSpec> {
        @requirement REQ-00093-1
      }
      + relations() -> std::vector<RelationSpec> {
        @requirement REQ-00093-1
      }
      + specOf(kind: Kind) -> KindSpec
      + specNamed(name: std::string) -> KindSpec                    // the kind a word names, as nameOf writes it; none when it names no kind
      + static reservedField(name: std::string) -> bool {          // name and id: the entity's own, never a declared field (DS-403)
        @requirement REQ-00196-1
      }
      + flagNamed(name: std::string) -> bool {                      // a flag some kind declares: what `m is abstract` tests (DS-403)
        @requirement REQ-00196-1
      }
      + fieldOf(kind: Kind, key: std::string) -> FieldSpec
      + identityFields() -> std::vector<std::string>                 // the fields that hold an identity, each once: what a rename carries
      + relationOf(kind: std::string) -> RelationSpec
      + joins(relation: RelationSpec, from: Kind, to: Kind) -> bool
      + codes() -> std::vector<CodeSpec>
      + codeOf(code: std::string) -> CodeSpec                       // by its printed name, as a reader asks for it
      + rowOf(code: Code) -> CodeSpec {                             // a code's row: one slot, by its place in Code (DS-379)
        @requirement REQ-00190-1
      }
      + severities() -> std::vector<SeveritySpec>
      + severityOf(severity: Severity) -> SeveritySpec {            // one slot, by its place in Severity (DS-379)
        @requirement REQ-00191-1
      }
      + finding(code: Code, message: std::string, location: Location, subject: std::string) -> Finding {   // the one maker of a finding (DS-379)
        @requirement REQ-00190-1
      }
      + annotations() -> std::vector<AnnotationSpec>                // the rows the manual lists: the known, any other word, the colon after an operation
      + knownAnnotations() -> std::vector<AnnotationSpec> {         // the binder's: nothing else binds as an annotation
        @requirement REQ-00088-1
      }
      + annotationOf(word: std::string) -> AnnotationSpec {
        @requirement REQ-00088-1
      }
      + syntaxOf(kind: Kind) -> std::string
      + exampleOf(kind: Kind) -> std::string
      + nameOf(kind: Kind) -> std::string                           // read from names_, never built per call
      + static categoryOf(kind: Kind) -> Category {                 // the Owner's table, the one place that says it (DS-427)
        @requirement REQ-00264-1
      }
      + static categoryName(category: Category) -> std::string {    // structure, artefact, behaviour, logic, view
        @requirement REQ-00264-1
      }
      + isArtefact(kind: Kind) -> bool {
        @requirement REQ-00043-1
      }
      + fieldTypeName(type: FieldType) -> std::string
      + fieldSourceName(source: FieldSource) -> std::string
      + version() -> std::string {                                  // the language's version, written in when ds is built
        @requirement REQ-00163-1
      }
      // how the tables are built: once, by the constructor
      - static buildNames() -> std::vector<std::string>
      - static spec(name: std::string, type: FieldType, source: FieldSource, meaning: std::string) -> FieldSpec {   // refused when reserved (DS-403)
        @requirement REQ-00196-1
      }
      - static writtenField(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec
      - static syntax(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec
      - static derived(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec
      - static closed(name: std::string, type: FieldType, meaning: std::string, values: std::vector<std::string>) -> FieldSpec
      - static holdingIdentity(field: FieldSpec) -> FieldSpec
      - static artefact() -> std::vector<FieldSpec>
      - static plus(base: std::vector<FieldSpec>, more: std::vector<FieldSpec>) -> std::vector<FieldSpec>
      - static build() -> std::vector<KindSpec>
      - buildIdentityFields() -> std::vector<std::string>            // read from the kinds, each once, in the order declared
      - static rel(kind: std::string, meaning: std::string, from: std::vector<Kind>, to: std::vector<Kind>) -> RelationSpec
      - buildRelations() -> std::vector<RelationSpec>               // containment first, then the others
      - static among(kinds: std::vector<Kind>, kind: Kind) -> bool
      - static matches(name: std::string, key: std::string) -> bool
      - static writtenForms() -> std::map<Kind, std::pair<std::string, std::string>>
      - static buildCodes() -> std::vector<CodeSpec>
      - static buildSeverities() -> std::vector<SeveritySpec>
      - static buildKnownAnnotations() -> std::vector<AnnotationSpec>
      - static buildOtherAnnotation() -> AnnotationSpec
      - buildAnnotations() -> std::vector<AnnotationSpec>
      - describe(kinds: std::vector<KindSpec>) -> std::vector<KindSpec>
      - containment() -> RelationSpec
    }

    // The tables are built once, each from what is built before it: how each kind is written, the kinds
    // that carry it, the relations that containment derives from the kinds, the codes and the annotations.
    sequence Metamodel::Metamodel {
      -> buildNames() -> names
      -> writtenForms() -> forms
      -> build() -> declared
      -> describe(declared) -> described
      -> buildIdentityFields() -> identities
      -> buildRelations() -> relations
      -> buildCodes() -> codes
      -> buildSeverities() -> severities
      -> buildKnownAnnotations() -> known
      -> buildOtherAnnotation() -> other
      -> buildAnnotations() -> annotations
    }

    sequence Metamodel::buildRelations {
      -> containment() -> contains
      loop each relation declared {
        -> rel(kind, meaning, from, to) -> relation
      }
      return relations
    }

    // an annotation the language knows, by its word; any other word is the row that only refers
    sequence Metamodel::annotationOf {
      loop each known annotation {
        opt it is the word {
          return known
        }
      }
      return other_
    }

    // ---- the manual ds embeds (REQ-00079-2): written from the metamodel, held to the engine ----
    requirement REQ-00079-2 {
      status: approved
      @refines SREQ-00014-1
      title: The metamodel shall describe how each kind is written with a minimal example that checks clean, the catalogue of finding codes and the annotations, and the manual shall present them with the commands
      text:
        Every kind of the metamodel says how it is written and gives an
        example: a workspace of its own that declares one and checks with no
        finding. The catalogue holds every code the engine reports, with its
        severity, what it means and what to do, and nothing the engine does
        not report. The annotations that mean something name the relation
        they make. The manual, which reads the metamodel, holds the commands
        and says what each exit code means; its page renders the index, a
        kind, a code, the commands, the annotations or the codes, and nothing
        for a topic it does not know.
      rationale:
        Owner, 2026-11-06 (DS-79): as argos embeds its body of knowledge, ds
        embeds its manual; generated from the metamodel and tested against
        the engine, it is the one place the language is described.
        Revision 2: the language's tables are the metamodel's and the commands
        and the pages are the manual's, a class that reads the metamodel
        (Owner, 2026-11-23, DS-340 to DS-342).
      tags: manual, metamodel, language
    }

    requirement REQ-00163-1 {
      status: approved
      @refines SREQ-00018-2
      title: The tool shall say its version, the same in the command, in Python and in the model it exports
      text:
        The version is kept once, in pyproject.toml, and written into the engine when it is built.
        ds --version prints it (ds 0.1.0) and exits 0; driftspec.__version__ is it; ds export carries it
        as version, beside format, the shape of the exported document, so a reader can tell a
        document it does not know.
      rationale:
        Owner, 2026-11-18 (DS-278), audit for the first release: a tool with users says which
        version answered, and a document read by another tool says what shape it has.
      tags: cli, export, release
    }

    verification VER-00179-1 {
      status: approved
      @requirement REQ-00163-1
      title: Integration tests confirm driftspec.__version__ is written as major.minor.patch and is the version the export of the engine carries
      method: test
      tests:
        tests/integration/python/test_workspace.py::TestWorkspace::test_the_package_says_the_version_of_its_engine
    }

    requirement REQ-00160-2 {
      status: approved
      @refines SREQ-00014-1
      title: The manual shall carry its guides, written as Markdown in the repository and embedded when ds is built, the same text in the terminal and in a page
      text:
        doc/manual/NN-topic.md is a guide: intent, structure, behaviour, logic, using. The build
        embeds each as it is, in the order of its number, and its topic is its name. ds manual
        <topic> prints it, the index lists the guides before the kinds, and the engine for a page
        answers it to a request for the manual (with no topic, the guides and every topic), so a
        site draws the text the terminal prints. An example of a guide is a block marked ds: a
        workspace of its own that checks clean, or, marked ds wrong, one with the finding it is
        there to show.
      rationale:
        Owner, 2026-11-17 (DS-272): one source for the manual in both places. The prose is
        Markdown; what the engine uses to work stays in the engine, the kinds and the codes in
        the metamodel and the commands in the manual, and their pages are generated. Four
        articles by perspective and one on using the tool, in the style of PlantUML's site.
        Revision 2: the commands are the manual's, a class of its own that reads the metamodel
        (Owner, 2026-11-23, DS-342).
      tags: manual, guides
    }

    verification VER-00176-1 {
      status: approved
      @requirement REQ-00160-2
      title: Integration tests confirm every guide starts with its title and is the page of its topic, that each of its examples checks clean or has the finding it is marked for, and that the engine for a page answers the manual
      method: test
      tests:
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryExampleOfAGuideChecksCleanAndOneMarkedWrongHasItsFinding
        tests/integration/ds/api/test_browser_hola.cpp::TestBrowserOverHola.TheManualIsAnsweredByItsOwnRequest
    }

    verification VER-00088-1 {
      status: approved
      @requirement REQ-00079-2
      title: Integration tests confirm every kind is written down with an example that checks clean, the catalogue is exactly the codes the engine reports, and every topic has a page
      method: test
      tests:
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryKindIsWrittenDownAndItsExampleChecksClean
        tests/integration/ds/model/test_manual.cpp::TestManual.TheCatalogueHoldsExactlyTheCodesTheEngineReports
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryTopicHasAPageAndAnUnknownOneHasNone
    }

    dataclass CommandSpec {                  // a command of the manual: how it is invoked, what it does, what each exit code says
      @requirement REQ-00079-2
      + name: std::string
      + synopsis: std::string
      + does: std::string
      + exits: std::vector<std::pair<int, std::string>>
    }

    // The manual ds embeds (DS-342): a class made from the metamodel whoever shows the manual already holds
    // (the command line's run, the page's engine), which outlives it. It writes every page from the metamodel
    // and keeps the commands, which are its own and not the metamodel's; its tables are built once, when it
    // is made, and the page builders are its private members. The metamodel never reads the manual.
    class Manual {
      @requirement REQ-00079-2
      - refs metamodel_: Metamodel                                    // the language it describes, made outside it and outliving it
      - owns many commands_: std::vector<CommandSpec>
      - owns many guides_: std::vector<std::pair<std::string, std::string>>
      + Manual(metamodel: Metamodel)
      + page(topic: std::string) -> std::string                       // the index for no topic; nothing for one it does not know
      + topics() -> std::vector<std::string>
      + guides() -> std::vector<std::pair<std::string, std::string>> {
        @requirement REQ-00160-2
      }
      + commands() -> std::vector<CommandSpec>
      + commandOf(name: std::string) -> CommandSpec
      // how the tables are built, once, by the constructor, and how the pages are written
      - static buildCommands() -> std::vector<CommandSpec>
      - static buildGuides() -> std::vector<std::pair<std::string, std::string>> {  // generated when ds is built (ManualGuides.cpp)
        @requirement REQ-00160-2
      }
      - static indent(text: std::string, by: std::string) -> std::string
      - static pad(text: std::string, width: std::size_t) -> std::string
      - names(kinds: std::vector<Kind>) -> std::string
      - kindPage(k: KindSpec) -> std::string
      - indexPage() -> std::string
      - grammarPage() -> std::string
    }

    sequence Manual::Manual {
      -> buildCommands() -> commands
      -> buildGuides() -> guides
    }

    // a page by its topic: the index, a guide, the grammar, a kind, a code, or one of the tables of the
    // commands, the annotations and the codes; nothing for a topic it does not know
    sequence Manual::page {
      opt no topic {
        -> indexPage() -> index
        return index
      }
      loop each guide {
        opt it is the topic {
          return guide
        }
      }
      opt the grammar {
        -> grammarPage() -> grammar
        return grammar
      }
      self -> metamodel_.specNamed(topic) -> kind
      opt a kind {
        -> kindPage(kind) -> page
        return page
      }
      self -> metamodel_.codeOf(topic) -> code
      opt a code {                                // its severity, what it means and what to do
        return page
      }
      opt the commands {                          // each with how it is typed and its exit codes
        return page
      }
      opt the annotations or the codes {          // a table, each column filled to its width
        -> pad(name, width) -> column
        return page
      }
      return nothing
    }

    enum Kind {
      @requirement REQ-00001-1
      @requirement REQ-00241-1
      Package, Module, Requirement, Verification, Interface, Operation, View, Constraint, Class, Enum, Function, Method, Attribute, Operator, Sequence, Message, Frame, State, Diagram, UseCase, Outcome, Rule, Definition, Step
    }

    dataclass Location {                     // where something was read from: the file, where it starts and where it ends, 1-based
      @requirement REQ-00001-1
      + file: std::string
      + line: int
      + column: int
      + endLine: int                         // the place right after its last character; 0 when not known (DS-172)
      + endColumn: int
    }

    dataclass Param {                        // one parameter as the binder read it: name and type (a template's: name and bound)
      @requirement REQ-00066-1
      + name: std::string
      + type: std::string
    }

    // a state machine's transitions and rules as it writes them, one record each, read once from the syntax (DS-384)
    dataclass WrittenTransition {
      @requirement REQ-00039-1
      + from: std::string
      + to: std::string
      + event: std::string
      + guard: std::string                   // between [ ], without them
      + action: std::string                  // the event it sends: / action
      + owns location: Location
    }

    dataclass RuleLiteral {                  // a name of the context, alone or compared with a value; not turns it
      @requirement REQ-00039-1
      + negated: bool
      + left: std::string
      + op: std::string
      + right: std::string
    }

    dataclass WrittenRule {                  // a state a rule computes and the literals that all hold in it (DS-249)
      @requirement REQ-00039-1
      + state: std::string
      + owns many literals: std::vector<RuleLiteral>
      + owns location: Location
    }

    dataclass Entity {                       // one declared (or expected, R6) entity of the workspace
      @requirement REQ-00001-1
      + kind: Kind
      + id: std::string
      + name: std::string
      + scope: std::string
      + fields: std::map<std::string, std::string>
      + flags: std::vector<std::string>
      + many params: std::vector<Param>
      + args: std::vector<std::string>
      + owns many transitions: std::vector<WrittenTransition>   // a state machine's, never joined text (DS-384)
      + owns many rules: std::vector<WrittenRule>
      + owns location: Location
      + expected: bool
      + has(flag: std::string) -> bool
      + field(key: std::string) -> std::string
      + number(key: std::string, out_number: int) -> bool   // a field written as a whole number an int holds; no number otherwise, never an abort (DS-337)
    }

    sequence Entity::has {
      loop each flag held {
        opt it is the flag asked {
          return true
        }
      }
      return false
    }

    dataclass Relation {                     // a typed relation between two identities
      @requirement REQ-00001-1
      + kind: std::string
      + from: std::string
      + to: std::string
      + owns location: Location
      + multiplicity: std::string
    }

    enum LiteralForm {                       // how a literal of a rule reads (DS-94)
      @requirement REQ-00095-2
      @requirement REQ-00196-1
      Relation, Kind, In, Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual, Call, Arg, Matches, Flag
    }

    dataclass Term {                         // a variable (a bare name), an entity (a qualified name) or a value, as written
      @requirement REQ-00095-2
      @requirement REQ-00196-1
      + text: std::string
      + variable: bool
      + value: bool
      + field: std::string
      + property: std::string                // name, id or kind: what the entity is, read as a function (DS-403)
    }

    dataclass Literal {                      // one literal of a rule or a definition
      @requirement REQ-00095-2
      + form: LiteralForm
      + negated: bool
      + name: std::string
      + owns many terms: std::vector<Term>
      + owns location: Location
    }

    dataclass Range {                        // what a range of for binds: every entity of a kind, optionally inside a box
      @requirement REQ-00095-2
      + kind: std::string
      + variable: std::string
      + scope: std::string
      + owns location: Location
    }

    dataclass Column {                       // one column of a table: a field of the row, what it is, what is related to it, or a yes/no
      @requirement REQ-00154-1
      @requirement REQ-00250-1
      + name: std::string
      + form: std::string
      + variable: std::string
      + field: std::string
      + property: std::string                // name, id or kind, as a rule reads it (DS-437)
      + owns many body: std::vector<Literal>
      + owns location: Location
    }

    dataclass Tabulated {                    // a table as the model answers it: the headings and, per row, a cell under each
      @requirement REQ-00154-1
      + columns: std::vector<std::string>
      + rows: std::vector<std::vector<std::string>>
      + kinds: std::vector<std::vector<std::string>>
    }

    dataclass Formula {                      // what a rule, a definition or a table says, read from its syntax
      @requirement REQ-00095-2
      + owns many ranges: std::vector<Range>
      + owns many where: std::vector<Literal>
      + many claims: std::vector<std::vector<Literal>>
      + never: bool
      + parameters: std::vector<std::string>
      + many cases: std::vector<std::vector<Literal>>
      + owns many columns: std::vector<Column>
    }

    dataclass Breach {                       // one binding that breaks a rule, its answer, where it lands
      @requirement REQ-00098-1
      + bindings: std::vector<std::pair<std::string, std::string>>
      + witness: std::vector<std::pair<std::string, std::string>>
      + owns location: Location
    }

    dataclass Finding {                      // one diagnostic of the engine, made by Metamodel::finding (DS-379)
      @requirement REQ-00001-1
      @requirement REQ-00240-1
      + code: std::string
      + severity: Severity
      + message: std::string
      + owns location: Location
      + subject: std::string                 // the entity it is about, by identity; "" for a file or a word (DS-426)
    }

    dataclass Indexed {                      // what the model keeps so a question by identity needs no pass over it (DS-171)
      @requirement REQ-00001-1
      @constraint CST-00008-2
      + from: std::map<std::string, std::vector<std::size_t>>
      + to: std::map<std::string, std::vector<std::size_t>>
      + kind: std::map<std::string, std::vector<std::size_t>>
      + members: std::map<std::string, std::set<std::string>>
      + revisions: std::map<std::string, std::set<std::string>>
      + named: std::map<std::pair<std::string, std::string>, std::set<std::string>>  // the declared classes and enums by package and simple name (DS-336)
      + parent: std::map<std::string, std::string>
      + children: std::map<std::string, std::vector<std::string>>
      + treeStale: bool
    }

    constraint CST-00008-2 {
      tags: model, index
      status: approved
      category: design
      bok: BOK-00003-1
      title: The model's relations shall be read only through its index, which answers with copies in the order the model states, holds no fact of its own and never lags a change of the model
      rationale:
        The model knows none of its readers, so it gives every one the same contract and no exception
        (Owner, 2026-11-12: a rule with exceptions is no rule). The list it keeps is private: a reader
        that held it could be left pointing at what a later relation moves, as the use case check and
        the diff did. The index is a way into the model, not a second model (DS-171): without it the
        model says the same, slower; an answer in another order would change what every drawing and
        export writes; and an index built apart would be stale halfway through a check, which changes
        the model as it goes. So only declare, relate and rename change it, and the visibility of the
        language says who may read the list: a behaviour outside the model that reaches it is
        W-NOT-VISIBLE.
    }

    rule only-the-model-keeps-the-index {
      title: what is indexed is the model's own; no class outside the module depends on it
      @requirement REQ-00001-1
      for class c in driftspec@ds
      where not c in driftspec@ds@model
      never depends(c, driftspec@ds@model::Indexed)
    }

    class Index {                            // the questions the model answers by identity, in the order it states them (DS-171)
      @requirement REQ-00001-1
      @constraint CST-00001-1
      @constraint CST-00008-2
      - refs model_: Model
      + Index(model: Model)
      + from(id: std::string) -> std::vector<Relation>
      + to(id: std::string) -> std::vector<Relation>
      + fromOfKind(id: std::string, kind: std::string) -> std::vector<Relation>   // only the relations of that kind are copied (DS-345)
      + toOfKind(id: std::string, kind: std::string) -> std::vector<Relation>
      + touching(id: std::string) -> std::vector<Relation>
      + ofKind(kind: std::string) -> std::vector<Relation>
      + ofKinds(kinds: std::vector<std::string>) -> std::vector<Relation>
      + all() -> std::vector<Relation>
      + count() -> std::size_t
      + members(scope: std::string) -> std::vector<std::string>
      + parent(id: std::string) -> std::string
      + children(id: std::string) -> std::vector<std::string>
      + revisionOf(artefact: std::string) -> std::string
      + named(package: std::string, name: std::string) -> std::vector<std::string>
      - at(table: std::map<std::string, std::vector<std::size_t>>, key: std::string) -> std::vector<Relation>
      - atOfKind(table: std::map<std::string, std::vector<std::size_t>>, key: std::string, kind: std::string) -> std::vector<Relation>
      - tree() -> void
    }

    verification VER-00119-2 {
      status: approved
      @requirement REQ-00001-1
      title: Integration tests cover the questions the model answers by identity, kept in step with every file bound and every rename
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatLeavesAndWhatReachesAnEntityComeInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.EveryRelationOfAKindAndOfSeveralKindsComesInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatTouchesAnEntityComesOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatHoldsWhatIsATreeAndAScopeNamesWhatItDeclares
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnArtefactIsFoundByAnyRevisionOrNone
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatAFileBoundLaterDeclaresIsAnsweredAtOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ARenameMovesEverythingIndexedByTheOldIdentity
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnAnswerIsACopyThatALaterChangeLeavesAsItWas
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ACopyOfTheModelAnswersForItself
    }

    verification VER-00120-3 {
      status: approved
      @constraint CST-00008-2
      title: Integration tests hold the index to the order stated, to every change of the model, to answers a later change leaves as they were and to a copy that answers for itself; tools/same.sh holds every output to main
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatLeavesAndWhatReachesAnEntityComeInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.EveryRelationOfAKindAndOfSeveralKindsComesInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatAFileBoundLaterDeclaresIsAnsweredAtOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ARenameMovesEverythingIndexedByTheOldIdentity
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnAnswerIsACopyThatALaterChangeLeavesAsItWas
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ACopyOfTheModelAnswersForItself
    }

    class Model {                            // the resolved workspace: entities by identity, relations and findings
      @requirement REQ-00001-1
      @requirement REQ-00002-1
      - refs metamodel_: Metamodel             // the language it is written in, made outside it and outliving it (DS-341); for its own work, never handed out (DS-351)
      - owns many entities_: std::map<std::string, Entity>
      - owns many relations_: std::vector<Relation>
      - owns many findings_: std::vector<Finding>
      - owns many coverage_: std::vector<Finding>
      - owns many formulas_: std::map<std::string, Formula>
      - owns many breaches_: std::map<std::string, std::vector<Breach>>
      - owns many tables_: std::map<std::string, Tabulated>
      - owns indexed_: Indexed
      + Model(metamodel: Metamodel)
      + index() -> Index
      - indexEntity(entity: Entity, enters: bool) -> void
      - indexAgain() -> void
      + declare(entity: Entity) -> Entity {   // what the model keeps comes back to be read: only annotate and refine change it
        @constraint CST-00002-1
        @requirement REQ-00164-1
      }
      + find(id: std::string) -> Entity      // read only, as declare's
      + annotate(id: std::string, key: std::string, value: std::string) -> void   // one field; nothing an entity is indexed by (DS-346)
      + refine(later: Entity) -> void        // the body of a class on an operator its header set declared: fields, flags, parameters, where
      + relate(relation: Relation) -> void
      + report(finding: Finding) -> void
      + rename(from: std::string, to: std::string) -> bool
      + entities() -> std::map<std::string, Entity>
      - relations() -> std::vector<Relation>
      + findings() -> std::vector<Finding>
      + coverage() -> std::vector<Finding> {
        @requirement REQ-00124-2
      }
      + cover() -> void {                     // what the metamodel calls coverage leaves the findings (DS-216)
        @requirement REQ-00124-2
      }
      + withdrawEchoes(broken: std::set<std::string>) -> void   // what only echoes files that do not parse or are not UTF-8 (DS-304, DS-411)
      + sortFindings() -> void {              // findings and coverage by file, line, code and message: no order of the steps (DS-382)
        @requirement REQ-00193-1
      }
      + formulas() -> std::map<std::string, Formula> {
        @requirement REQ-00095-2
      }
      + state(id: std::string, formula: Formula) -> void {
        @requirement REQ-00095-2
      }
      + breaches() -> std::map<std::string, std::vector<Breach>> {
        @requirement REQ-00098-1
      }
      + breach(rule: std::string, breach: Breach) -> void {
        @requirement REQ-00098-1
      }
      + tables() -> std::map<std::string, Tabulated> {
        @requirement REQ-00154-1
      }
      + tabulate(diagram: std::string, table: Tabulated) -> void {
        @requirement REQ-00154-1
      }
      - static behaviour(kind: Kind) -> bool
      - held(id: std::string) -> Entity      // the entity kept under an identity, to change; a defect of ds when none is
      - reportDuplicate(entity: Entity, id: std::string, first: Entity) -> void   // E-DUPLICATE-IDENTITY, said once for declare and rename
    }

    // An identity not held: the map keeps a copy of the entity and that copy comes back.
    // One held comes back as it is, or replaced by a declaration of what was only expected.
    sequence Model::declare {
      opt the identity is held {
        opt it was only expected, and this declares it / replaces-expected {
          // the expected node leaves what is indexed and the declaration enters it: its scope may be another
          -> indexEntity(existing, false)
          -> indexEntity(existing, true)
          return existing
        }
        opt this is one more reference / referenced-again {
          return existing
        }
        alt a package or a module, opened again / reopened {
        } else / duplicate {
          -> reportDuplicate(entity, entity.id, existing)
        }
        return existing
      }
      -> indexEntity(entity, true)
      return entity
    }

    sequence Model::reportDuplicate {
      self -> metamodel_.nameOf(entity.kind) -> name
      // the kind and where of the one that would take id, and where the first is written
      -> report(finding)
    }

    // A writer names what it declared or found; nothing else of the entity is in reach (DS-346).
    sequence Model::annotate {
      -> held(id) -> kept
      // the field is written, or written again
    }

    sequence Model::refine {
      -> held(later.id) -> kept
      loop each field of the later one {
        // written, or written again
      }
      // its flags join those kept; its parameters, when it writes any, replace them; it is found where it is written
    }

    // What is not yet written is no finding (DS-216): the row of its severity says whether it is kept apart; a
    // finding is born with the severity its code has in the catalogue (DS-379).
    sequence Model::cover {
      loop each finding, in the order reported {
        self -> metamodel_.severityOf(severity) -> row
        alt its severity is kept apart / covered {
          // it joins the coverage
        } else {
          // it stays a finding
        }
      }
    }

    // A file that does not parse leaves names declared nowhere and a rest that echoes the cut (DS-304); so does a
    // file that is not UTF-8, of which nothing is read (DS-411).
    sequence Model::withdrawEchoes {
      opt every file parses / whole {
        return
      }
      loop each finding {
        opt it says nothing of its own: in a broken file, or a name declared nowhere, and neither the syntax error nor the encoding error {
          // it goes
        }
      }
    }

    sequence Model::sortFindings {
      // the findings, then the coverage: by file, then by line, and on one line by code, then by message (DS-382)
    }

    sequence Model::tabulate {
      // in place of a table answered before for the same diagram
    }

    // A relation is kept where the others are, in the order stated, and what is indexed learns its
    // position by each end and by its kind: the index never lags the list.
    sequence Model::relate {
      self -> metamodel_.relationOf(relation.kind) -> declared
      opt the metamodel does not declare that kind: a defect of ds, not of the design read / undeclared {
        return
      }
      opt it is a contains / contains {
        // the tree of what holds what is built again at the next question
      }
    }

    sequence Model::indexEntity {
      local name: ArtefactName
      local scope: Scope
      self -> name.withoutRevision() -> bare
      alt it enters {
        opt it is declared, not only expected {
          // its identity is one of the declared revisions of bare
        }
      } else / leaves {
      }
      opt it is a class or an enum / named {
        // a declared one is one of the classes of its simple name in its package (DS-336)
        self -> scope.package() -> box
      }
    }

    sequence Model::indexAgain {
      loop each entity held {
        -> indexEntity(entity, true)
      }
      loop each relation held, in the order stated {
        // its position, by each end and by its kind
      }
    }

    sequence Model::index {
      local index: Index
      return index
    }

    // ---- the index: one hop, in the order the model states -------------------------------------
    sequence Index::from {
      -> at(table, id) -> found
      return found
    }

    sequence Index::to {
      -> at(table, id) -> found
      return found
    }

    // The two lists are in the order stated: merged, a relation from an entity to itself comes once.
    sequence Index::touching {
      loop while a position is left in what leaves id or in what reaches it {
        alt the next one leaves id first {
        } else / reaches {
          opt it is the same relation by both ends {
          }
        }
      }
      return found
    }

    sequence Index::ofKind {
      -> at(table, kind) -> found
      return found
    }

    sequence Index::at {
      opt the table holds nothing for the key / none {
        return found
      }
      loop each position the table holds for the key, in the order stated {
        // the relation the model keeps there
      }
      return found
    }

    // Each kind's positions are in the order stated: together, sorted, they are again.
    sequence Index::ofKinds {
      loop each kind asked {
        // its positions join the others
      }
      // sorted, they are the order stated
      return found
    }

    // A copy of the whole list: for a reader of the whole model, an export or a diff.
    sequence Index::all {
      return found
    }

    sequence Index::count {
      return held
    }

    sequence Index::members {
      opt the scope declares nothing / none {
        return found
      }
      return found
    }

    sequence Index::parent {
      -> tree()
      opt nothing holds it / top {
        return ""
      }
      return holder
    }

    sequence Index::children {
      -> tree()
      opt it holds nothing / leaf {
        return held
      }
      return held
    }

    // What holds what is a tree. The contains relations say it first, in the order stated; then the
    // scope of what none of them holds. A link that would close a cycle is left out (a model a syntax
    // error left half bound can say a holds b and b holds a), so every walk up or down ends.
    sequence Index::tree {
      opt nothing changed since it was built / fresh {
        return
      }
      loop each contains relation, in the order stated {
        opt what it holds has no holder yet and the link closes no cycle {
        }
      }
      loop each declared entity, by identity {
        opt it has no holder yet, its scope is declared and the link closes no cycle {
        }
      }
    }

    sequence Index::revisionOf {
      local name: ArtefactName
      self -> name.withoutRevision() -> bare
      opt nothing declares that artefact / undeclared {
        return ""
      }
      // the last by identity, as a pass over the entities in their order would leave it
      return declared
    }

    sequence Model::rename {
      opt the two identities are the same / same {
        return true
      }
      opt from is not held / unknown {
        return false
      }
      -> find(to) -> other
      opt another declared entity holds to / refused {
        // the finding names the kind of the entity held at from
        -> reportDuplicate(entity, to, other)
        return false
      }
      // an expected node at `to` is erased; the entity's node is taken out and put back under its new identity,
      // nothing copied (DS-346)
      loop each entity held {
        alt its identity begins with from {
          // its node taken out, to go back in under the new identity
        } else {
          opt its scope is from {
          }
        }
      }
      loop each member taken out {
      }
      loop each relation held {
        // both ends translated, by a lambda of this method
      }
      self -> metamodel_.identityFields() -> identities
      loop each entity held {
        loop each field that holds an identity {
          opt the entity carries it {
            // translated by the same lambda
          }
        }
      }
      // identities moved: what was indexed by the old ones is built again
      -> indexAgain()
      return true
    }
  }
}

diagram CL_ModelNamespace {
  kind: class
  include: driftspec@ds@model::*
  show: ownership
}
