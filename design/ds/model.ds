// LLD of the model namespace (ds::model): the resolved workspace and the
// entities it is made of. Types are written as argos's C++ reader renders them
// (std::string, std::map<std::string, Entity>), so design and code compare
// without noise; references and const are not part of the type.

package driftspec@ds {


  // What it is to depend, said once for every rule of the tool (a definition of a package is in scope
  // in its modules): through a member that owns, refers to or uses, or through a behaviour that uses.
  definition depends(a, b) {
    title: a depends on b itself, through one of its members or through its behaviours
    if a uses b
    if m in a, m owns b
    if m in a, m refs b
    if m in a, m uses b
    if m in a, s behaviour-of m, s uses b
  }

  module model {

    requirement REQ-00001-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall hold one entity per identity, letting a declaration take the place of the expected node that preceded it
      text:
        Declaring an identity the model does not hold adds it. Declaring one
        held as expected (referenced before, declared nowhere) replaces the
        expected node. A second reference to an expected node keeps the one
        node. Packages and modules reopen: a second declaration returns the
        first. Any other second declaration of one identity is reported as
        E-DUPLICATE-IDENTITY at the second location, naming the first.
      rationale:
        References arrive before declarations in any order of files; the
        model absorbs them without losing either, and still says where an
        identity was declared twice.
      tags: identity, model
    }

    requirement REQ-00002-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall rename an entity carrying its members and every relation that names it
      text:
        Renaming an identity moves the entity, every entity whose identity or
        scope begins with it (members, scenarios) and every relation end that
        names it or a member of it. Renaming onto an identity another
        declared entity holds is refused with E-DUPLICATE-IDENTITY; onto an
        expected node, the node gives way.
      rationale:
        An identity can only be known late: a behaviour is identified by its
        subject, which resolves after binding, so the checker renames it to the
        resolved identity and the model keeps everything that named it whole.
      tags: identity, behaviour
    }

    verification VER-00001-2 {
      status: approved
      @requirement REQ-00001-1
      title: Integration tests cover declaring once, a name used before its declaration ending as one declared entity, and the duplicate reported with where the first is
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.WhatIsNamedBeforeItIsDeclaredIsOneEntityAndNotExpected
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ASecondDeclarationIsReportedWithWhereTheFirstIs
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.AnEntityKeepsTheFlagsItWasDeclaredWith
    }

    verification VER-00002-2 {
      status: approved
      @requirement REQ-00002-1
      title: Integration tests cover a behaviour renamed onto its subject with its steps and relations, and the rename refused onto a declared identity
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ABehaviourWrittenInAnotherModuleIsRenamedOntoItsSubjectWithItsStepsAndRelations
        tests/integration/ds/model/test_model_of_a_design.cpp::TestModelOfADesign.ARenameOntoADeclaredIdentityIsRefused
    }

    function kindName(kind: Kind) -> std::string
    // identities, written in one place (DS-124), as three values (DS-184): packages join with @, the
    // rest with ::, a behaviour is its subject with ::sequence[/scenario] or ::state, a template
    // carries its arity, a diagram is diagram:NAME. An entity keeps its id as text; these wrap it.
    class Identity <<==>> {       // what an entity is called: p@m::C, p@m::C::run::sequence/out
      @constraint CST-00004-1
      @requirement REQ-00035-1
      - text_: std::string
      + Identity(text: std::string)
      + static ofDiagram(name: std::string) -> Identity
      + text() -> std::string
      + empty() -> bool
      + lastName() -> std::string
      + scope() -> Scope
      + asScope() -> Scope
      + isQualified() -> bool
      + isAbsolute() -> bool
      + within(outer: Identity) -> bool
      + withArity(arity: std::size_t) -> Identity {
        @requirement REQ-00029-2
      }
      + diagramName() -> std::string
      + sequence(scenario: std::string) -> Identity
      + state() -> Identity
      + withScenario(scenario: std::string) -> Identity
      + behaviour() -> Identity
      + scenario() -> std::string
      + subject() -> Identity
      + machineSubject() -> Identity
      operator ==(other: Identity) -> bool
      - kSequence: std::string      // what a sequence adds to its subject: ::sequence
      - kState: std::string         // what a state machine adds to its subject: ::state
      - kDiagram: std::string       // what a diagram's identity starts with: diagram:
    }
    class Scope <<==>> {          // where a name is written: p@, app@core@, p@m, p@m::C
      @constraint CST-00004-1
      @requirement REQ-00018-1
      - text_: std::string
      + Scope(text: std::string)
      + static inside(package: Identity) -> Scope
      + text() -> std::string
      + empty() -> bool
      + qualify(name: std::string) -> Identity
      + outer() -> Scope
      + package() -> Scope
      + box() -> Identity
      + isSystem() -> bool
      operator ==(other: Scope) -> bool
    }
    class ArtefactName <<==>> {   // a process artefact's name: REQ-00001-2
      @requirement REQ-00043-1
      - text_: std::string
      + ArtefactName(text: std::string)
      + static matches(text: std::string) -> bool
      + text() -> std::string
      + hasRevision() -> bool
      + withoutRevision() -> ArtefactName
      operator ==(other: ArtefactName) -> bool
      - static writtenWithRevision(text: std::string, stem: std::string) -> bool   // PREFIX(-PART)*-NUMBER-REVISION
      - static writtenBare(text: std::string) -> bool                              // PREFIX(-PART)*-NUMBER
      - static numberParts(text: std::string, lastDash: std::size_t) -> int         // the number parts after the letter parts, or -1 (DS-335)
    }

    // a list written in a field, taken apart and put back, in one place for every module (DS-185)
    function split(text: std::string, sep: char) -> std::vector<std::string>
    function join(items: std::vector<std::string>, sep: std::string) -> std::string

    function hasScenario(model: Model, sequence: std::string, scenario: std::string) -> bool {
      @requirement REQ-00065-1
    }

    function pathOf(model: Model, sequence: std::string, scenario: std::string, kept: std::set<std::string>) -> std::vector<Entity> {
      @requirement REQ-00065-1
    }

    // who a behaviour runs on: a method's class, a function's module, an operation's interface, or its subject;
    // the check and the state machines ask it the same
    function holderOf(model: Model, sequence: std::string) -> std::string

    // A behaviour's steps are kept as the tree they are written in (DS-172): each message and frame
    // contained by what encloses it, the sequence or a frame, in the order written; an alt holds its
    // sides as frames of kind branch. Read once here: whoever asks the order of a message, the frame
    // around a step or where an alt's else begins asks the same tree, and none rebuilds it.
    class SequenceTree {
      @requirement REQ-00065-1
      @requirement REQ-00049-3
      - refs model_: Model
      - messages_: std::vector<std::string>
      - frames_: std::vector<std::string>
      - order_: std::map<std::string, int>
      - frameOf_: std::map<std::string, std::string>
      - at_: std::map<std::string, int>
      - first_: std::map<std::string, std::string>
      + SequenceTree(model: Model, sequence: std::string)
      + model() -> Model
      + messages() -> std::vector<std::string>
      + frames() -> std::vector<std::string>
      + orderOf(message: std::string) -> int
      + frameOf(id: std::string) -> std::string
      + at(frame: std::string) -> int
      + first(frame: std::string) -> std::string
      + elseOf(frame: std::string) -> std::string
      + twoSides(frame: std::string) -> bool
      + onElse(frame: std::string, id: std::string) -> bool
      + scenario(frame: std::string, elseSide: bool) -> std::string
      + inside(frame: std::string, elseSide: bool) -> std::vector<std::string>
      - walk(holder: std::string, frame: std::string) -> void
      - static isBranch(e: Entity) -> bool
    }

    // What the sequence or a frame holds, asked of the index in the order written: a message takes the
    // next place, a frame opens before what it holds, a branch is a side of the frame around it.
    sequence SequenceTree::walk {
      self -> model_.index() -> index
      self -> index.children(holder) -> held
      loop each step held, in the order written {
        self -> model_.find(id) -> step
        alt a message / message {
          // it takes the next place; it is the first of every frame around it that has none yet
        } else {
          opt a branch / branch {
            -> walk(id, frame)
          }
          opt a loop, an alt or an opt / frame {
            -> walk(id, id)
          }
        }
      }
    }

    verification VER-00121-2 {
      status: approved
      @requirement REQ-00065-1
      @requirement REQ-00049-3
      title: Integration tests read one behaviour's tree the same for every reader: messages in the order written, the frame around each step, where a frame opens, an alt's sides and what each names
      method: test
      tests:
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.TheMessagesComeInTheOrderWrittenAtAnyDepth
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.TheFramesAreTheLoopsAltsAndOptsAndEachStepKnowsTheInnermostAroundIt
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.AFrameKnowsWhereItOpensAndWhatItHoldsFirst
        tests/integration/ds/model/test_sequence_tree_of_a_design.cpp::TestSequenceTreeOfADesign.AnAltKnowsItsElseSideAndWhatEachSideNames
    }

    verification VER-00122-1 {
      status: approved
      @requirement REQ-00001-1
      title: An integration test holds every entity to where it ends as well as where it starts
      method: test
      tests:
        tests/integration/ds/check/test_behaviour.cpp::TestBehaviour.EveryEntityKnowsWhereItEndsAsWellAsWhereItStarts
    }

    // ---- the metamodel (REQ-00066-1): the language declared once ----
    enum FieldType {                         // how to read a field's text
      @requirement REQ-00066-1
      Text, Name, Names, Type, Params, Number, Status, Patterns
    }

    enum FieldSource {                       // who sets a field: the author, the syntax, or the checker
      @requirement REQ-00066-1
      Written, Syntax, Derived
    }

    dataclass FieldSpec {                    // one field of a kind; a name ending in * is a family
      @requirement REQ-00066-1
      + name: std::string
      + type: FieldType
      + source: FieldSource
      + meaning: std::string
      + values: std::vector<std::string>
    }

    dataclass KindSpec {                     // one kind: its fields, the flags it takes, what it may be declared inside
      @requirement REQ-00066-1
      + kind: Kind
      + meaning: std::string
      + many fields: std::vector<FieldSpec>
      + flags: std::vector<std::string>
      + many parents: std::vector<Kind>
      + top: bool
      + syntax: std::string                  // how it is written (REQ-00079-1)
      + example: std::string                 // a minimal workspace that declares one and checks clean
    }

    dataclass RelationSpec {                 // one relation and the kinds it may join; no ends is any kind
      @requirement REQ-00066-1
      + kind: std::string
      + meaning: std::string
      + many from: std::vector<Kind>
      + many to: std::vector<Kind>
      + many pairs: std::vector<std::pair<Kind, Kind>>
    }

    function kinds() -> std::vector<KindSpec> {
      @requirement REQ-00066-1
      @requirement REQ-00093-1
    }
    function relations() -> std::vector<RelationSpec> {
      @requirement REQ-00066-1
      @requirement REQ-00093-1
    }
    function isArtefact(kind: Kind) -> bool {
      @requirement REQ-00043-1
    }
    function specOf(kind: Kind) -> KindSpec {
      @requirement REQ-00066-1
    }
    // the kind a word names, as kindName writes it; none when it names no kind
    function specNamed(name: std::string) -> KindSpec {
      @requirement REQ-00066-1
    }
    function fieldOf(kind: Kind, key: std::string) -> FieldSpec {
      @requirement REQ-00066-1
    }
    function relationOf(kind: std::string) -> RelationSpec {
      @requirement REQ-00066-1
    }
    function joins(relation: RelationSpec, from: Kind, to: Kind) -> bool {
      @requirement REQ-00066-1
    }
    function fieldTypeName(type: FieldType) -> std::string {
      @requirement REQ-00066-1
    }
    function fieldSourceName(source: FieldSource) -> std::string {
      @requirement REQ-00066-1
    }

    // the metamodel's tables (DS-340): the catalogue of finding codes, the annotations that mean something
    // and how each kind is written. The binder, the checker and the kinds read them here; the manual
    // derives its pages from them and the metamodel never reads the manual
    dataclass CodeSpec {                     // a finding code: what it means and what to do about it
      @requirement REQ-00079-1
      + code: std::string
      + severity: std::string
      + meaning: std::string
      + fix: std::string
    }

    dataclass AnnotationSpec {               // an annotation that means something, and the relation it makes
      @requirement REQ-00079-1
      @requirement REQ-00088-1
      + name: std::string
      + relation: std::string
      + meaning: std::string
      + onVerification: std::string
      + target: Kind
    }

    function codes() -> std::vector<CodeSpec> {
      @requirement REQ-00079-1
    }
    function codeOf(code: std::string) -> CodeSpec {
      @requirement REQ-00079-1
    }
    function annotations() -> std::vector<AnnotationSpec> {
      @requirement REQ-00079-1
    }
    function annotationOf(word: std::string) -> AnnotationSpec {
      @requirement REQ-00088-1
    }
    function syntaxOf(kind: Kind) -> std::string {
      @requirement REQ-00079-1
    }
    function exampleOf(kind: Kind) -> std::string {
      @requirement REQ-00079-1
    }

    // ---- the manual ds embeds (REQ-00079-1): written from the metamodel, held to the engine ----
    requirement REQ-00079-1 {
      status: approved
      @refines SREQ-00014-1
      title: The metamodel shall carry the manual of the language: how each kind is written with a minimal example that checks clean, the catalogue of finding codes, the annotations and the commands
      text:
        Every kind of the metamodel says how it is written and gives an
        example: a workspace of its own that declares one and checks with no
        finding. The catalogue holds every code the engine reports, with its
        severity, what it means and what to do, and nothing the engine does
        not report. The annotations that mean something name the relation
        they make; the commands say what each exit code means. manualPage
        renders the index, a kind, a code, the commands, the annotations or
        the codes, and nothing for a topic it does not know.
      rationale:
        Owner, 2026-11-06 (DS-79): as argos embeds its body of knowledge, ds
        embeds its manual; generated from the metamodel and tested against
        the engine, it is the one place the language is described.
      tags: manual, metamodel, language
    }

    requirement REQ-00163-1 {
      status: approved
      @refines SREQ-00018-2
      title: The tool shall say its version, the same in the command, in Python and in the model it exports
      text:
        The version is kept once, in pyproject.toml, and written into the engine when it is built.
        ds --version prints it (ds 0.1.0) and exits 0; driftspec.__version__ is it; ds export carries it
        as version, beside format, the shape of the exported document, so a reader can tell a
        document it does not know.
      rationale:
        Owner, 2026-11-18 (DS-278), audit for the first release: a tool with users says which
        version answered, and a document read by another tool says what shape it has.
      tags: cli, export, release
    }

    verification VER-00179-1 {
      status: approved
      @requirement REQ-00163-1
      title: Integration tests confirm driftspec.__version__ is written as major.minor.patch and is the version the export of the engine carries
      method: test
      tests:
        tests/integration/python/test_workspace.py::TestWorkspace::test_the_package_says_the_version_of_its_engine
    }

    requirement REQ-00160-1 {
      status: approved
      @refines SREQ-00014-1
      title: The manual shall carry its guides, written as Markdown in the repository and embedded when ds is built, the same text in the terminal and in a page
      text:
        doc/manual/NN-topic.md is a guide: intent, structure, behaviour, logic, using. The build
        embeds each as it is, in the order of its number, and its topic is its name. ds manual
        <topic> prints it, the index lists the guides before the kinds, and the engine for a page
        answers it to a request for the manual (with no topic, the guides and every topic), so a
        site draws the text the terminal prints. An example of a guide is a block marked ds: a
        workspace of its own that checks clean, or, marked ds wrong, one with the finding it is
        there to show.
      rationale:
        Owner, 2026-11-17 (DS-272): one source for the manual in both places. The prose is
        Markdown; what the engine uses to work (the kinds, the codes, the commands) stays in the
        metamodel and its pages are generated. Four articles by perspective and one on using the
        tool, in the style of PlantUML's site.
      tags: manual, guides
    }

    verification VER-00176-1 {
      status: approved
      @requirement REQ-00160-1
      title: Integration tests confirm every guide starts with its title and is the page of its topic, that each of its examples checks clean or has the finding it is marked for, and that the engine for a page answers the manual
      method: test
      tests:
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryExampleOfAGuideChecksCleanAndOneMarkedWrongHasItsFinding
        tests/integration/ds/api/test_browser_hola.cpp::TestBrowserOverHola.TheManualIsAnsweredByItsOwnRequest
    }

    verification VER-00088-1 {
      status: approved
      @requirement REQ-00079-1
      title: Integration tests confirm every kind is written down with an example that checks clean, the catalogue is exactly the codes the engine reports, and every topic has a page
      method: test
      tests:
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryKindIsWrittenDownAndItsExampleChecksClean
        tests/integration/ds/model/test_manual.cpp::TestManual.TheCatalogueHoldsExactlyTheCodesTheEngineReports
        tests/integration/ds/model/test_manual.cpp::TestManual.EveryTopicHasAPageAndAnUnknownOneHasNone
    }

    dataclass CommandSpec {                  // a command: how it is invoked, what it does, what each exit code says
      @requirement REQ-00079-1
      + name: std::string
      + synopsis: std::string
      + does: std::string
      + exits: std::vector<std::pair<int, std::string>>
    }

    function commands() -> std::vector<CommandSpec> {
      @requirement REQ-00079-1
    }
    function commandOf(name: std::string) -> CommandSpec {
      @requirement REQ-00079-1
    }
    function manualPage(topic: std::string) -> std::string {
      @requirement REQ-00079-1
    }
    function manualTopics() -> std::vector<std::string> {
      @requirement REQ-00079-1
    }
    function manualGuides() -> std::vector<std::pair<std::string, std::string>> {
      @requirement REQ-00160-1
    }
    function version() -> std::string {
      @requirement REQ-00163-1
    }

    enum Kind {
      @requirement REQ-00001-1
      Package, Module, Requirement, Verification, Interface, Operation, View, Constraint, Class, Enum, Function, Method, Attribute, Operator, Sequence, Message, Frame, State, Diagram, UseCase, Outcome, Rule, Definition
    }

    dataclass Location {                     // where something was read from: the file, where it starts and where it ends, 1-based
      @requirement REQ-00001-1
      + file: std::string
      + line: int
      + column: int
      + endLine: int                         // the place right after its last character; 0 when not known (DS-172)
      + endColumn: int
    }

    dataclass Param {                        // one parameter as the binder read it: name and type (a template's: name and bound)
      @requirement REQ-00066-1
      + name: std::string
      + type: std::string
    }

    dataclass Entity {                       // one declared (or expected, R6) entity of the workspace
      @requirement REQ-00001-1
      + kind: Kind
      + id: std::string
      + name: std::string
      + scope: std::string
      + fields: std::map<std::string, std::string>
      + flags: std::vector<std::string>
      + many params: std::vector<Param>
      + args: std::vector<std::string>
      + owns location: Location
      + expected: bool
      + has(flag: std::string) -> bool
      + field(key: std::string) -> std::string
    }

    sequence Entity::has {
      loop each flag held {
        opt it is the flag asked {
          return true
        }
      }
      return false
    }

    dataclass Relation {                     // a typed relation between two identities
      @requirement REQ-00001-1
      + kind: std::string
      + from: std::string
      + to: std::string
      + owns location: Location
      + multiplicity: std::string
      + change: std::string
    }

    enum LiteralForm {                       // how a literal of a rule reads (DS-94)
      @requirement REQ-00095-2
      Relation, Kind, In, Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual, Call, Arg
    }

    dataclass Term {                         // a variable (a bare name), an entity (a qualified name) or a value, as written
      @requirement REQ-00095-2
      + text: std::string
      + variable: bool
      + value: bool
      + field: std::string
    }

    dataclass Literal {                      // one literal of a rule or a definition
      @requirement REQ-00095-2
      + form: LiteralForm
      + negated: bool
      + name: std::string
      + owns many terms: std::vector<Term>
      + owns location: Location
    }

    dataclass Range {                        // what a range of for binds: every entity of a kind, optionally inside a box
      @requirement REQ-00095-2
      + kind: std::string
      + variable: std::string
      + scope: std::string
      + owns location: Location
    }

    dataclass Column {                       // one column of a table: a field of the row, what is related to it, or a yes/no
      @requirement REQ-00154-1
      + name: std::string
      + form: std::string
      + variable: std::string
      + field: std::string
      + owns many body: std::vector<Literal>
      + owns location: Location
    }

    dataclass Tabulated {                    // a table as the model answers it: the headings and, per row, a cell under each
      @requirement REQ-00154-1
      + columns: std::vector<std::string>
      + rows: std::vector<std::vector<std::string>>
      + kinds: std::vector<std::vector<std::string>>
    }

    dataclass Formula {                      // what a rule, a definition or a table says, read from its syntax
      @requirement REQ-00095-2
      + owns many ranges: std::vector<Range>
      + owns many where: std::vector<Literal>
      + many claims: std::vector<std::vector<Literal>>
      + never: bool
      + parameters: std::vector<std::string>
      + many cases: std::vector<std::vector<Literal>>
      + owns many columns: std::vector<Column>
    }

    dataclass Breach {                       // one binding that breaks a rule, its answer, where it lands
      @requirement REQ-00098-1
      + bindings: std::vector<std::pair<std::string, std::string>>
      + witness: std::vector<std::pair<std::string, std::string>>
      + owns location: Location
    }

    dataclass Finding {                      // one diagnostic of the engine
      @requirement REQ-00001-1
      + code: std::string
      + severity: std::string
      + message: std::string
      + owns location: Location
    }

    dataclass Indexed {                      // what the model keeps so a question by identity needs no pass over it (DS-171)
      @requirement REQ-00001-1
      @constraint CST-00008-2
      + from: std::map<std::string, std::vector<std::size_t>>
      + to: std::map<std::string, std::vector<std::size_t>>
      + kind: std::map<std::string, std::vector<std::size_t>>
      + members: std::map<std::string, std::set<std::string>>
      + revisions: std::map<std::string, std::set<std::string>>
      + named: std::map<std::pair<std::string, std::string>, std::set<std::string>>  // the declared classes and enums by package and simple name (DS-336)
      + parent: std::map<std::string, std::string>
      + children: std::map<std::string, std::vector<std::string>>
      + treeStale: bool
    }

    constraint CST-00008-2 {
      tags: model, index
      status: approved
      category: design
      bok: BOK-00003-1
      title: The model's relations shall be read only through its index, which answers with copies in the order the model states, holds no fact of its own and never lags a change of the model
      rationale:
        The model knows none of its readers, so it gives every one the same contract and no exception
        (Owner, 2026-11-12: a rule with exceptions is no rule). The list it keeps is private: a reader
        that held it could be left pointing at what a later relation moves, as the use case check and
        the diff did. The index is a way into the model, not a second model (DS-171): without it the
        model says the same, slower; an answer in another order would change what every drawing and
        export writes; and an index built apart would be stale halfway through a check, which changes
        the model as it goes. So only declare, relate and rename change it, and the visibility of the
        language says who may read the list: a behaviour outside the model that reaches it is
        W-NOT-VISIBLE.
    }

    rule only-the-model-keeps-the-index {
      title: what is indexed is the model's own; no class outside the module depends on it
      @requirement REQ-00001-1
      for class c in driftspec@ds
      where not c in driftspec@ds@model
      never depends(c, driftspec@ds@model::Indexed)
    }

    class Index {                            // the questions the model answers by identity, in the order it states them (DS-171)
      @requirement REQ-00001-1
      @constraint CST-00001-1
      @constraint CST-00008-2
      - refs model_: Model
      + Index(model: Model)
      + from(id: std::string) -> std::vector<Relation>
      + to(id: std::string) -> std::vector<Relation>
      + touching(id: std::string) -> std::vector<Relation>
      + ofKind(kind: std::string) -> std::vector<Relation>
      + ofKinds(kinds: std::vector<std::string>) -> std::vector<Relation>
      + all() -> std::vector<Relation>
      + count() -> std::size_t
      + members(scope: std::string) -> std::vector<std::string>
      + parent(id: std::string) -> std::string
      + children(id: std::string) -> std::vector<std::string>
      + revisionOf(artefact: std::string) -> std::string
      + named(package: std::string, name: std::string) -> std::vector<std::string>
      - at(table: std::map<std::string, std::vector<std::size_t>>, key: std::string) -> std::vector<Relation>
      - tree() -> void
    }

    verification VER-00119-2 {
      status: approved
      @requirement REQ-00001-1
      title: Integration tests cover the questions the model answers by identity, kept in step with every file bound and every rename
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatLeavesAndWhatReachesAnEntityComeInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.EveryRelationOfAKindAndOfSeveralKindsComesInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatTouchesAnEntityComesOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatHoldsWhatIsATreeAndAScopeNamesWhatItDeclares
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnArtefactIsFoundByAnyRevisionOrNone
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatAFileBoundLaterDeclaresIsAnsweredAtOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ARenameMovesEverythingIndexedByTheOldIdentity
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnAnswerIsACopyThatALaterChangeLeavesAsItWas
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ACopyOfTheModelAnswersForItself
    }

    verification VER-00120-3 {
      status: approved
      @constraint CST-00008-2
      title: Integration tests hold the index to the order stated, to every change of the model, to answers a later change leaves as they were and to a copy that answers for itself; tools/same.sh holds every output to main
      method: test
      tests:
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatLeavesAndWhatReachesAnEntityComeInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.EveryRelationOfAKindAndOfSeveralKindsComesInTheOrderStated
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.WhatAFileBoundLaterDeclaresIsAnsweredAtOnce
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ARenameMovesEverythingIndexedByTheOldIdentity
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.AnAnswerIsACopyThatALaterChangeLeavesAsItWas
        tests/integration/ds/model/test_model_of_a_design.cpp::TestIndexOfADesign.ACopyOfTheModelAnswersForItself
    }

    class Model {                            // the resolved workspace: entities by identity, relations and findings
      @requirement REQ-00001-1
      @requirement REQ-00002-1
      - owns many entities_: std::map<std::string, Entity>
      - owns many relations_: std::vector<Relation>
      - owns many findings_: std::vector<Finding>
      - owns many coverage_: std::vector<Finding>
      - owns many formulas_: std::map<std::string, Formula>
      - owns many breaches_: std::map<std::string, std::vector<Breach>>
      - owns many tables_: std::map<std::string, Tabulated>
      - owns indexed_: Indexed
      + index() -> Index
      - indexEntity(entity: Entity, enters: bool) -> void
      - indexAgain() -> void
      + declare(entity: Entity) -> Entity {
        @constraint CST-00002-1
        @requirement REQ-00164-1
      }
      + find(id: std::string) -> Entity
      + relate(relation: Relation) -> void
      + report(finding: Finding) -> void
      + rename(from: std::string, to: std::string) -> bool
      + entities() -> std::map<std::string, Entity>
      - relations() -> std::vector<Relation>
      + findings() -> std::vector<Finding>
      + coverage() -> std::vector<Finding> {
        @requirement REQ-00124-1
      }
      + formulas() -> std::map<std::string, Formula> {
        @requirement REQ-00095-2
      }
      + state(id: std::string, formula: Formula) -> void {
        @requirement REQ-00095-2
      }
      + breaches() -> std::map<std::string, std::vector<Breach>> {
        @requirement REQ-00098-1
      }
      + breach(rule: std::string, breach: Breach) -> void {
        @requirement REQ-00098-1
      }
      + tables() -> std::map<std::string, Tabulated> {
        @requirement REQ-00154-1
      }
      - static behaviour(kind: Kind) -> bool
    }

    // An identity not held: the map keeps a copy of the entity and that copy comes back.
    // One held comes back as it is, or replaced by a declaration of what was only expected.
    sequence Model::declare {
      opt the identity is held {
        opt it was only expected, and this declares it / replaces-expected {
          // the expected node leaves what is indexed and the declaration enters it: its scope may be another
          -> indexEntity(existing, false)
          -> indexEntity(existing, true)
          return existing
        }
        opt this is one more reference / referenced-again {
          return existing
        }
        alt a package or a module, opened again / reopened {
        } else / duplicate {
          -> kindName(entity.kind) -> name
          -> report(finding)
        }
        return existing
      }
      -> indexEntity(entity, true)
      return entity
    }

    // A relation is kept where the others are, in the order stated, and what is indexed learns its
    // position by each end and by its kind: the index never lags the list.
    sequence Model::relate {
      -> relationOf(relation.kind) -> declared
      opt the metamodel does not declare that kind: a defect of ds, not of the design read / undeclared {
        return
      }
      opt it is a contains / contains {
        // the tree of what holds what is built again at the next question
      }
    }

    sequence Model::indexEntity {
      local name: ArtefactName
      local scope: Scope
      self -> name.withoutRevision() -> bare
      alt it enters {
        opt it is declared, not only expected {
          // its identity is one of the declared revisions of bare
        }
      } else / leaves {
      }
      opt it is a class or an enum / named {
        // a declared one is one of the classes of its simple name in its package (DS-336)
        self -> scope.package() -> box
      }
    }

    sequence Model::indexAgain {
      loop each entity held {
        -> indexEntity(entity, true)
      }
      loop each relation held, in the order stated {
        // its position, by each end and by its kind
      }
    }

    sequence Model::index {
      local index: Index
      return index
    }

    // ---- the index: one hop, in the order the model states -------------------------------------
    sequence Index::from {
      -> at(table, id) -> found
      return found
    }

    sequence Index::to {
      -> at(table, id) -> found
      return found
    }

    // The two lists are in the order stated: merged, a relation from an entity to itself comes once.
    sequence Index::touching {
      loop while a position is left in what leaves id or in what reaches it {
        alt the next one leaves id first {
        } else / reaches {
          opt it is the same relation by both ends {
          }
        }
      }
      return found
    }

    sequence Index::ofKind {
      -> at(table, kind) -> found
      return found
    }

    sequence Index::at {
      opt the table holds nothing for the key / none {
        return found
      }
      loop each position the table holds for the key, in the order stated {
        // the relation the model keeps there
      }
      return found
    }

    // Each kind's positions are in the order stated: together, sorted, they are again.
    sequence Index::ofKinds {
      loop each kind asked {
        // its positions join the others
      }
      // sorted, they are the order stated
      return found
    }

    // A copy of the whole list: for a reader of the whole model, an export or a diff.
    sequence Index::all {
      return found
    }

    sequence Index::count {
      return held
    }

    sequence Index::members {
      opt the scope declares nothing / none {
        return found
      }
      return found
    }

    sequence Index::parent {
      -> tree()
      opt nothing holds it / top {
        return ""
      }
      return holder
    }

    sequence Index::children {
      -> tree()
      opt it holds nothing / leaf {
        return held
      }
      return held
    }

    // What holds what is a tree. The contains relations say it first, in the order stated; then the
    // scope of what none of them holds. A link that would close a cycle is left out (a model a syntax
    // error left half bound can say a holds b and b holds a), so every walk up or down ends.
    sequence Index::tree {
      opt nothing changed since it was built / fresh {
        return
      }
      loop each contains relation, in the order stated {
        opt what it holds has no holder yet and the link closes no cycle {
        }
      }
      loop each declared entity, by identity {
        opt it has no holder yet, its scope is declared and the link closes no cycle {
        }
      }
    }

    sequence Index::revisionOf {
      local name: ArtefactName
      self -> name.withoutRevision() -> bare
      opt nothing declares that artefact / undeclared {
        return ""
      }
      // the last by identity, as a pass over the entities in their order would leave it
      return declared
    }

    sequence Model::rename {
      opt the two identities are the same / same {
        return true
      }
      opt from is not held / unknown {
        return false
      }
      -> find(to) -> other
      opt another declared entity holds to / refused {
        // the finding names the kind of the entity held at from
        -> kindName(kind) -> name
        -> report(finding)
        return false
      }
      // an expected node at `to` is erased; the entity moves under its new identity
      loop each entity held {
        alt its identity begins with from {
          // taken out, to go back in under the new identity
        } else {
          opt its scope is from {
          }
        }
      }
      loop each member taken out {
      }
      loop each relation held {
        // both ends translated, by a lambda of this method
      }
      loop each entity held {
        loop each field {
          opt named expands or subject-of {
            // translated by the same lambda
          }
        }
      }
      // identities moved: what was indexed by the old ones is built again
      -> indexAgain()
      return true
    }

    // ---- what the package's own functions and classes share (DS-332): internal, declared in
    // src/ds/model/Detail.hpp and in no header under include/; its constants are written in the code alone
    - module detail {
      // the scope outside an identity or a scope
      function outerOf(text: std::string) -> std::string {
        @requirement REQ-00035-1
      }
      // the value of a field of an entity; "" when it does not carry it
      function fieldIn(e: Entity, key: std::string) -> std::string {
        @requirement REQ-00065-1
      }

      // the frames of one behaviour, read from its tree, and for each what its two sides name
      class Branches {
        @requirement REQ-00065-1
        + refs tree: SequenceTree
        + names(f: Entity, elseSide: bool) -> std::set<std::string>
        + decide(f: Entity, scenario: std::string) -> Way
      }

      // how the metamodel is built
      function writtenField(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec {
        @requirement REQ-00066-1
      }
      function syntax(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec {
        @requirement REQ-00066-1
      }
      function derived(name: std::string, type: FieldType, meaning: std::string) -> FieldSpec {
        @requirement REQ-00066-1
      }
      function closed(name: std::string, type: FieldType, meaning: std::string, values: std::vector<std::string>) -> FieldSpec {
        @requirement REQ-00066-1
      }
      function artefact() -> std::vector<FieldSpec> {
        @requirement REQ-00066-1
      }
      function plus(base: std::vector<FieldSpec>, more: std::vector<FieldSpec>) -> std::vector<FieldSpec> {
        @requirement REQ-00066-1
      }
      function describe(kinds: std::vector<KindSpec>) -> std::vector<KindSpec> {
        @requirement REQ-00066-1
      }
      function build() -> std::vector<KindSpec> {
        @requirement REQ-00066-1
      }
      function rel(kind: std::string, meaning: std::string, from: std::vector<Kind>, to: std::vector<Kind>) -> RelationSpec {
        @requirement REQ-00066-1
      }
      function buildRelations() -> std::vector<RelationSpec> {
        @requirement REQ-00066-1
      }
      function among(kinds: std::vector<Kind>, kind: Kind) -> bool {
        @requirement REQ-00066-1
      }
      function matches(name: std::string, key: std::string) -> bool {
        @requirement REQ-00066-1
      }
      function containment() -> RelationSpec {
        @requirement REQ-00066-1
      }
      // the metamodel's tables: how each kind is written, the catalogue of codes
      function writtenForms() -> std::map<Kind, std::pair<std::string, std::string>> {
        @requirement REQ-00079-1
      }
      function buildCodes() -> std::vector<CodeSpec> {
        @requirement REQ-00079-1
      }
      // how the manual is written
      function indent(text: std::string, by: std::string) -> std::string {
        @requirement REQ-00079-1
      }
      function pad(text: std::string, width: std::size_t) -> std::string {
        @requirement REQ-00079-1
      }
      function names(kinds: std::vector<Kind>) -> std::string {
        @requirement REQ-00079-1
      }
      function kindPage(k: KindSpec) -> std::string {
        @requirement REQ-00079-1
      }
      function indexPage() -> std::string {
        @requirement REQ-00079-1
      }
      function grammarPage() -> std::string {
        @requirement REQ-00079-1
      }
    }
  }
}

