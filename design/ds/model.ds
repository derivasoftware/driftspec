// LLD of the model namespace (ds::model): the resolved workspace and the
// entities it is made of. Types are written as argos's C++ reader renders them
// (std::string, std::map<std::string, Entity>), so design and code compare
// without noise; references and const are not part of the type.

package driftspec@ds {

  extern module std {                        // the standard library, names only (R11)
    class string
    class map<K, V>
    class vector<T>
  }

  module model {

    requirement REQ-00001-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall hold one entity per identity, letting a declaration take the place of the expected node that preceded it
      text:
        Declaring an identity the model does not hold adds it. Declaring one
        held as expected (referenced before, declared nowhere) replaces the
        expected node. A second reference to an expected node keeps the one
        node. Packages and modules reopen: a second declaration returns the
        first. Any other second declaration of one identity is reported as
        E-DUPLICATE-IDENTITY at the second location, naming the first.
      rationale:
        References arrive before declarations in any order of files; the
        model absorbs them without losing either, and still says where an
        identity was declared twice.
      tags: identity, model
    }

    requirement REQ-00002-1 {
      status: approved
      @refines SREQ-00001-1
      title: The model shall rename an entity carrying its members and every relation that names it
      text:
        Renaming an identity moves the entity, every entity whose identity or
        scope begins with it (members, scenarios) and every relation end that
        names it or a member of it. Renaming onto an identity another
        declared entity holds is refused with E-DUPLICATE-IDENTITY; onto an
        expected node, the node gives way.
      rationale:
        An identity can only be known late: a behaviour is identified by its
        subject, which resolves after binding, so the checker renames it to the
        resolved identity and the model keeps everything that named it whole.
      tags: identity, behaviour
    }

    verification VER-00001-1 {
      status: approved
      @requirement REQ-00001-1
      title: Unit tests cover declaring once, merging the expected node and reporting the duplicate
      method: test
      tests:
        tests/unit/ds/model/test_model.cpp::TestModel.ADeclarationTakesThePlaceOfTheExpectedNode
        tests/unit/ds/model/test_model.cpp::TestModel.ASecondDeclarationIsReportedExceptForReopenableScopes
        tests/unit/ds/model/test_model.cpp::TestEntity.HasAFlagItWasDeclaredWith
    }

    verification VER-00002-1 {
      status: approved
      @requirement REQ-00002-1
      title: Unit tests cover renaming with members and relations, and the refused rename
      method: test
      tests:
        tests/unit/ds/model/test_model.cpp::TestModel.ARenameCarriesMembersAndRelations
        tests/unit/ds/model/test_model.cpp::TestModel.ARenameOntoADeclaredIdentityIsRefused
    }

    function kindName(kind: Kind) -> std::string
    function isSystemScope(scope: std::string) -> bool
    function lastName(id: std::string) -> std::string

    function hasScenario(model: Model, sequence: std::string, scenario: std::string) -> bool {
      @requirement REQ-00065-1
    }

    function pathOf(model: Model, sequence: std::string, scenario: std::string, kept: std::set<std::string>) -> std::vector<Entity> {
      @requirement REQ-00065-1
    }

    // ---- the metamodel (REQ-00066-1): the language declared once ----
    enum FieldType {                         // how to read a field's text
      @requirement REQ-00066-1
      Text, Name, Names, Type, Params, Number, Status, Patterns
    }

    enum FieldSource {                       // who sets a field: the author, the syntax, or the checker
      @requirement REQ-00066-1
      Written, Syntax, Derived
    }

    dataclass FieldSpec {                    // one field of a kind; a name ending in * is a family
      @requirement REQ-00066-1
      + name: std::string
      + type: FieldType
      + source: FieldSource
      + meaning: std::string
    }

    dataclass KindSpec {                     // one kind: its fields, the flags it takes, what it may be declared inside
      @requirement REQ-00066-1
      + kind: Kind
      + meaning: std::string
      + fields: std::vector<FieldSpec>
      + flags: std::vector<std::string>
      + parents: std::vector<Kind>
      + top: bool
    }

    dataclass RelationSpec {                 // one relation and the kinds it may join; no ends is any kind
      @requirement REQ-00066-1
      + kind: std::string
      + meaning: std::string
      + from: std::vector<Kind>
      + to: std::vector<Kind>
    }

    function kinds() -> std::vector<KindSpec> {
      @requirement REQ-00066-1
    }
    function relations() -> std::vector<RelationSpec> {
      @requirement REQ-00066-1
    }
    function specOf(kind: Kind) -> KindSpec {
      @requirement REQ-00066-1
    }
    function fieldOf(kind: Kind, key: std::string) -> FieldSpec {
      @requirement REQ-00066-1
    }
    function relationOf(kind: std::string) -> RelationSpec {
      @requirement REQ-00066-1
    }
    function joins(relation: RelationSpec, from: Kind, to: Kind) -> bool {
      @requirement REQ-00066-1
    }
    function fieldTypeName(type: FieldType) -> std::string {
      @requirement REQ-00066-1
    }
    function fieldSourceName(source: FieldSource) -> std::string {
      @requirement REQ-00066-1
    }

    enum Kind {
      @requirement REQ-00001-1
      Package, Module, Requirement, Verification, Interface, Operation, View, Constraint, Class, Enum, Function, Method, Attribute, Operator, Sequence, Message, Frame, State, Diagram
    }

    dataclass Location {                     // where something was read from: file, 1-based line and column
      @requirement REQ-00001-1
      + file: std::string
      + line: int
      + column: int
    }

    dataclass Param {                        // one parameter as the binder read it: name and type (a template's: name and bound)
      @requirement REQ-00066-1
      + name: std::string
      + type: std::string
    }

    dataclass Entity {                       // one declared (or expected, R6) entity of the workspace
      @requirement REQ-00001-1
      + kind: Kind
      + id: std::string
      + name: std::string
      + scope: std::string
      + fields: std::map<std::string, std::string>
      + flags: std::vector<std::string>
      + params: std::vector<Param>
      + args: std::vector<std::string>
      + owns location: Location
      + expected: bool
      + has(flag: std::string) -> bool
    }

    sequence Entity::has {
      loop each flag held {
        opt it is the flag asked {
          return true
        }
      }
      return false
    }

    dataclass Relation {                     // a typed relation between two identities
      @requirement REQ-00001-1
      + kind: std::string
      + from: std::string
      + to: std::string
      + owns location: Location
      + multiplicity: std::string
    }

    dataclass Finding {                      // one diagnostic of the engine
      @requirement REQ-00001-1
      + code: std::string
      + severity: std::string
      + message: std::string
      + owns location: Location
    }

    class Model {                            // the resolved workspace: entities by identity, relations and findings
      @requirement REQ-00001-1
      @requirement REQ-00002-1
      - owns entities_: std::map<std::string, Entity>
      - owns relations_: std::vector<Relation>
      - owns findings_: std::vector<Finding>
      + declare(entity: Entity) -> Entity {
        @constraint CST-00002-1
      }
      + find(id: std::string) -> Entity
      + relate(relation: Relation) -> void
      + report(finding: Finding) -> void
      + rename(from: std::string, to: std::string) -> bool
      + entities() -> std::map<std::string, Entity>
      + relations() -> std::vector<Relation>
      + findings() -> std::vector<Finding>
    }

    // An identity not held: the map keeps a copy of the entity and that copy comes back.
    // One held comes back as it is, or replaced by a declaration of what was only expected.
    sequence Model::declare {
      opt the identity is held {
        opt it was only expected, and this declares it / replaces-expected {
          return existing
        }
        opt this is one more reference / referenced-again {
          return existing
        }
        alt a package or a module, opened again / reopened {
        } else / duplicate {
          -> kindName(entity.kind) -> name
          -> report(finding)
        }
        return existing
      }
      return entity
    }

    sequence Model::rename {
      opt the two identities are the same / same {
        return true
      }
      opt from is not held / unknown {
        return false
      }
      -> find(to) -> other
      opt another declared entity holds to / refused {
        // the finding names the kind of the entity held at from
        -> kindName(kind) -> name
        -> report(finding)
        return false
      }
      // an expected node at `to` is erased; the entity moves under its new identity
      loop each entity held {
        alt its identity begins with from {
          // taken out, to go back in under the new identity
        } else {
          opt its scope is from {
          }
        }
      }
      loop each member taken out {
      }
      loop each relation held {
        // both ends translated, by a lambda of this method
      }
      loop each entity held {
        loop each field {
          opt named expands or subject-of {
            // translated by the same lambda
          }
        }
      }
      return true
    }
  }
}

diagram CL_ModelNamespace {
  kind: class
  include: driftspec@ds@model::*
  show: ownership
}
