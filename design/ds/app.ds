// The ds command: CLI11 reads the command line (each command a subcommand with its
// options, the help generated), main loads the workspace and hands it to whoever answers.
// One scenario of main per thing it can end in; the rest of the tool knows nothing of
// a command line.

package driftspec@ds {
  extern module CLI {                        // CLI11, the command-line parser (names only, R11)
    class App
  }

  module app {
    function main(argv: list<string>) -> int

    - function load(dir: path) -> model::Model
    - function loadWorkspace(dir: path, model: model::Model) -> bool
    - function titleOf(dir: string) -> string
    - function check(dir: path) -> int
    - function coupling(model: model::Model) -> int
    - function drawDocument(doc: render::IrDocument, how: string, width: int) -> none
    - function printLayout(doc: string, width: int) -> none
    - function diagramId(name: string) -> string
    - function drawingFlags(cmd: CLI::App, how: string, withLayout: bool) -> none
    - function isDirectory(path: string) -> bool
    - function checkout(rev: string, path: string) -> string

    sequence loadWorkspace {
      -> isDirectory(dir) -> found
      opt the path is not a directory / missing {
        return false
      }
      -> load(dir) -> loaded
      return true
    }

    sequence check {
      local model: model::Model
      -> loadWorkspace(dir, model) -> found
      return 0
    }

    sequence load {
      local parser: parse::Parser
      local binder: bind::Binder
      local checker: check::Checker
      -> parser.parseDirectory(dir) -> files
      loop each file {
        -> binder.bind(file)
      }
      -> checker.run(binder)
    }

    sequence main / check {
      -> check(argv) -> code
      return code
    }

    sequence main / check-errors {
      local model: model::Model
      -> loadWorkspace(argv, model) -> found
      return 1
    }

    sequence main / bad-usage {               // CLI11 says what is wrong with the command line
      return 2
    }

    sequence main / export {
      local model: model::Model
      local exporter: exporter::JsonExport
      -> loadWorkspace(argv, model) -> found
      -> exporter.render(model, pretty) -> json
      return 0
    }

    sequence main / scene {
      local model: model::Model
      local scene: scene::Scene
      -> loadWorkspace(argv, model) -> found
      -> scene.render(pretty) -> json
      return 0
    }

    sequence main / view {
      local model: model::Model
      local scene: scene::Scene
      -> loadWorkspace(argv, model) -> found
      -> titleOf(argv) -> title
      -> scene.page(title, css) -> page
      opt --embed: the page inside an iframe / embedded {
        -> scene.frame(page, title, height) -> frame
      }
      return 0
    }

    sequence main / no-workspace {
      -> isDirectory(argv) -> found
      return 1
    }

    sequence main / render {
      local model: model::Model
      local ir: render::IrExport
      local svg: render::Svg
      -> loadWorkspace(argv, model) -> found
      -> ir.render(name, pretty) -> document
      -> svg.render(document, width) -> drawing
      return 0
    }

    sequence main / no-diagram {
      local model: model::Model
      local ir: render::IrExport
      -> loadWorkspace(argv, model) -> found
      -> ir.render(name, pretty) / no-diagram -> document
      return 1
    }

    sequence main / draw {
      local svg: render::Svg
      -> svg.render(document, width) -> drawing
      return 0
    }

    sequence main / no-document {
      return 1
    }

    sequence main / coupling {
      local model: model::Model
      -> loadWorkspace(argv, model) -> found
      return 0
    }

    sequence main / diff {
      local differ: diff::Diff
      -> load(argv) -> before
      -> load(argv) -> after
      -> differ.compare(before, after) -> result
      -> differ.report(result) -> text
      return 0
    }

    sequence main / diff-findings {
      local differ: diff::Diff
      -> load(argv) -> before
      -> load(argv) -> after
      -> differ.compare(before, after) -> result
      return 1
    }

    sequence main / query {
      local model: model::Model
      local query: query::Query
      -> loadWorkspace(argv, model) -> found
      -> query.ask(question, subject) -> answers
      -> query.text(answers) -> text
      return 0
    }

    sequence main / unknown-question {
      local model: model::Model
      local query: query::Query
      -> loadWorkspace(argv, model) -> found
      -> query.ask(question, subject) -> answers
      return 1
    }
  }
}
