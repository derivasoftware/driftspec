// LLD of the service namespace (ds::service, DS-406, DS-407): the use cases of DriftSpec (design/usecases.ds), each
// a class realising a small interface whose operation realises its UC, so the trace runs from the use case to the
// class. A use case is given the loaded model, a request and the sink its door lends it; it computes its document as
// a local value, describes it into the sink through DescriptionFactory and says how it ended, in one of the outcomes
// its UC declares. It knows no door: the command line, the engine, the browser and the Python face translate its
// outcome and its failures, each to its own convention (DS-409). UseCaseFactory is the one place naming them.

package driftspec@ds {

  requirement REQ-00261-1 {
    status: draft
    @refines REQ-00107-2
    title: The engine shall serve each use case of DriftSpec behind one interface, made by one factory, describing its document into the sink its door lends and ending in an outcome its use case declares
    text:
      A use case of design/usecases.ds is one class: check-design, see-design, ask-model, hand-model,
      learn-language and edit-design. Each realises a small interface whose operation realises its UC, and all
      are IUseCase: name(), needs(bound model, request), the check steps it reads, and run(model, request,
      lent sink) -> Outcome, which fails BadRequest for a request that is not its own and NotImplemented for what
      the sink's technology cannot write. A use case describes its document into the sink it is lent, through
      DescriptionFactory, and returns one of the outcomes its UC declares; the outcomes that happen before a model
      exists (bad-usage, no-workspace) are the door's. UseCaseFactory is the one place naming a use case. What a
      use case describes is byte for byte what its door writes of the same document.
    rationale: Owner, 2026-11-24 (DS-406, the service layer; sketch proposal-service v4); code-62, 2026-11-25 (DS-407, D1 needs reads the bound model and the request, D2 the door's outcomes stay at the door, D3 the text forms join after DS-399).
    tags: service, use-cases
    verification VER-00281-1 {
      status: draft
      title: Integration tests confirm each use case describes what its door writes byte for byte, ends in an outcome its use case declares, and is made by the factory alone
      method: test
      tests:
        tests/integration/ds/service/test_use_cases.cpp::TestUseCases.EachUseCaseDescribesWhatItsDoorWritesByteForByte
        tests/integration/ds/service/test_use_cases.cpp::TestUseCases.EachUseCaseEndsInAnOutcomeItsUseCaseDeclares
        tests/integration/ds/service/test_use_cases.cpp::TestUseCases.TheFactoryNamesEveryUseCaseAndAnyOtherNameIsNotImplemented
        tests/integration/ds/service/test_use_cases.cpp::TestUseCases.ARequestThatIsNotTheUseCasesIsABadRequestAndADrawingTakesOnlyWhatItReads
    }
  }

  interface check-design {
    kind: library
    transport: in process, linked
    operation report(model: model::Model) -> check::Report : UC-00001-1 {
      @requirement REQ-00261-1
    }
  }

  interface see-design {
    kind: library
    transport: in process, linked
    operation viewer(model: model::Model) -> scene::SceneDocument : UC-00002-1 {
      @requirement REQ-00261-1
    }
  }

  interface ask-model {
    kind: library
    transport: in process, linked
    operation ask(model: model::Model, question: std::string, subject: std::string) -> std::vector<query::Answer> : UC-00004-1 {
      @requirement REQ-00261-1
    }
  }

  interface hand-model {
    kind: library
    transport: in process, linked
    operation run(model: model::Model, request: service::Request, sink: emit::ISink) -> service::Outcome fails BadRequest, emit::NotImplemented : UC-00005-1 {
      @requirement REQ-00261-1
    }
  }

  interface learn-language {
    kind: library
    transport: in process, linked
    operation page(topic: std::string) -> std::string : UC-00006-1 {
      @requirement REQ-00261-1
    }
  }

  interface edit-design {
    kind: library
    transport: in process, linked
    operation expectedAt(text: std::string, line: int, column: int) -> std::vector<std::string> : UC-00007-1 {
      @requirement REQ-00261-1
    }
  }

  // how each operation is handled: by its use case's class. The outcomes that happen before a model exists (bad-usage,
  // no-workspace) are the door's (DS-407, D2) and are handled where the door is (DS-409)
  sequence check-design::report {
    local checks: service::CheckDesign
    -> checks.report(model) -> report
    return report
  }

  sequence check-design::report / errors {          // an error is among the findings: the report says where
    local checks: service::CheckDesign
    -> checks.report(model) -> report
    return report
  }

  sequence see-design::viewer {
    local sees: service::SeeDesign
    -> sees.viewer(model) -> document
    return document
  }

  sequence see-design::viewer / no-diagram {         // the diagram named is not in the workspace: nothing is drawn
    local sees: service::SeeDesign
    -> sees.diagram(model, name) -> ir
    return ir
  }

  sequence ask-model::ask {
    local asks: service::AskModel
    -> asks.ask(model, question, subject) -> answers
    return answers
  }

  sequence ask-model::ask / unknown-question {       // the question, or its subject, is not one the model answers
    local asks: service::AskModel
    -> asks.ask(model, question, subject) -> answers
    return answers
  }

  sequence hand-model::run {
    local hands: service::HandModel
    -> hands.run(model, request, sink) -> outcome
    return outcome
  }

  sequence learn-language::page {
    local teaches: service::LearnLanguage
    -> teaches.page(topic) -> text
    return text
  }

  sequence learn-language::page / no-topic {         // no such page: the topics are listed by the door
    local teaches: service::LearnLanguage
    -> teaches.page(topic) -> text
    return text
  }

  sequence edit-design::expectedAt {
    local edits: service::EditDesign
    -> edits.expectedAt(text, line, column) -> words
    return words
  }

  module service {
    @requirement REQ-00261-1

    // what a use case is asked: its arguments by name (the diagram, the question, the topic, the line...)
    class Request {
      @requirement REQ-00261-1
      + arguments: std::map<std::string, std::string>
      + get(name: std::string) -> std::string fails BadRequest
      + getOr(name: std::string, fallback: std::string) -> std::string
    }

    // how a use case ended: one of the outcomes its UC declares
    dataclass Outcome {
      @requirement REQ-00261-1
      + name: std::string
    }

    // a request that is not the use case's: an argument it needs and is not given, or one it cannot read
    class BadRequest : std::invalid_argument {
      @requirement REQ-00261-1
    }

    // THE COMMON INTERFACE: what the doors and the workspace ask of any use case, by name
    class IUseCase {
      @requirement REQ-00261-1
      + ~IUseCase()
      + abstract name() -> std::string
      + abstract needs(bound: model::Model, request: Request) -> check::Selection
      + abstract run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class CheckDesign : IUseCase {                      // UC-00001-1: check a design
      @interface check-design
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      + CheckDesign(metamodel: model::Metamodel)
      + report(model: model::Model) -> check::Report
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class SeeDesign : IUseCase {                        // UC-00002-1: see the design, the viewer's scene or a diagram drawn
      @interface see-design
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      - owns theme_: theme::Theme                       // the style its drawings are measured and drawn in (DS-393)
      + SeeDesign(metamodel: model::Metamodel)
      + viewer(model: model::Model) -> scene::SceneDocument
      + diagram(model: model::Model, name: std::string) -> render::IrText
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class AskModel : IUseCase {                         // UC-00004-1: ask the model
      @interface ask-model
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      + AskModel(metamodel: model::Metamodel)
      + ask(model: model::Model, question: std::string, subject: std::string) -> std::vector<query::Answer>
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class HandModel : IUseCase {                        // UC-00005-1: hand the model to another tool
      @interface hand-model
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      + HandModel(metamodel: model::Metamodel)
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class LearnLanguage : IUseCase {                    // UC-00006-1: learn the language; it reads no design
      @interface learn-language
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      + LearnLanguage(metamodel: model::Metamodel)
      + page(topic: std::string) -> std::string
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    class EditDesign : IUseCase {                       // UC-00007-1: what the editor asks the engine; it reads no model
      @interface edit-design
      @requirement REQ-00261-1
      + expectedAt(text: std::string, line: int, column: int) -> std::vector<std::string>
      + name() -> std::string
      + needs(bound: model::Model, request: Request) -> check::Selection
      + run(model: model::Model, request: Request, sink: emit::ISink) -> Outcome fails BadRequest, emit::NotImplemented
    }

    // THE ONE PLACE THAT NAMES THE USE CASES: a door, or the workspace, asks for one by its name
    class UseCaseFactory {                  // made over the metamodel and aggregated by what asks it (DS-408)
      @requirement REQ-00261-1
      - refs metamodel_: model::Metamodel
      + UseCaseFactory(metamodel: model::Metamodel)
      + of(name: std::string) -> std::unique_ptr<IUseCase> fails emit::NotImplemented
      + metamodel() -> model::Metamodel
      + static names() -> std::vector<std::string>
    }
  }
}
