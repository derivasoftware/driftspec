// LLD of the bind namespace (ds::bind): a parsed tree walked into the model.
// The binder declares every entity under its qualified identity and records
// every reference, message and event as written; it resolves nothing
// (SREQ-00001-1). Resolution and checking are the checker's.

package driftspec@ds {

  module bind {

    dataclass Reference {                    // a name as written, with where and for which relation
      @requirement REQ-00023-1
      + from: std::string
      + target: std::string
      + scope: std::string
      + relation: std::string
      + expectedKind: model::Kind
      + owns location: model::Location
      + multiplicity: std::string
      + args: std::vector<std::string>
    }

    dataclass Message {                      // a message of a behaviour, checked later against the static context
      @requirement REQ-00037-1
      + sequence: std::string
      + message: std::string
      + to: std::string
      + op: std::string
      + argc: int
      + owns location: model::Location
      + returns: bool
    }

    dataclass Event {                        // an event or action of a state machine, checked later as an operation
      @requirement REQ-00040-1
      + state: std::string
      + entity: std::string
      + scope: std::string
      + event: std::string
      + action: bool
      + owns location: model::Location
    }

    dataclass TypeUse {                      // what a type expression named: an entity, a template parameter, or text
      @requirement REQ-00028-1
      + classLike: bool
      + parameter: bool
      + text: std::string
    }

    class Binder {                           // realises the language rule by rule: each member names its requirement
      @requirement REQ-00053-1
      @requirement REQ-00021-1
      - refs model_: model::Model
      - owns references_: std::vector<Reference>
      - owns messages_: std::vector<Message>
      - owns events_: std::vector<Event>
      + Binder(model: model::Model)
      + bind(file: parse::ParsedFile) -> void
      + references() -> std::vector<Reference>
      + messages() -> std::vector<Message>
      + events() -> std::vector<Event>
      - visit(file: parse::ParsedFile, node: TSNode, scope: std::string, owner: std::string) -> void {
        @requirement REQ-00013-1
        @requirement REQ-00014-1
        @requirement REQ-00020-2
        @requirement REQ-00015-1
        @requirement REQ-00022-1
        @requirement REQ-00017-1
      }
      - bindFields(file: parse::ParsedFile, node: TSNode, entity: model::Entity) -> void {
        @requirement REQ-00032-1
      }
      - bindAnnotations(file: parse::ParsedFile, node: TSNode, from: std::string, scope: std::string) -> void {
        @requirement REQ-00044-1
      }
      - bindArtefact(file: parse::ParsedFile, node: TSNode, scope: std::string, owner: std::string) -> void {
        @requirement REQ-00018-1
        @requirement REQ-00042-1
        @requirement REQ-00045-1
      }
      - bindClass(file: parse::ParsedFile, node: TSNode, scope: std::string, owner: std::string) -> void {
        @requirement REQ-00025-1
        @requirement REQ-00029-1
        @requirement REQ-00033-1
      }
      - extend(file: parse::ParsedFile, node: TSNode, id: std::string, kind: model::Kind, name: std::string, scope: std::string, loc: model::Location) -> void {
        @constraint CST-00003-1
      }
      - bindMember(file: parse::ParsedFile, node: TSNode, cls: model::Entity, params: std::vector<std::string>, operators: std::set<std::string>) -> void {
        @requirement REQ-00026-1
      }
      - bindFunction(file: parse::ParsedFile, node: TSNode, scope: std::string, owner: std::string) -> void {
        @requirement REQ-00054-1
      }
      - bindSignature(file: parse::ParsedFile, node: TSNode, entity: model::Entity, scope: std::string, params: std::vector<std::string>) -> void {
        @requirement REQ-00028-1
        @requirement REQ-00055-1
      }
      - bindMemberBody(file: parse::ParsedFile, member: TSNode, entity: model::Entity, scope: std::string) -> void {
        @requirement REQ-00032-1
      }
      - bindSequence(file: parse::ParsedFile, node: TSNode, scope: std::string, owner: std::string) -> void {
        @requirement REQ-00034-1
        @requirement REQ-00035-1
        @requirement REQ-00036-2
      }
      - bindSteps(file: parse::ParsedFile, node: TSNode, sequence: model::Entity, frame: std::string, order: int, frames: int) -> void {
        @requirement REQ-00037-1
      }
      - bindType(file: parse::ParsedFile, type: TSNode, scope: std::string, from: std::string, relation: std::string, multiplicity: std::string, params: std::vector<std::string>, location: model::Location) -> TypeUse {
        @requirement REQ-00028-1
        @requirement REQ-00024-2
      }
      - declareOperator(cls: model::Entity, symbol: std::string, location: model::Location) -> void {
        @requirement REQ-00030-1
      }
      - locationOf(file: parse::ParsedFile, node: TSNode) -> model::Location
      - qualify(scope: std::string, name: std::string) -> std::string {
        @constraint CST-00004-1
      }
    }

    // Takes the root of the tree and walks it with no scope and no owner. Where the root
    // comes from cannot be said: the free C function ts_tree_root_node of tree_sitter,
    // called on file.tree.get(), a chained call.
    sequence Binder::bind {
      local root: TSNode
      -> visit(file, root, "", "")
    }

    // Where binding happens: each child of the node is declared by its kind, related to
    // its owner, and walked in turn. Reading names off the tree (fieldText, child, is) are
    // free utilities of the implementation, and the identities are built by expressions,
    // so e appears with its fields already set. A package is walked with its id plus @
    // as scope, an expression: that call and its annotations are not told here.
    sequence Binder::visit {
      loop each named child of the node {
        local c: TSNode
        local e: model::Entity
        local relation: model::Relation
        -> locationOf(file, c) -> loc
        opt a package {
          -> bindFields(file, c, e)
          self -> model_.declare(e) -> declared
          opt it has an owner {
            self -> model_.relate(relation)
          }
        }
        opt a module {
          -> qualify(scope, e.name) -> id
          opt it has an owner {
            self -> model_.find(owner) -> ownerEntity
          }
          self -> model_.declare(e) -> declared
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> visit(file, c, declared.id, declared.id)
        }
        opt a requirement, a verification or a constraint {
          -> bindArtefact(file, c, scope, owner)
        }
        opt an interface, with its operations {
          -> qualify(scope, e.name) -> id
          -> bindFields(file, c, e)
          self -> model_.declare(e)
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> bindAnnotations(file, c, e.id, scope)
          loop each operation {
            local op: TSNode
            local o: model::Entity
            -> locationOf(file, op)
            -> bindFields(file, op, o)
            self -> model_.declare(o)
            self -> model_.relate(relation)
            -> bindAnnotations(file, op, o.id, scope)
          }
        }
        opt a class {
          -> bindClass(file, c, scope, owner)
        }
        opt a function {
          -> bindFunction(file, c, scope, owner)
        }
        opt an enum, with its values {
          -> qualify(scope, e.name) -> id
          self -> model_.declare(e)
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> bindAnnotations(file, c, e.id, scope)
        }
        opt a sequence {
          -> bindSequence(file, c, scope, owner)
        }
        opt a state machine: its events and actions are kept for the checker {
          local entityName: std::string
          -> qualify(scope, entityName)
          -> bindFields(file, c, e)
          self -> model_.declare(e)
          -> bindAnnotations(file, c, e.id, scope)
          loop each view and transition {
            local t: TSNode
            local v: model::Entity
            opt the initial state or a transition, set on the state entity {
              self -> model_.find(e.id)
            }
            opt a view {
              -> bindFields(file, t, v)
              self -> model_.declare(v)
              self -> model_.relate(relation)
              -> bindAnnotations(file, t, v.id, scope)
            }
          }
        }
        opt a diagram {
          -> bindFields(file, c, e)
          self -> model_.declare(e)
        }
      }
    }
  }
}

diagram CL_BindNamespace {
  kind: class
  include: driftspec@ds@bind::*
  show: ownership
  hide: methods
}
