// LLD of the bind namespace (ds::bind): a parsed tree walked into the model.
// The binder declares every entity under its qualified identity and records
// every reference, message and event as written; it resolves nothing
// (SREQ-00001-1). Resolution and checking are the checker's.

package driftspec@ds {

  module bind {

    dataclass Reference {                    // a name as written, with where and for which relation
      @requirement REQ-00023-1
      + from: std::string
      + target: std::string
      + scope: std::string
      + relation: std::string
      + expectedKind: model::Kind
      + owns location: model::Location
      + multiplicity: std::string
      + args: std::vector<std::string>
      + soft: bool                           // read out of a type, a base or a bound: text when nobody designs it (DS-18)
    }

    // one name a type's text holds, with the arguments of a bracket right after it (DS-18)
    dataclass TypeToken {
      @requirement REQ-00028-2
      + name: std::string
      + args: std::vector<std::string>
    }

    // the names of a type as the code writes it, left to right: no name of any language is known (DS-18);
    // a dot qualifies as :: does, so lsp.Location is read lsp::Location (DS-319)
    function scanTypeTokens(text: std::string) -> std::vector<TypeToken> {
      @requirement REQ-00028-2
    }

    dataclass Message {                      // a message of a behaviour, checked later against the static context
      @requirement REQ-00037-1
      + sequence: std::string
      + message: std::string
      + to: std::string
      + op: std::string
      + argc: int
      + owns location: model::Location
      + returns: bool
    }

    dataclass Event {                        // an event or action of a state machine, checked later as an operation
      @requirement REQ-00040-1
      + state: std::string
      + entity: std::string
      + scope: std::string
      + event: std::string
      + action: bool
      + owns location: model::Location
    }

    class Binder {                           // realises the language rule by rule: each member names its requirement
      @requirement REQ-00053-2
      @requirement REQ-00021-1
      @requirement REQ-00110-1
      @requirement REQ-00112-1
      - refs model_: model::Model
      - refs metamodel_: model::Metamodel     // what an annotation means, and which ones it knows (DS-341)
      + Binder(model: model::Model, metamodel: model::Metamodel)
      + bind(file: parse::ParsedFile) -> void
      - visit(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00013-1
        @requirement REQ-00014-1
        @requirement REQ-00020-2
        @requirement REQ-00015-1
        @requirement REQ-00022-1
        @requirement REQ-00017-2
      }
      - bindFields(ctx: BindContext, node: TSNode, out_entity: model::Entity) -> void {
        @requirement REQ-00032-2
      }
      - bindAnnotations(ctx: BindContext, node: TSNode, from: std::string, scope: std::string) -> void {
        @requirement REQ-00044-1
        @requirement REQ-00114-1
      }
      - bindFormula(ctx: BindContext, node: TSNode, out_entity: model::Entity) -> void {
        @requirement REQ-00095-2
      }
      - bindArtefact(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00125-1
        @requirement REQ-00018-1
        @requirement REQ-00042-1
        @requirement REQ-00045-1
      }
      - bindUseCase(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00081-1
      }
      - bindClass(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00025-1
        @requirement REQ-00029-2
        @requirement REQ-00033-1
      }
      - extend(ctx: BindContext, node: TSNode, id: std::string, kind: model::Kind, name: std::string, scope: std::string, loc: model::Location) -> void {
        @constraint CST-00003-2
      }
      - bindMember(ctx: BindContext, node: TSNode, cls: model::Entity, params: std::vector<std::string>, operators: std::set<std::string>) -> void {
        @requirement REQ-00170-1
        @requirement REQ-00026-2
        @requirement REQ-00101-1                 // ~Name() flagged destructor
      }
      - bindFunction(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00054-2
      }
      - bindSignature(ctx: BindContext, node: TSNode, out_entity: model::Entity, scope: std::string, params: std::vector<std::string>) -> void {
        @requirement REQ-00028-2
        @requirement REQ-00055-2
        @requirement REQ-00112-1
      }
      - bindMemberBody(ctx: BindContext, member: TSNode, out_entity: model::Entity, scope: std::string) -> void {
        @requirement REQ-00032-2
      }
      - bindSequence(ctx: BindContext, node: TSNode) -> void {
        @requirement REQ-00034-1
        @requirement REQ-00035-1
        @requirement REQ-00036-2
      }
      - bindSteps(ctx: BindContext, node: TSNode, sequence: model::Entity, holder: std::string, out_order: int, out_frames: int) -> void {
        @requirement REQ-00037-1
        @requirement REQ-00110-1
      }
      - branch(ctx: BindContext, at: TSNode, sequence: std::string, alt: std::string, side: int, scenario: std::string) -> std::string {
        @requirement REQ-00037-1
      }
      - bindType(ctx: BindContext, type: TSNode, scope: std::string, from: std::string, relation: std::string, multiplicity: std::string, params: std::vector<std::string>, location: model::Location) -> std::string {
        @requirement REQ-00028-2
        @requirement REQ-00024-3
      }
      - declareOperator(ctx: BindContext, cls: model::Entity, symbol: std::string, location: model::Location) -> void {
        @requirement REQ-00030-1
      }
      - owns notes_: Notes
      + notes() -> Notes
    }

    // Reads the file's tree and walks it from its root with no scope and no owner, writing through one context into
    // the model and the notes (DS-354).
    sequence Binder::bind {
      local reader: parse::TreeReader
      local ctx: BindContext
      self -> reader.root() -> root
      -> visit(ctx, root)
    }

    // What an annotation means is the metamodel's (DS-341): the relation its word makes, and for a word it
    // does not know a link that refers, said with the annotations it knows. The reference is linked later.
    sequence Binder::bindAnnotations {
      loop each annotation written in the node {
        self -> metamodel_.annotationOf(word) -> spec
        opt the language gives the word no meaning {
          self -> metamodel_.knownAnnotations() -> known
          self -> model_.report(finding)
        }
      }
    }

    // Where binding happens: each child of the node is declared by its kind, related to
    // its owner, and walked in turn. Reading names off the tree (fieldText, child, is) are
    // free utilities of the implementation, and the identities are built by expressions,
    // so e appears with its fields already set. A package is walked with its id plus @
    // as scope, an expression: that call and its annotations are not told here.
    sequence Binder::visit {
      loop each named child of the node {
        local c: TSNode
        local e: model::Entity
        local relation: model::Relation
        local at: model::Scope
        self -> ctx.locationOf(c) -> loc
        opt a package {
          -> bindFields(ctx, c, e)
          self -> model_.declare(e) -> declared
          loop each field written {
            // a reopened package takes what this declaration writes (DS-346)
            self -> model_.annotate(declared.id, key, value)
          }
          opt it has an owner {
            self -> model_.relate(relation)
          }
        }
        opt a module {
          self -> at.qualify(e.name) -> id
          opt it has an owner {
            self -> model_.find(owner) -> ownerEntity
          }
          self -> model_.declare(e) -> declared
          loop each field written {
            opt it adds to what the module already says / reopened {
              // two values that differ are both kept
              self -> model_.annotate(declared.id, key, value)
            }
          }
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> visit(ctx, c)
        }
        opt a requirement, a verification or a constraint {
          -> bindArtefact(ctx, c)
        }
        opt a use case, with its outcomes {
          -> bindUseCase(ctx, c)
        }
        opt an interface, with its operations {
          self -> at.qualify(e.name) -> id
          -> bindFields(ctx, c, e)
          self -> model_.declare(e)
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> bindAnnotations(ctx, c, e.id, scope)
          loop each operation {
            local op: TSNode
            local o: model::Entity
            self -> ctx.locationOf(op)
            -> bindFields(ctx, op, o)
            self -> model_.declare(o)
            self -> model_.relate(relation)
            -> bindAnnotations(ctx, op, o.id, scope)
          }
        }
        opt a class {
          -> bindClass(ctx, c)
        }
        opt a function {
          -> bindFunction(ctx, c)
        }
        opt an enum, with its values {
          self -> at.qualify(e.name) -> id
          self -> model_.declare(e)
          opt it has an owner {
            self -> model_.relate(relation)
          }
          -> bindAnnotations(ctx, c, e.id, scope)
        }
        opt a sequence {
          -> bindSequence(ctx, c)
        }
        opt a state machine: its events and actions are kept for the checker {
          local entityName: std::string
          self -> at.qualify(entityName) -> id
          -> bindFields(ctx, c, e)
          self -> model_.declare(e)
          -> bindAnnotations(ctx, c, e.id, scope)
          loop each view and transition {
            local t: TSNode
            local v: model::Entity
            opt the initial state, a state rule or a transition, written on the state entity {
              self -> model_.annotate(e.id, key, value)
            }
            opt a view {
              -> bindFields(ctx, t, v)
              self -> model_.declare(v)
              self -> model_.relate(relation)
              -> bindAnnotations(ctx, t, v.id, scope)
            }
          }
        }
        opt a diagram {
          -> bindFields(ctx, c, e)
          self -> model_.declare(e)
        }
      }
    }

    class BindContext {                      // what binding one node is given; the only place it writes (DS-354)
      @requirement REQ-00053-2
      + refs model: model::Model
      + refs notes: Notes
      + refs reader: parse::TreeReader
      + scope: std::string
      + owner: std::string
      + within(inner: std::string, holder: std::string) -> BindContext
      + locationOf(node: TSNode) -> model::Location
    }
    class Notes {                            // what binding leaves for the checker, the only thing it reads of bind (DS-354)
      @requirement REQ-00053-2
      + owns references: std::vector<Reference>
      + owns messages: std::vector<Message>
      + owns events: std::vector<Event>
    }
  }
}

diagram CL_BindNamespace {
  kind: class
  include: driftspec@ds@bind::*
  show: ownership
  hide: methods
}
