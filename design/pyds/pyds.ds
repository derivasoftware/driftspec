// The Python face of DriftSpec (SREQ-00015-1, SREQ-00016-1; DS-84, DS-85): the engine as a library
// Python depends on, and a language server on it. Written in Python except the extension, which is
// C++ over the limited CPython API: the box says python, the module native says cpp.
//
//   python   a library in process: load, check, render, page, expected_at
//   editor   the language server protocol over stdio: what an editor asks while a design is typed

package driftspec@pyds {

  extern module typing {                     // what Python and the libraries the server stands on name
    class object
  }
  extern module pygls {
    class LanguageServer
  }
  extern module lsprotocol {
    class Position
    class Location
    class Hover
    class CompletionList
    class SymbolInformation
    class Diagnostic
  }

  requirement REQ-00086-1 {
    status: approved
    @refines SREQ-00015-1
    title: The Python face shall read a workspace into a typed model through one native module, every Python from 3.10 on
    text:
      pyds.load(source) takes a directory or a mapping of path to text and gives a Model:
      the entities by identity, the relations, the findings and the metamodel, read from the
      JSON pyds._native returns. check, render, page and expected_at do the same for their
      answers. The native module is built against the limited API (abi3).
    tags: python, api
    verification VER-00095-1 {
      status: approved
      title: Integration tests confirm pyds loads a directory or the texts an editor holds into a typed model, checks it, draws and pages it
      method: test
      tests:
        tests/integration/python/test_pyds.py::TestLoad::test_a_directory_loads_into_a_typed_model
        tests/integration/python/test_pyds.py::TestLoad::test_the_texts_an_editor_holds_load_as_a_workspace
        tests/integration/python/test_pyds.py::TestLoad::test_a_path_that_is_no_directory_is_refused
        tests/integration/python/test_pyds.py::TestCheck::test_a_clean_workspace_reports_no_error
        tests/integration/python/test_pyds.py::TestCheck::test_a_syntax_error_is_a_finding_where_it_is
        tests/integration/python/test_pyds.py::TestDrawing::test_a_diagram_draws_as_text_and_none_draws_nothing
        tests/integration/python/test_pyds.py::TestDrawing::test_the_viewer_opens_framed_where_it_is_asked
        tests/integration/python/test_pyds.py::TestDrawing::test_what_the_grammar_takes_in_a_module
    }
  }

  requirement REQ-00087-1 {
    status: approved
    @refines SREQ-00016-1
    title: The language server shall check the design a file belongs to on every change, and lead from a name to what it is
    text:
      The design a file belongs to is its folder and the folders above that hold .ds files of
      their own, never past the project root; each design keeps its model and its diagnostics.
      Definition, references, hover, completion and symbols answer from that model; draw and
      view show the diagram or the entity under the cursor, or the declaration the cursor is in.
    tags: lsp, editor
    verification VER-00096-1 {
      status: approved
      title: Integration tests confirm the language server, driven over stdio, diagnoses a buffer as it is typed, leads a name to its declaration and draws it, and keeps each design apart
      method: test
      tests:
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_buffer_typed_wrong_is_diagnosed_and_cleared_when_right
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_name_leads_to_its_declaration_and_draws
        tests/integration/python/test_lsp.py::TestLanguageServer::test_a_file_belongs_to_its_own_design_only
    }
  }

  // ---- the library: what a Python caller sees -------------------------------------------------
  interface python {
    kind: library
    transport: in process
    encoding: python objects
    @requirement REQ-00086-1

    operation check(source: pyds::Source) -> pyds::Report : UC-00001-1
    operation load(source: pyds::Source) -> pyds::Model : UC-00005-1
    operation render(source: pyds::Source, diagram: string) -> string : UC-00002-1
  }

  sequence python::check {
    -> pyds::check(source) -> report
    return report
  }

  sequence python::check / errors {            // the report counts errors: nothing is raised
    -> pyds::check(source) -> report
    return report
  }

  sequence python::check / bad-usage {         // neither a directory nor texts: NotADirectoryError
    -> pyds::read(source) -> files
    return none
  }

  sequence python::load {
    -> pyds::load(source) -> model
    return model
  }

  sequence python::load / no-workspace {
    -> pyds::read(source) -> files
    return none
  }

  sequence python::render {
    -> pyds::render(source, diagram, format, width) -> drawing
    return drawing
  }

  sequence python::render / no-diagram {       // "" for a diagram the workspace does not have
    -> pyds::render(source, diagram, format, width) -> drawing
    return drawing
  }

  sequence python::render / no-workspace {
    -> pyds::read(source) -> files
    return none
  }

  // ---- the live session: a workspace followed as it is written --------------------------------
  requirement REQ-00089-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall reload the model on every change of the workspace's files and give every page that follows it the new state, with the identities that changed
    text:
      pyds.live watches the .ds files of a workspace; a change loads the model again, compares each
      identity with the version before (an entity and the relations it makes), and pushes the state
      (version, changed, removed, findings, counts, history) to every page following the session as
      server-sent events. A member that changed marks its class too. A half-written file does not
      stop the session: the error is sent and the next save is read.
    tags: live, viewer
    verification VER-00098-1 {
      status: approved
      title: Integration tests confirm a change to a file reaches the state with the identities that changed, and a page following the session receives the model
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_a_change_to_a_file_reaches_the_state_with_what_changed
        tests/integration/python/test_live.py::TestLiveSession::test_a_reader_receives_the_model_and_is_taken_where_it_is_asked
    }
  }

  requirement REQ-00090-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall carry focus, notes, highlights and the reader's selection both ways, through a contract with a version, and keep notes and highlights beside the workspace across restarts
    text:
      The contract (GET /contract) names the routes a client calls and the events it receives, and
      the state says the contract's version, so a browser page and an editor's panel rely on the
      same thing. Focus takes the reader to an identity; a note is a bubble on an identity, replaced
      by the next one on it and removed by an empty one; a highlight lights identities with a tone;
      clear removes them. The reader's selection is posted back. Notes and highlights are kept in
      <workspace>/.driftspec/live.json, never in the design.
    rationale: Found using the spike (DS-102): notes in memory were lost on every restart.
    tags: live, viewer
    verification VER-00099-1 {
      status: approved
      title: Integration tests confirm focus, notes, highlights and the selection go both ways through the contract, and notes and highlights survive a restart outside the design
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_readers_selection_reaches_the_one_who_writes
        tests/integration/python/test_live.py::TestLiveSession::test_notes_and_highlights_survive_a_restart_and_stay_out_of_the_design
        tests/integration/python/test_live.py::TestLiveSession::test_a_note_with_no_text_removes_it_and_clear_removes_them_all
        tests/integration/python/test_live.py::TestLiveSession::test_the_contract_says_its_routes_and_its_version
    }
  }

  requirement REQ-00091-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall offer its contract to an agent as MCP tools over stdio
    text:
      python -m pyds.live mcp serves live_open (starting the session if none serves the workspace),
      live_focus, live_note, live_highlight, live_clear, live_selection and live_state; each answers
      through the session's routes, so the agent and a page see the same state.
    tags: live, mcp
    verification VER-00100-1 {
      status: approved
      title: Integration tests confirm an agent calls the contract as MCP tools and an unknown tool is an error
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_an_agent_calls_the_contract_as_mcp_tools
    }
  }

  requirement REQ-00100-1 {
    status: approved
    @refines SREQ-00017-1
    title: The live session shall list every rule and definition as written, whether it holds, what breaks it and where, and light a rule in the viewer when the reader picks it
    text:
      The state carries the rules: each one's clauses as written, its title, what it answers to,
      where it is written, its breaches with their bindings, answer and location, and the problems
      the checker found in it. The page shows them in a panel of the logic perspective, filtered by
      all, broken, or those that speak of what the reader selected; picking one asks the viewer to
      light it.
    rationale: Owner, 2026-11-09 (DS-108): without seeing the rules they cannot be understood.
    tags: live, viewer, logic
    verification VER-00109-1 {
      status: approved
      title: Integration tests confirm the state carries the rules as written with what breaks them and where
      method: test
      tests:
        tests/integration/python/test_live.py::TestLiveSession::test_the_rules_reach_the_state_as_written_with_what_breaks_them
    }
  }

  interface session {                          // what a page or an editor's panel relies on
    kind: http
    transport: http, server-sent events on localhost
    encoding: json
    @requirement REQ-00090-1

    operation state() -> object
    operation events() -> object
    operation focus(id: string, also: list<string>) -> object
    operation note(id: string, text: string, tone: string) -> object
    operation highlight(ids: list<string>, tone: string, add: bool) -> object
    operation clear(what: string) -> object
    operation selection(id: string, label: string) -> object
  }

  sequence session::state {
    local s: live::Live
    -> s.state() -> state
    return state
  }

  sequence session::events {
    local s: live::Live
    -> s.state() -> state
    -> s.broadcast(event, data)
    return state
  }

  sequence session::focus {
    local s: live::Live
    -> s.focus(id, also) -> listeners
    return listeners
  }

  sequence session::note {
    local s: live::Live
    -> s.note(id, text, tone, frame) -> notes
    return notes
  }

  sequence session::highlight {
    local s: live::Live
    -> s.highlight(ids, tone, add, frame) -> highlights
    return highlights
  }

  sequence session::clear {
    local s: live::Live
    -> s.clear(what)
    return none
  }

  sequence session::selection {
    local s: live::Live
    -> s.select(id, label)
    return none
  }

  interface agent {                            // the same contract, for an agent
    kind: mcp
    transport: stdio, json-rpc
    @requirement REQ-00091-1

    operation live_open(workspace: string) -> string
    operation live_focus(id: string) -> object
    operation live_note(id: string, text: string) -> object
    operation live_highlight(ids: list<string>) -> object
    operation live_clear(what: string) -> object
    operation live_selection() -> object
    operation live_state() -> object
  }

  sequence agent::live_open {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_focus {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_note {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_highlight {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_clear {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_selection {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  sequence agent::live_state {
    -> live::tool(port, name, args, opened) -> answer
    return answer
  }

  // ---- the language server: what an editor asks -----------------------------------------------
  interface editor {
    kind: lsp
    transport: stdio, json-rpc
    @requirement REQ-00087-1

    operation did_change(uri: string, text: string) -> none : UC-00007-1
    operation definition(uri: string, line: int, character: int) -> lsprotocol::Location : UC-00007-1
    operation references(uri: string, line: int, character: int) -> lsprotocol::Location : UC-00007-1
    operation hover(uri: string, line: int, character: int) -> lsprotocol::Hover : UC-00007-1
    operation completion(uri: string, line: int, character: int) -> lsprotocol::CompletionList : UC-00007-1
    operation draw(uri: string, line: int, character: int) -> string : UC-00007-1
    operation view(uri: string, line: int, character: int) -> string : UC-00007-1
  }

  sequence editor::did_change {
    -> lsp::changed(ls, params)
  }

  sequence editor::definition {
    -> lsp::definition(ls, params) -> locations
    return locations
  }

  sequence editor::references {
    -> lsp::references(ls, params) -> locations
    return locations
  }

  sequence editor::hover {
    -> lsp::hover(ls, params) -> hover
    return hover
  }

  sequence editor::completion {
    -> lsp::completion(ls, params) -> items
    return items
  }

  sequence editor::draw {
    -> lsp::draw(ls, uri, line, character, width, typed) -> drawing
    return drawing
  }

  sequence editor::view {
    -> lsp::view(ls, uri, line, character, width, typed) -> opened
    return opened
  }

  // ---- the extension: C++ inside the Python box --------------------------------------------------
  module native {
    language: cpp
    @uses driftspec@ds@engine                // DS-92: through the engine's interface
    @requirement REQ-00086-1

    function check(files: map<string, string>) -> string
    function export(files: map<string, string>) -> string
    function expected_at(text: string, line: int, column: int) -> string
    function render(files: map<string, string>, diagram: string, format: string, width: int) -> string
    function page(files: map<string, string>, title: string, focus: list<string>) -> string

    sequence check {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.check(files) -> json
      return json
    }

    sequence export {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.export(files) -> json
      return json
    }

    sequence expected_at {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.expectedAt(text, line, column) -> json
      return json
    }

    sequence render {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.render(files, diagram, format, width) -> drawing
      return drawing
    }

    sequence page {
      local ds: driftspec@ds@engine         // the engine's binary interface, not the class behind it
      -> ds.page(files, title, focus) -> html
      return html
    }
  }

  // ---- the package: the JSON read into a typed model ----------------------------------------------
  module pyds {
    @requirement REQ-00086-1

    class Source                               // a directory, or a mapping of path to text
    dataclass Location {
      @requirement REQ-00086-1
      + file: string
      + line: int
      + column: int
    }
    dataclass Entity {
      @requirement REQ-00086-1
      + id: string
      + kind: string
      + name: string
      + scope: string
      + location: Location
      + fields: map<string, string>
      + flags: list<string>
      + expected: bool
    }
    dataclass Relation {
      @requirement REQ-00086-1
      + kind: string
      + source: string
      + target: string
      + location: Location
    }
    dataclass Finding {
      @requirement REQ-00086-1
      + code: string
      + severity: string
      + message: string
      + location: Location
    }
    dataclass Breach {                         // one binding that breaks a rule, and its answer
      @requirement REQ-00098-1
      + bindings: list<list<string>>
      + witness: list<list<string>>
      + location: Location
    }
    class Model {                              // a workspace loaded: every entity by its identity
      @requirement REQ-00086-1
      + entities: map<string, Entity>
      + relations: list<Relation>
      + findings: list<Finding>
      + breaches: map<string, list<Breach>>
      + find(identity: string) -> optional<Entity>
      + of_kind(kind: string) -> list<Entity>
      + named(name: string) -> list<Entity>
      + relations_of(identity: string) -> list<Relation>
      + in_file(path: string) -> list<Entity>
    }
    dataclass Report {
      @requirement REQ-00086-1
      + findings: list<Finding>
      + counts: map<string, int>
    }

    function read(source: Source) -> map<string, string>
    function load(source: Source) -> Model
    function check(source: Source) -> Report
    function render(source: Source, diagram: string, format: string, width: int) -> string
    function page(source: Source, title: string, focus: list<string>) -> string
    function expected_at(text: string, line: int, column: int) -> list<string>

    sequence load {
      -> read(source) -> files
      -> native::export(files) -> text
      return model
    }

    sequence check {
      -> read(source) -> files
      -> native::check(files) -> text
      return report
    }

    sequence render {
      -> read(source) -> files
      -> native::render(files, diagram, format, width) -> drawing
      return drawing
    }

    sequence page {
      -> read(source) -> files
      -> native::page(files, title, focus) -> html
      return html
    }

    sequence expected_at {
      -> native::expected_at(text, line, column) -> words
      return words
    }
  }

  // ---- the server: one design per file, its model kept, its findings published -------------------
  module lsp {
    @requirement REQ-00087-1

    function changed(ls: pygls::LanguageServer, params: typing::object) -> none
    function definition(ls: pygls::LanguageServer, params: typing::object) -> list<lsprotocol::Location>
    function references(ls: pygls::LanguageServer, params: typing::object) -> list<lsprotocol::Location>
    function hover(ls: pygls::LanguageServer, params: typing::object) -> optional<lsprotocol::Hover>
    function completion(ls: pygls::LanguageServer, params: typing::object) -> lsprotocol::CompletionList
    function symbols(ls: pygls::LanguageServer, params: typing::object) -> list<lsprotocol::SymbolInformation>
    function draw(ls: pygls::LanguageServer, uri: string, line: int, character: int, width: int, typed: string) -> map<string, string>
    function view(ls: pygls::LanguageServer, uri: string, line: int, character: int, width: int, typed: string) -> map<string, string>
    function main() -> none
    - function workspace_of(ls: pygls::LanguageServer, path: string) -> string
    - function workspace_files(ls: pygls::LanguageServer, ws: string) -> map<string, string>
    - function use(ls: pygls::LanguageServer, uri: string) -> string
    - function refresh(ls: pygls::LanguageServer, ws: string) -> none
    - function entities_for(word: string) -> list<pyds::Entity>
    - function subject_at(ls: pygls::LanguageServer, uri: string, line: int, character: int, typed: string) -> string
    - function enclosing(path: string, line: int) -> optional<pyds::Entity>
    - function with_focus(files: map<string, string>, identity: string) -> map<string, string>
    - function open_in_browser(path: string) -> none

    sequence changed {
      -> workspace_of(ls, path) -> ws
      -> refresh(ls, ws)
    }

    sequence refresh {
      -> workspace_files(ls, ws) -> files
      -> pyds::load(files) -> model
    }

    sequence definition {
      -> use(ls, uri) -> ws
      -> entities_for(word) -> found
      return locations
    }

    sequence draw {
      -> use(ls, uri) -> ws
      -> subject_at(ls, uri, line, character, typed) -> subject
      -> workspace_files(ls, ws) -> files
      -> with_focus(files, identity) -> focused
      -> pyds::render(focused, diagram, format, width) -> drawing
      return answer
    }

    sequence view {
      -> use(ls, uri) -> ws
      -> subject_at(ls, uri, line, character, typed) -> subject
      -> workspace_files(ls, ws) -> files
      -> pyds::page(files, title, focus) -> html
      -> open_in_browser(path)
      return answer
    }
  }

  // ---- the live session ---------------------------------------------------------------------------
  module live {
    @requirement REQ-00089-1
    @requirement REQ-00090-1
    @requirement REQ-00091-1

    class Live {                               // a session over one workspace: its model version by version, and what both sides point at
      @requirement REQ-00089-1
      @requirement REQ-00090-1
      + workspace: string
      + version: int
      + changed: list<string>
      + removed: list<string>
      + notes: list<object>
      + highlights: list<object>
      + selection: map<string, string>
      + reload() -> bool
      + rules_of(model: pyds::Model, findings: list<pyds::Finding>) -> list<map<string, object>> {
        @requirement REQ-00100-1
      }
      + state() -> map<string, object>
      + broadcast(event: string, data: map<string, object>) -> none
      + watch(every: float) -> none
      + focus(identity: string, also: list<string>) -> int
      + note(identity: string, text: string, tone: string, frame: bool) -> int
      + highlight(ids: list<string>, tone: string, add: bool, frame: bool) -> int
      + clear(what: string) -> none
      + select(identity: string, label: string) -> none
      + load() -> none
      + save() -> none
    }

    function serve(workspace: string, port: int, open_browser: bool, block: bool) -> Live
    function signatures(model: pyds::Model) -> map<string, string>
    function handler_for(live: Live) -> object
    function call(port: int, path: string, data: map<string, object>) -> map<string, object>
    function tool(port: int, name: string, args: map<string, object>, opened: map<string, object>) -> object
    function mcp(port: int, stdin: object, stdout: object) -> none
    function browser_open(url: string) -> none
    function main(argv: list<string>) -> none
  }
}
