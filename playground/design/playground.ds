// The playground (DS-204, DS-238): a static page that edits a workspace and draws it as it is typed,
// grown into DriftSpec's site with the editor as one of its tabs (DS-257).
// No server: the page calls the ds engine compiled to WebAssembly, once per edit. Its code is plain
// JavaScript that argos does not read, so this file stays out of design/; it is written as one more
// package of driftspec and is read together with design/ wherever the whole design is shown.

package driftspec@playground {
  requirement REQ-00149-1 {
    title: The lessons shall know nothing of the page that shows them
    status: approved
    rationale:
      A lesson is data and a coach that decides what comes next; the page decides how it is shown.
      The page may change its look without touching a lesson.

    verification VER-00165-1 {
      status: approved
      title: Analysis confirms no class of the lessons uses or refers to the page: the two rules of the lessons module, evaluated on every check of this design
      method: analysis
    }
  }

  requirement REQ-00150-1 {
    title: The page shall show alone the diagrams a step of a lesson is about, while the step lasts
    status: approved
    text:
      A step says what it is about in its own terms: the diagrams it names, the pane its card
      points at, the diagram its check looks at. The page shows those alone, once, as soon as
      they exist, so the reader may bring the others back; two that are compared stay one above
      the other. A lesson that teaches the page itself moves nothing.
    rationale:
      Owner, 2026-11-16 (DS-242): with a dozen diagrams side by side a reader does not know which
      one a step is changing. The lesson still knows nothing of the page (REQ-00149-1).

    verification VER-00166-1 {
      status: approved
      title: Inspection confirms each step of a lesson shows its diagrams alone: every lesson played in a browser by a scripted reader (playground/lessons/browser_check.sh)
      method: inspection
    }
  }

  requirement REQ-00151-1 {
    title: The page shall play a tour step by step: the message in its sequence, and the two boxes it joins
    status: approved
    text:
      A tour is one diagram of two parts on one cut (the engine's REQ-00139-1): who takes part,
      as boxes, and the sequence between them. Its pane carries the controls: play and pause,
      one step back and forward, a bar to jump, the step it is at. At each step the message is
      lit in the sequence, the box that sends and the one that receives are lit in the other
      part, and a mark travels along the arrow between them. Played, a tour is shown alone. An
      address may ask for one to be played (?play=TOUR_Buy).
    rationale:
      Owner, 2026-11-16 (DS-245): the live viewer's replay of a behaviour over the map, in the
      playground, and in one diagram that already relates the two, so nothing is paired by eye.

    verification VER-00167-1 {
      status: approved
      title: Inspection confirms a tour plays step by step, with its controls, alone in its pane: the lessons that write a tour played in a browser (playground/lessons/browser_check.sh)
      method: inspection
    }
  }

  requirement REQ-00152-1 {
    title: The page shall be DriftSpec's site, a tab per page, the editor one of them
    status: approved
    text:
      The header carries the tabs (Home and Editor today; Learn, Examples and Reference as they are
      written), the language and the theme, shared by every tab. A link that names something of the
      editor (?example=, ?play=, ?select=, a line) opens the Editor; otherwise ?tab= says which page,
      and the home page is the default. What only the editor uses shows only there.
    rationale:
      Owner, 2026-11-17 (DS-256, DS-257): finish the playground as DriftSpec's website, in English
      and Spanish, with the editor as one of its tabs.

    verification VER-00168-1 {
      status: approved
      title: Inspection confirms the site opens on Home, changes tab by its header and by ?tab=, and opens the Editor on a link that names an example
      method: inspection
    }
  }

  requirement REQ-00153-1 {
    title: The home page shall say what DriftSpec is beside an example the engine makes in the page
    status: approved
    text:
      One screen: the marks of DriftSpec and of deriva, what DriftSpec is in a sentence and three
      lines, and the way into the editor. Beside them, an example kept as files with the page
      (home/shop.ds, home/diagrams.ds) and shown as the engine makes it when the page loads: its
      text, its classes, a sequence, its requirements with what keeps each, and under the line that
      is wrong what the engine says of it. Nothing of it is a picture kept by hand. Below, the three
      reasons for DriftSpec: a specification detailed and coherent, three perspectives over one
      model, the specification apart from its drawings. In English and Spanish, like the site.
    rationale:
      Owner, 2026-11-17 (DS-258), after two proposals seen in the browser: a home kept extremely
      simple, with the tool's own output as its picture.

    verification VER-00169-1 {
      status: approved
      title: System tests confirm the example the home page shows draws its classes and a sequence, lists its requirements and has the one error the page shows
      method: test
      tests:
        tests/system/python/test_playground.py::TestPlayground::test_the_example_of_the_home_page_draws_and_has_the_one_error_it_shows
    }
  }

  requirement REQ-00156-1 {
    title: The page shall say, beside a box or a use pointed at, the interfaces that use goes through
    status: approved
    text:
      Pointed at, a class or a closed box lights its relations. Where a use between two boxes says
      the interfaces it goes through (the engine's REQ-00155-1), the page shows them in a card of
      its own beside what is pointed at: the two boxes, then each interface with the operations
      asked of it. The arrow itself shows the same.
    rationale:
      Owner, 2026-11-17 (DS-266): in the HLD, resting on a box lights its relations and says which
      interface each one uses.

    verification VER-00172-1 {
      status: approved
      title: Inspection confirms a closed box pointed at in the tour's HLD lights its uses and shows the interfaces each goes through
      method: inspection
    }
  }

  requirement REQ-00157-1 {
    title: A card of a lesson shall let the reader go back to the last card answered, undoing nothing
    status: approved
    text:
      Every card but the first carries Back. It returns to the last card the reader answered with
      its button, to read it again: what the lesson wrote stays written and is not written again
      going forward. A card that waited for the reader to write is passed over.
    rationale:
      Owner, 2026-11-17 (DS-265): someone who read a card badly can go back.

    verification VER-00173-1 {
      status: approved
      title: Inspection confirms a reader goes back three cards past one the lesson wrote and forward again with that text written once
      method: inspection
    }
  }

  requirement REQ-00159-1 {
    title: The editor shall colour the text with the language's own grammar and highlight queries
    status: approved
    text:
      The tree-sitter parser of DriftSpec, compiled to WebAssembly by the build that makes the
      engine for the page, and grammar/queries/highlights.scm, the queries every other editor
      reads. A document is parsed whole when its text has changed; what the queries capture says
      the colour of each character, a later pattern over an earlier one. Until the grammar is
      loaded, or where it cannot be, the page keeps a mode of regular expressions.
    rationale:
      Owner, 2026-11-17 (DS-269): fundamental. A dozen regular expressions written by hand missed
      for, where, rule, never and holds, and painted any capitalised word of a title as a type.
      One grammar, the same colours in the page as in Neovim.

    verification VER-00175-1 {
      status: approved
      title: Inspection confirms a rule in the tour is coloured by the grammar: its keywords, its title as text, the requirement it answers to
      method: inspection
    }
  }

  requirement REQ-00161-1 {
    title: The Docs tab shall draw the guides the engine carries, each example beside what the engine makes of it
    status: approved
    text:
      The page asks the engine for the guides of the manual (the engine's REQ-00160-1) and lists
      them down the side. A guide is shown as its prose with each example in two parts: its text,
      coloured by the grammar, and the diagrams the engine draws from it there and then; under an
      example that is wrong on purpose, what the engine says of it. Each example opens in the
      editor. The guide shown is kept in the address (?tab=docs&doc=logic).
    rationale:
      Owner, 2026-11-17 (DS-272): no Learn tab; documentation in the style of PlantUML's site,
      with examples. Drawn by the engine, an example cannot fall behind the language.

    verification VER-00177-1 {
      status: approved
      title: Inspection confirms the Docs tab lists the five guides and draws the examples of Logic beside their text, with the finding under the one that is wrong
      method: inspection
    }
  }

  requirement REQ-00162-1 {
    title: On a narrow screen the editor shall stack what a step of a lesson is about: its diagram, its code, its card
    status: approved
    text:
      Nobody writes a design on a phone; a lesson is read there. Under 760 pixels the tab is still
      the Editor and shows, from the top: the diagram the step is about, alone; the code, at the
      line the step speaks of; the problems, only when there are some; and the card, docked at
      the bottom across the screen. The files are not shown. The line between the diagram and
      the code is dragged to give more of the screen to one or the other, and where it was left
      is kept. A line says once that the editor is better opened on a large screen, and stays
      closed once closed.
    rationale:
      Owner, 2026-11-17 (DS-273): the lessons should be readable from a phone, with the diagram
      on top, the exact code under it and the explanation at the bottom, and a notice that it is
      better seen on a computer.

    verification VER-00178-1 {
      status: approved
      title: Inspection confirms a lesson at the width of a phone shows the diagram of its step over its code and its card at the bottom, with the notice
      method: inspection
    }
  }

  requirement REQ-00158-1 {
    title: A lesson shall be able to walk DriftSpec's own design, read as it is, with the views it adds of its own
    status: approved
    text:
      A lesson that says workspace: driftspec starts from the design of the tool and of this
      playground, read from the repository when the site is built, with its own files beside
      them. Lesson 0 is a tour of it: what DriftSpec is, the parts of the page, and each
      perspective at a glance; its cards may stand in the middle of the page or point at a whole
      part of it.
    rationale:
      Owner, 2026-11-17 (DS-265): lesson 0 is a tour of a large, real project, and the lessons
      after it go into the detail. Read, never copied, so the tour cannot fall behind the design.

    verification VER-00174-1 {
      status: approved
      title: System tests replay the tour over DriftSpec's own design to a clean end, with every lesson
      method: test
      tests:
        tests/system/python/test_playground.py::TestPlayground::test_every_lesson_plays_to_a_clean_end
    }
  }

  module engine {
    // engine.js: loads ds.js + ds.wasm and makes the one call
    class Engine {
      @uses driftspec@ds@browser
      + start() -> none
      + ds(files: Files, width: int) -> Answer
    }
    dataclass Files {
      + texts: map<string, string>
    }
    // what the engine answers after an edit: everything the page paints
    dataclass Answer {
      + report: Report
      + entities: list<string>
      + locations: map<string, Location>
      + artefacts: list<Artefact>
      + diagrams: list<Drawn>
    }
    dataclass Report {
      + findings: list<Finding>
      + coverage: list<Finding>             // what is not yet written, shown as information (DS-216)
    }
    dataclass Finding {
      + code: string
      + message: string
      + at: Location
    }
    dataclass Location {
      + file: string
      + line: int
      + endLine: int
    }
    dataclass Artefact {
      + id: string
      + title: string
      + keptBy: list<string>
      + provedBy: list<string>
    }
    dataclass Drawn {
      + id: string
      + kind: string
      + include: string
      + svg: string
    }
    sequence Engine::ds {
      local wasm: driftspec@ds@browser                   // the engine's function in ds.wasm, as ds offers it to a page
      -> wasm.answer(request) -> json
      return answer
    }
  }

  module page {
    // index.html: the whole page, one module of plain JavaScript over CodeMirror
    class Page {
      - owns engine: engine::Engine
      - owns editor: Editor
      - owns tree: Tree
      - owns panes: Panes
      - owns table: Table
      - owns problems: Problems
      - owns coach: lessons::Coach
      + load(lesson: lessons::Lesson) -> none {
        @requirement REQ-00158-1
        @requirement REQ-00162-1
      }
      // the home page's example, drawn by the engine when the page loads
      + paintHome() -> none {
        @requirement REQ-00153-1
      }
      // the site's pages: one shown at a time, kept in the address
      + showTab(tab: string) -> none {
        @requirement REQ-00152-1
      }
      // the guides of the manual, asked of the engine and drawn with their examples
      + paintDocs() -> none {
        @requirement REQ-00161-1
      }
      + onEdit() -> none
      // the diagrams a step is about, shown alone while it lasts; the one that is a tour is played
      + focus(step: lessons::Step) -> none {
        @requirement REQ-00150-1
        @requirement REQ-00151-1
      }
    }
    class Editor {
      // the mode that reads the language's grammar, once it is loaded
      + colour(mode: string) -> none {
        @requirement REQ-00159-1
      }
      + open(file: string) -> none
      + type(step: lessons::Step) -> none
      + reveal(file: string, line: int, endLine: int) -> none
      + underline(findings: list<engine::Finding>) -> none
    }
    class Tree {
      + paint(files: engine::Files, findings: list<engine::Finding>) -> none
    }
    class Problems {
      + paint(findings: list<engine::Finding>) -> none
      + fold() -> none
    }
    class Panes {
      - owns panes: list<Pane>
      + paint(diagrams: list<engine::Drawn>) -> none
      // one pane alone, or it and the ones a step compares it with
      + solo(diagram: string, beside: list<string>) -> none
      // a tour played: the step it is at, lit in its two parts
      + play(tour: string) -> none {
        @requirement REQ-00151-1
      }
      + step(tour: string, at: int) -> none {
        @requirement REQ-00151-1
      }
    }
    class Pane {
      - refs editor: Editor
      + draw(drawn: engine::Drawn) -> none
      + light(entity: string) -> none
      // the interfaces the uses of what is pointed at go through, in a card beside it
      + via(entity: string) -> none {
        @requirement REQ-00156-1
      }
      + reveal(entity: string) -> none
    }
    class Table {
      - refs editor: Editor
      + paint(rows: list<engine::Artefact>) -> none
    }

    sequence Page::onEdit {
      self -> engine.ds(files, width) -> answer
      self -> editor.underline(findings)
      self -> tree.paint(files, findings)
      self -> problems.paint(findings)
      self -> panes.paint(diagrams)
      self -> table.paint(rows)
      self -> coach.check(answer) -> next
      opt a step has its code to type {
        self -> editor.type(next)
      }
      -> focus(next)
    }

    sequence Page::focus {
      self -> coach.about(step) -> diagrams
      opt the step is about some diagrams, and they are drawn {
        self -> panes.solo(first, others)
      }
    }

    sequence Pane::reveal {
      self -> editor.reveal(file, line, endLine)
    }
  }

  module lessons {
    // a lesson: its starting files and its steps (lessons/NN-*/lesson.json), in two languages
    dataclass Lesson {
      + title: Text
      + steps: list<Step>
    }
    dataclass Step {
      + text: Text
      + shows: list<string>                  // the diagrams it is about, when its card and its check do not say
      + write: list<Write>
      + solution: list<Write>
      + done: Check
    }
    dataclass Text {
      + en: string
      + es: string
    }
    dataclass Write {
      + file: string
      + anchor: string
      + text: string
    }
    dataclass Check {
      + ack: optional<Text>
      + entity: optional<string>
      + finding: optional<string>
      + gone: optional<string>
      + hides: optional<string>             // a text a diagram no longer draws: what a cut closes, what a fold stops at
      + clean: bool
    }
    // the card beside what a step talks about: decides when a step is done and which comes next; the page
    // types its code (the lessons know nothing of the page, REQ-00149-1)
    class Coach {
      - refs lesson: Lesson
      + check(answer: engine::Answer) -> optional<Step>
      + passed(check: Check, answer: engine::Answer) -> bool
      // what a step is about: the diagrams it names, or the ones its card and its check look at
      + about(step: Step) -> list<string>
      // back to the last card answered with its button; nothing is undone
      + back() -> optional<Step> {
        @requirement REQ-00157-1
      }
    }

    sequence Coach::check {
      self -> passed(check, answer) -> ok
      alt the step is done {
        return next
      } else {
        return
      }
    }

    rule lessons-blind-to-page {
      title: No member of the lessons names a type of the page
      @requirement REQ-00149-1
      for class c in driftspec@playground@lessons
      never m in c, m uses x, x in driftspec@playground@page
    }
    rule lessons-hold-no-page {
      title: No attribute of the lessons refers to the page
      @requirement REQ-00149-1
      for class c in driftspec@playground@lessons
      never a in c, a refs x, x in driftspec@playground@page
    }
  }
}

diagram HLD_Playground {
  kind: class
  include: driftspec@playground@*
  open:
}

diagram CL_Page {
  kind: class
  include: driftspec@playground@page::*
}

diagram CL_Engine {
  kind: class
  include: driftspec@playground@engine::*
}

diagram CL_Lessons {
  kind: class
  include: driftspec@playground@lessons::*
}

diagram SEQ_Edit {
  kind: sequence
  include: driftspec@playground@page::Page::onEdit
  depth: 1
}
