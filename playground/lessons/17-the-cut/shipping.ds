package shop@shipping {
  module carrier {
    class Courier {
      - owns route: Route
      + deliver(parcel: Parcel) -> bool
    }
    class Route {
      + next() -> std::string
    }
    dataclass Parcel {
      + address: std::string
    }
  }
  module tracking {
    class Tracker {
      - refs courier: carrier::Courier
      + where(parcel: carrier::Parcel) -> std::string
    }
  }
}
