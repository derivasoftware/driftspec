package shop {
  requirement SREQ-00001-1 {
    title: The shop shall sell an item from the command line
    status: draft
  }
  usecase UC-00001-1 buy(item: string) -> int {
    title: Buy an item
    status: draft
    @requirement SREQ-00001-1
    outcome default: the number of the order
    outcome declined: nothing is bought
    outcome sold-out: the item is not in stock
  }
  constraint CST-00001-1: Every price shall be kept in cents
  requirement REQ-00002-1: The store shall not depend on billing
  requirement REQ-00003-1: Every requirement of the store shall be satisfied by the design
  requirement REQ-00004-1: The shell shall reach the store only through the cart
  module store {
    requirement REQ-00001-2 {
      @refines SREQ-00001-1
      title: The cart shall total the price of its lines
      status: draft
    }
    requirement REQ-00005-1: The cart shall keep at most one coupon
  }
}
