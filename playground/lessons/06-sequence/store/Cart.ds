package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs optional coupon: std::optional<Coupon>
      - status: Status = Open
      - owns many lines: std::vector<Line>
      + total() -> int
      + add(line: Line) -> void
      - recalculate() -> void
    }
  }
}
