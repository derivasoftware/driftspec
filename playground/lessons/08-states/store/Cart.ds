package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs coupon: optional<Coupon>
      - status: Status = Open
      - owns lines: list<Line>
      + total() -> Money
      + add(line: Line) -> none
      - recalculate(line: Line) -> none
      + checkout(method: PaymentMethod) -> bool
    }
    sequence Cart::add {
      self -> stock.has(line) -> available
      opt the line is not in stock / sold-out {
        return
      }
      self -> stock.reserve(line)
      -> recalculate(line)
    }
    sequence Cart::total {
      local line: Line
      loop each line {
        self -> line.subtotal() -> part
      }
      return sum
    }
    sequence Cart::checkout {
      -> total() -> amount
      self -> method.pay(amount) -> paid
      return paid
    }
    sequence Cart::checkout / declined {
      -> total() -> amount
      self -> method.pay(amount) -> paid
      return false
    }
  }
}
