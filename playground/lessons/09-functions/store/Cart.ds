package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs optional coupon: std::optional<Coupon>
      - status: Status = Open
      - owns many lines: std::vector<Line>
      + total() -> Money
      + add(line: Line) -> void
      - recalculate(line: Line) -> void
      + checkout(method: PaymentMethod) -> bool
      + ship() -> void
    }
    sequence Cart::add {
      self -> stock.has(line) -> available
      opt the line is not in stock / sold-out {
        return
      }
      self -> stock.reserve(line)
      -> recalculate(line)
    }
    sequence Cart::total {
      local line: Line
      loop each line {
        self -> line.subtotal() -> part
      }
      return sum
    }
    sequence Cart::checkout {
      -> total() -> amount
      self -> method.pay(amount) -> paid
      return paid
    }
    sequence Cart::checkout / declined {
      -> total() -> amount
      self -> method.pay(amount) -> paid
      return false
    }
    state Cart {
      initial Open
      Open -> Paid on checkout [the card accepts]
      Paid -> Shipped on ship
      Open -> Open on add / recalculate
    }
  }
}
