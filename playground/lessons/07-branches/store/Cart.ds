package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs optional coupon: std::optional<Coupon>
      - status: Status = Open
      - owns many lines: std::vector<Line>
      + total() -> Money
      + add(line: Line) -> void
      - recalculate(line: Line) -> void
      + checkout(method: PaymentMethod) -> bool
    }
    sequence Cart::add {
      self -> stock.has(line) -> available
      self -> stock.reserve(line)
      -> recalculate(line)
    }
    sequence Cart::checkout {
      -> total() -> amount
      self -> method.pay(amount) -> paid
      return paid
    }
  }
}
