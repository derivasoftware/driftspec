// Lesson 5 · One class per file

package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs coupon: optional<Coupon>
      - status: Status = Open
      - owns lines: list<Line>
      + total() -> int
      + add(line: Line) -> none
      - recalculate() -> none
    }
    class Line {
      - refs cart: Cart
      - count: int = 1
      - price: Money
      - gift: bool = false
      - note: string = ""
    }
    dataclass Money {
      - cents: int
      - currency: string = "EUR"
    }
    enum Status { Open, Paid, Shipped }
    dataclass Coupon {
      - code: string
      - percent: int
    }
    class PaymentMethod {
      + abstract pay(amount: Money) -> bool
    }
    class Card : PaymentMethod {
      - refs gateway: bank::Gateway
      + pay(amount: Money) -> bool
    }
    class Stock {
      + has(line: Line) -> bool
    }
    class Pricing {
      + abstract rate() -> int
      + apply(amount: Money) -> Money
    }
  }
  module billing {
    class Invoice {
      - refs cart: store::Cart
      - refs payer: store::Card
    }
    + class Numbering {
      + next() -> int
    }
  }
  extern module bank {
    class Gateway
  }
}

diagram CL_Store {
  kind: class
  include: shop@store::*
}

diagram CL_Shop {
  kind: class
  include: shop@*
}
