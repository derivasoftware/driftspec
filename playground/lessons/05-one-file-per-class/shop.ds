// Lesson 5 · One class per file

package shop {
  module store {
    class Cart {
      - refs numbering: billing::Numbering
      - shares stock: Stock
      - refs optional coupon: std::optional<Coupon>
      - status: Status = Open
      - owns many lines: std::vector<Line>
      + total() -> int
      + add(line: Line) -> void
      - recalculate() -> void
    }
    class Line {
      - refs cart: Cart
      - count: int = 1
      - price: Money
      - gift: bool = false
      - note: std::string = ""
    }
    dataclass Money {
      - cents: int
      - currency: std::string = "EUR"
    }
    enum Status { Open, Paid, Shipped }
    dataclass Coupon {
      - code: std::string
      - percent: int
    }
    class PaymentMethod {
      + abstract pay(amount: Money) -> bool
    }
    class Card : PaymentMethod {
      - refs gateway: bank::Gateway
      + pay(amount: Money) -> bool
    }
    class Stock {
      + has(line: Line) -> bool
    }
    class Pricing {
      + abstract rate() -> int
      + apply(amount: Money) -> Money
    }
  }
  module billing {
    class Invoice {
      - refs cart: store::Cart
      - refs payer: Card
    }
    + class Numbering {
      + next() -> int
    }
  }
}

diagram CL_Store {
  kind: class
  include: shop@store::*
}

diagram CL_Shop {
  kind: class
  include: shop@*
}
