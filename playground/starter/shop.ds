// A shop, written from the bottom up: a class, then what it holds,
// then what it does. Every diagram below is drawn on the right.

package shop {
  module store {
    class Cart {
      - owns lines: list<Line>
      + add(item: Item, count: int)
      + total() -> Money
      - subtotal(line: Line) -> Money
    }

    class Line {
      - refs item: Item
      - count: int
    }

    class Item {
      - name: string
      - price: Money
    }

    dataclass Money {
      - cents: int
    }

    sequence Cart::total {
      loop each line {
        -> subtotal(line) -> part
      }
      return sum
    }
  }
}

diagram CL_Store {
  kind: class
  include: shop@store::*
}

diagram SEQ_Total {
  kind: sequence
  include: shop@store::Cart::total
}
