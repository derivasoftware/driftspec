// A black-box requirement: it lives at package level and sees the modules
// from outside (R1). Its nested verification verifies it by nesting (R3).

package ds {

  requirement DS-0001 {
    revision: 0
    owner: dcoello
    title: The diagnostics package shall report every broken link of the workspace
    text:
      Given a loaded workspace, the package reports one finding per link that
      does not hold, with a code, a severity and the location it points to.

    verification VF-0002 {
      level: system
      @boundary cli
      precondition: a workspace with one known broken link
      postcondition: the CLI prints exactly one finding with code and location
      test: tests/system/test_cli_diagnose.py::test_one_broken_link
    }
  }
}
