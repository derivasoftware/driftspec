// The cut of a diagram (DS-229, DS-231): one shop and one purchase, drawn through several cuts. A cut is
// written as what closes and what opens, never as its frontier, so whatever is written is a cut; one
// branch may go down to its classes while another stays one box. Boxes, sequences and requirements
// stand on the same cut.

package shop {
  requirement SREQ-00001-1: The shop shall sell an item that is in stock

  interface shell {
    kind: cli
    operation buy(item: string) -> int
  }

  sequence shell::buy {
    local desk: shop@sales@desk::Desk
    self -> desk.sell(item) -> code
    return code
  }

  package sales {
    @uses shop@warehouse@counter
    @uses shop@bank@gateway

    module desk {
      requirement REQ-00001-1 {
        title: The desk shall refuse an item the warehouse does not hold
        @refines SREQ-00001-1
      }

      class Desk {
        @requirement REQ-00001-1
        - refs counter: shop@warehouse@counter
        - owns till: shop@sales@till::Till
        - owns prices: PriceList
        + sell(item: string) -> int
      }
      class PriceList {
        + priceOf(item: string) -> int
      }

      sequence Desk::sell {
        self -> prices.priceOf(item) -> price
        self -> counter.take(item) -> held
        opt the warehouse does not hold it / sold-out {
          return 1
        }
        self -> till.charge(price) -> paid
        return 0
      }
    }

    module till {
      class Till {
        - refs bank: shop@bank@gateway
        - owns ledger: Ledger
        + charge(amount: int) -> bool
      }
      class Ledger {
        + record(amount: int)
      }

      sequence Till::charge {
        self -> bank.pay(amount) -> ok
        self -> ledger.record(amount)
        return ok
      }
    }
  }

  package warehouse {
    @uses shop@bank@gateway

    interface counter {
      kind: library
      operation take(item: string) -> bool
    }

    sequence counter::take {
      local shelf: shop@warehouse@stock::Shelf
      local buyer: shop@warehouse@supply::Buyer
      self -> shelf.pick(item) -> held
      opt it was the last one {
        self -> buyer.reorder(item)
      }
      return held
    }

    module stock {
      requirement REQ-00002-1 {
        title: The stock shall hand over an item it holds
        @refines SREQ-00001-1
      }

      class Shelf {
        - owns boxes: list<Box>
        + pick(item: string) -> bool {
          @requirement REQ-00002-1
        }
      }
      dataclass Box {
        + item: string
        + units: int
      }
    }

    module supply {
      class Buyer {
        - refs bank: shop@bank@gateway
        + reorder(item: string)
      }

      sequence Buyer::reorder {
        self -> bank.pay(cost) -> ok
      }
    }
  }

  package bank {
    interface gateway {
      kind: library
      operation pay(amount: int) -> bool   // ? W-OPERATION-NO-BEHAVIOUR: the bank is not designed here
    }
  }
}

// ---- structure: what closes and what opens --------------------------------------------------------

diagram CL_Everything {                  // no cut written: every box open
  kind: class
  include: shop@*
}

diagram HLD_Open {                       // open: alone closes every other box
  kind: class
  include: shop@*
  open: shop@sales
}

diagram HLD_Close {                      // close: names what closes, and the rest stays open
  kind: class
  include: shop@*
  close: shop@warehouse
}

diagram HLD_Modules {                    // a kind: the cut runs at the modules, wherever each one is
  kind: class
  include: shop@*
  close: module
}

diagram HLD_Till {                       // open: goes through what close: closes
  kind: class
  include: shop@*
  close: module
  open: shop@sales@till
}

diagram HLD_Packages {                   // every package below the shop is one box
  kind: class
  include: shop@*
  close: package
}

diagram HLD_Borrowed {                   // cut: takes the cut of another diagram
  kind: class
  include: shop@*
  cut: HLD_Till
}

diagram HLD_BorrowedAndMore {            // and what it writes itself is added to it
  kind: class
  include: shop@*
  cut: HLD_Modules
  open: shop@warehouse@stock
}

diagram HLD_Lost {
  kind: class
  include: shop@*
  cut: HLD_Nowhere                       // ! W-DIAGRAM-UNDECLARED: no diagram of that name
}

diagram HLD_Cellar {
  kind: class
  include: shop@*
  close: shop@cellar                     // ! W-DIAGRAM-UNDECLARED: no box cellar in the shop
}

// ---- behaviour: the same purchase, on the same cuts ------------------------------------------------

diagram SEQ_Classes {                    // no cut: every object its lifeline, as deep as depth: says
  kind: sequence
  include: shop@shell::buy
  depth: *
}

diagram SEQ_Open {                       // on a cut each closed box is one lifeline, and every call is followed
  kind: sequence
  include: shop@shell::buy
  open: shop@sales
}

diagram SEQ_Modules {                    // the cut at the modules: what crosses from one to another
  kind: sequence
  include: shop@shell::buy
  close: module
}

diagram SEQ_Borrowed {                   // the cut of the boxes drawn above, so the two drawings agree
  kind: sequence
  include: shop@shell::buy
  cut: HLD_Till
}

diagram SEQ_AsWritten {                  // unfold: alone folds every call: only what the behaviour itself writes
  kind: sequence
  include: shop@shell::buy
  close: module
  unfold:
}

diagram SEQ_UnfoldSales {                // unfold: a box. Only the calls that land in the sales are followed
  kind: sequence
  include: shop@shell::buy
  close: module
  unfold: shop@sales
}

diagram SEQ_FoldSupply {                 // fold: the reorder is seen, what the supply does to answer is not
  kind: sequence
  include: shop@shell::buy
  close: module
  fold: shop@warehouse@supply
}

diagram SEQ_Through {                    // unfold: goes through fold:, as open: goes through close:
  kind: sequence
  include: shop@shell::buy
  close: module
  fold: shop@sales
  unfold: shop@sales@desk
}

diagram SEQ_OneLevel {                   // depth: is the uniform case
  kind: sequence
  include: shop@shell::buy
  close: module
  depth: 1
}

diagram SEQ_Cellar {
  kind: sequence
  include: shop@shell::buy
  unfold: shop@cellar                    // ! W-DIAGRAM-UNDECLARED: no box cellar in the shop
}

diagram SEQ_Level {
  kind: sequence
  include: shop@shell::buy
  level: module                          // ! W-FIELD-UNKNOWN: a cut is written with close: module
}

// ---- requirements: what answers to each, on the same cut -------------------------------------------

diagram REQ_Classes {                    // no cut: the class that answers
  kind: requirement
  include: shop@*
}

diagram REQ_Modules {                    // the cut at the modules: the module that stands for it
  kind: requirement
  include: shop@*
  close: module
}
