// The cut of a diagram (DS-229): one shop, drawn through several cuts. A cut is written as what closes
// and what opens, never as its frontier, so whatever is written is a cut; one branch may go down to
// its classes while another stays one box.

package shop {
  interface shell {
    kind: cli
    operation buy(item: string) -> int
  }

  sequence shell::buy {
    local desk: shop@sales@desk::Desk
    self -> desk.sell(item) -> code
    return code
  }

  package sales {
    @uses shop@warehouse@counter
    @uses shop@bank@gateway

    module desk {
      class Desk {
        - refs counter: shop@warehouse@counter
        - owns till: shop@sales@till::Till
        - owns prices: PriceList
        + sell(item: string) -> int
      }
      class PriceList {
        + priceOf(item: string) -> int
      }

      sequence Desk::sell {
        self -> prices.priceOf(item) -> price
        self -> counter.take(item) -> held
        opt the warehouse does not hold it / sold-out {
          return 1
        }
        self -> till.charge(price) -> paid
        return 0
      }
    }

    module till {
      class Till {
        - refs bank: shop@bank@gateway
        - owns ledger: Ledger
        + charge(amount: int) -> bool
      }
      class Ledger {
        + record(amount: int)
      }

      sequence Till::charge {
        self -> bank.pay(amount) -> ok
        self -> ledger.record(amount)
        return ok
      }
    }
  }

  package warehouse {
    @uses shop@bank@gateway

    interface counter {
      kind: library
      operation take(item: string) -> bool
    }

    sequence counter::take {
      local shelf: shop@warehouse@stock::Shelf
      local buyer: shop@warehouse@supply::Buyer
      self -> shelf.pick(item) -> held
      opt it was the last one {
        self -> buyer.reorder(item)
      }
      return held
    }

    module stock {
      class Shelf {
        - owns boxes: list<Box>
        + pick(item: string) -> bool
      }
      dataclass Box {
        + item: string
        + units: int
      }
    }

    module supply {
      class Buyer {
        - refs bank: shop@bank@gateway
        + reorder(item: string)
      }

      sequence Buyer::reorder {
        self -> bank.pay(cost) -> ok
      }
    }
  }

  package bank {
    interface gateway {
      kind: library
      operation pay(amount: int) -> bool   // ? W-OPERATION-NO-BEHAVIOUR: the bank is not designed here
    }
  }
}

// ---- structure: what closes and what opens --------------------------------------------------------

diagram CL_Everything {                  // no cut written: every box open
  kind: class
  include: shop@*
}

diagram HLD_Open {                       // open: alone closes every other box
  kind: class
  include: shop@*
  open: shop@sales
}

diagram HLD_Close {                      // close: names what closes, and the rest stays open
  kind: class
  include: shop@*
  close: shop@warehouse
}

diagram HLD_Modules {                    // a kind: the cut runs at the modules, wherever each one is
  kind: class
  include: shop@*
  close: module
}

diagram HLD_Till {                       // open: goes through what close: closes
  kind: class
  include: shop@*
  close: module
  open: shop@sales@till
}

diagram HLD_Packages {                   // every package below the shop is one box
  kind: class
  include: shop@*
  close: package
}

diagram HLD_Borrowed {                   // cut: takes the cut of another diagram
  kind: class
  include: shop@*
  cut: HLD_Till
}

diagram HLD_BorrowedAndMore {            // and what it writes itself is added to it
  kind: class
  include: shop@*
  cut: HLD_Modules
  open: shop@warehouse@stock
}

diagram HLD_Lost {
  kind: class
  include: shop@*
  cut: HLD_Nowhere                       // ! W-DIAGRAM-UNDECLARED: no diagram of that name
}

diagram HLD_Cellar {
  kind: class
  include: shop@*
  close: shop@cellar                     // ! W-DIAGRAM-UNDECLARED: no box cellar in the shop
}
