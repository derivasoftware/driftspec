// Nested packages (decided 2026-10-26). A package holds packages: the HLD
// nests, and it follows the conventions of every other entity. Written nested,
// braces mean containment; written flat, `package app@render {` reopens render
// inside app, as a module reopens across files. Every package level adds its
// name with @: app, app@core, app@core@model::Entity. Level by placement:
// what the outermost package declares is of the system; an inner package has
// its own level, a module its own.

package app {
  requirement SREQ-00001-1: The system shall load a workspace      // system level: the outermost package

  package core {
    @requirement SREQ-00001-1                                       // the box realises the system requirement (HLD)
    requirement REQ-00001-1 {                                       // package level: the core's own promise
      @refines SREQ-00001-1
      title: The core shall parse a workspace into one model
    }
    module model {
      class Entity {
        + id: string
      }
    }
  }
}

package app@render {                                                 // the flat form: the same identity as nesting
  requirement REQ-00002-1: The render shall draw the model            // the box's own requirement; who it refines is said in wiring.ds
  extern module std {                                                // names only (R11): the standard library
    class string
    class map<K, V>
  }
  extern module tree_sitter {                                        // the catalogue: a bare name resolves here as a last resort
    class TSNode
    class Dup
  }
  extern module other {
    class Dup                                                        // the same simple name twice: a bare Dup is ambiguous
  }
  module svg {
    enum Mode {
      @requirement SREQ-00001-1                                      // an enum realises requirements like a class
      Fast, Slow
    }
  }
  module svg {
    class Svg {
      - owns model: app@core@model::Entity                           // across packages, by full identity
      - owns cache: std::map<std::string, app@core@model::Entity>    // a qualified container passes ownership to its element (R16)
      + abstract: bool                                                // a modifier is a word only in front of a name: nothing is reserved
      + node: TSNode                                                  // bare: the one extern TSNode of the catalogue
      + dup: Dup                                                      // ! E-REF-AMBIGUOUS: two extern modules declare Dup
      + static run() -> int                                           // ...and still a modifier where it modifies
      + render() -> string
    }
  }
}

package app@missing@deep {                                           // ! W-REF-UNDECLARED: nobody declares app@missing
  module m {
    class Orphan {
      + run()
    }
  }
}

diagram CL_App {
  kind: class
  include: app@*                                                     // every package under app: the nested ones become containers
}
