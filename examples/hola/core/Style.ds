// How a greeting sounds. Every method abstract and no data: an interface,
// which Formal and Casual realise.

package hola {
  module core {
    class Style {
      + abstract apply(text: string) -> string
    }

    class Formal : Style {
      + apply(text: string) -> string
    }

    class Casual : Style {
      + apply(text: string) -> string
      - emoji: string
    }
  }
}
