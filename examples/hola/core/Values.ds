package hola {
  module core {
    dataclass Locale {
      + language: std::string
      + region: std::string
    }

    class GreetingCache {
      + find(name: std::string) -> std::optional<Greeting>
      + keep(greeting: Greeting) -> void
      - owns many entries: std::map<std::string, Greeting>
    }
  }
}
