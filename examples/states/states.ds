// The states of a machine as rules over the context of its subject (DS-249), and the calls of the
// behaviours held to its jumps (DS-250). MX_Order draws the order as a matrix (DS-251).
//
// A state is not kept in a variable: it is computed. Each rule says when the subject is in a state, over
// what the subject holds: `Paid if status = Paid`. The literals are joined by commas and all hold; a name
// alone is a boolean of the subject, or a condition with a name when the subject holds nothing so called;
// `not` turns a literal round. One state may have several rules: each is one way of being in it.
//
// The rules of a machine exclude each other: whatever the subject holds, it is in one state. Two states
// that can hold at once are a finding, and it says a context in which they do. The machine starts in the
// state its subject's defaults are in: it is not written. The lines marked ! are the oracle.

package shop {
  module order {
    enum Status { Open, Paid, Shipped }

    // ---- a machine whose rules exclude each other: nothing to report -----------------------------------
    class Order {
      - status: Status = Open
      - cancelled: bool = false
      + pay() -> none
      + ship() -> none
      + cancel() -> none
    }
    state Order {
      Open       if status = Open, not cancelled
      Paid       if status = Paid, not cancelled
      Shipped    if status = Shipped
      Cancelled  if cancelled, status != Shipped      // two literals on two attributes
      Open -> Paid on pay                             // the jumps are written as they always were
      Paid -> Shipped on ship
      Open -> Cancelled on cancel
      Paid -> Cancelled on cancel
    }

    // ---- the calls of the behaviours, held to the machine (DS-250) --------------------------------------
    // Nothing is asked of a behaviour: it is read as it is. Along it, what it calls an event on may be in
    // any state to begin with, and each call of an event moves it by the jumps on that event.
    class Desk {
      - owns order: Order
      + sell() -> none
      + rush() -> none
      + close() -> none
      + label() -> none
    }
    sequence Desk::sell {                             // pay, then ship: the order the machine writes
      self -> order.pay()
      self -> order.ship()
    }
    sequence Desk::rush {
      self -> order.pay()
      self -> order.ship()
      self -> order.cancel()                          // ! W-STATE-ORDER: once shipped, nothing cancels it
    }
    sequence Desk::close {
      opt it was paid {
        self -> order.ship()                          // inside a frame: it may not happen
      }
      self -> order.cancel()                          // so the order may still be open: nothing to report
    }
    sequence Desk::label {
      self -> order.ship()                            // the first call: the order may be in any state
    }

    // ---- a state with two rules: two ways of being in it ------------------------------------------------
    class Lamp {
      - lit: bool = false
      - broken: bool = false
    }
    state Lamp {
      Dark  if not lit
      Dark  if broken, lit                            // a broken lamp is dark though it is lit
      On    if lit, not broken
    }

    // ---- a condition with a name: the subject holds nothing called `expired`, so it is only a name ------
    class Offer {
      - taken: bool = false
    }
    state Offer {
      Standing   if not taken, not expired
      Taken      if taken
      Lapsed     if not taken, expired
    }
  }

  // ---- what the rules say that cannot be -------------------------------------------------------------------
  module faults {
    enum Lever { Rest, Left, Right }

    class Lamps {
      - lever: Lever = Rest
      - hazard: bool = false
    }
    state Lamps {
      Dark   if lever = Rest, not hazard
      Left   if lever = Left
      Right  if lever = Right
      Both   if hazard                                // ! W-STATE-OVERLAP: with the lever to one side and the hazard on, it is two states
    }

    class Door {
      - lever: Lever = Rest
      - locked: bool = false
    }
    state Door {
      Shut   if lever = Rest
      Ajar   if lever = Up                            // ! W-STATE-VALUE: a lever is Rest, Left or Right, never Up
      Open   if hinge = Left                          // ! W-STATE-UNDECLARED: the door holds no hinge
      Stuck  if locked, not locked                    // ! W-STATE-IMPOSSIBLE: locked and not locked
    }

    // the start is not written: a gate starts not open, so Down, and from there nothing leads to Jammed
    class Gate {
      - open: bool = false
      + lift() -> none
      + drop() -> none
    }
    state Gate {                                      // ! W-STATE-UNREACHABLE: nothing leads to Jammed from Down
      Down  if not open
      Up    if open
      Down -> Up on lift
      Up -> Down on drop
      Jammed -> Down on drop
    }
  }
}

diagram STM_Order {
  kind: state
  include: shop@order::Order
}

diagram MX_Order {
  kind: matrix
  include: shop@order::Order
}

diagram STM_Lamp {
  kind: state
  include: shop@order::Lamp
}

diagram STM_Lamps {
  kind: state
  include: shop@faults::Lamps
}
