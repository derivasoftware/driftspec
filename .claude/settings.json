{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/start-argos-daemon.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "argos brief || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
