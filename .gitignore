# Argos runtime state (federation cache, eval data, reports) — derived,
# never committed.
.argos/

# Per-operator workspace overrides (REQ-00625-1): the GDD analogue of
# an editable install. Always local, never committed.
argos.local.toml

# Python working residue (DDEV-245): the venv and interpreter caches
# every ``argos init --language python`` project grows on first run.
# Inert lines for the other languages.
.venv/
__pycache__/
*.egg-info/

# build tree
build/
build-*.log
build-*/
.driftspec/
.emsdk/
playground/site/

# a compiled grammar is built when it is needed, never committed (DS-32)
*.so

# The instructions and settings of coding agents live outside the repository, with whoever uses
# them (DS-291): kept here, they would name tools a reader outside deriva cannot use.
CLAUDE.md
AGENTS.md
.claude/
.mcp.json

# the viewer's test dependencies, installed by npm ci from package-lock.json (DS-329)
node_modules/
