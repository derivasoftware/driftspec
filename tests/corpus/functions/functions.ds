// functions.ds — functions of a module (decided 2026-10-26).
// A Python module or a C++ namespace declares operations outside any class;
// a design written in DriftSpec says them as they are, not wrapped in a class
// that the code does not have. The `!` lines are the findings the tool emits.
//
//  F1  `function name(params) -> type` in a module, with the optional
//      visibility of a member in front (`- function _row_of(...)`), public when
//      absent. Its identity is the module's plus its name, like a class:
//      iris@tasks::gather. Two of one name with different parameters are overloads,
//      each named by its parameter types (DS-455); with the same types, E-DUPLICATE-IDENTITY.
//  F2  Its signature and body are a method's: parameters and the return give
//      `uses`; the body holds notes, annotations (@requirement, @constraint),
//      rules and nested artefacts.
//  F3  Its behaviour is `sequence gather { }`. The participants are its
//      parameters and the locals written; there is no self. A call with no
//      target is a function of the module, resolved outward like any name;
//      a method calling one that its class does not declare reaches it too.
//  F4  In a class diagram each function is one box «function»; in a sequence
//      a function runs on its module's lifeline.
//  F5  A function nobody designs (a library's, requests::get) is text: a call
//      to it relates nothing and is no finding (DS-18).

package iris {

  module tasks {
    requirement REQ-00900-1: The tasks of a project shall be gathered from the board

    class Board {
      + issues(project: std::string) -> std::vector<Task>
    }
    dataclass Task {
      + key: std::string
      + title: std::string
    }

    function gather(board: Board, project: std::string) -> std::vector<Task> {
      @requirement REQ-00900-1
      note: the one door to the board
      // requires: project is a board identifier
    }
    - function _row_of(task: Task) -> std::string
    function describe(tasks: std::vector<Task>) -> std::string
    function describe(task: Task) -> std::string      // an overload: describe(Task) beside describe(std::vector<Task>) (DS-455)
    function describe(one: Task) -> std::string       // ! E-DUPLICATE-IDENTITY: the same name and the same types, describe(Task) again

    sequence gather {
      -> board.issues(project) -> issues
      -> _row_of(task)
      -> _row_of(task, project)                    // ! E-MSG-ARITY: _row_of takes 1 parameter, 2 given
      -> summarise(issues)                         // no function of iris@tasks is called summarise: text (F5)
      -> cache.put(issues)                         // cache is neither a parameter nor a local: text (DS-18)
    }
  }

  module cli {
    class Command {
      + run(project: std::string) -> int
    }
    function main(argv: std::vector<std::string>) -> int

    sequence Command::run {
      local board: tasks::Board
      -> main(project)                             // a method reaches a function of its module
      -> tasks::gather(board, project)
    }
  }
}

diagram CL_Tasks {
  kind: class
  include: iris@tasks::*
}

diagram SEQ_Gather {
  kind: sequence
  include: iris@tasks::gather
}
