// values.ds: the values of a sequence have types. A name in a behaviour is an
// attribute, a parameter, a local or the result of an earlier message, and the
// result of a message has the type its operation returns. The `!` lines are the
// findings the tool emits.

package shop {
  module store {
    dataclass Price {
      + amount: int
    }

    class Item {
      + price() -> Price
      + rename(name: std::string) -> void
    }

    class SpecialItem : Item {
      + discount() -> int
    }

    class Stock {
      + find(sku: std::string) -> Item
      + first(skus: std::map<std::string, int>) -> SpecialItem
      + count(item: Item) -> int
      + restock(amount: int) -> void
      + mystery(sku: std::string)
    }
  }

  module till {
    class Till {
      - stock: store::Stock
      + sell(sku: std::string, skus: std::map<std::string, int>) -> int
    }

    sequence Till::sell {
      self -> stock.find(sku) -> item                // a result: its type is Item
      self -> item.price() -> price                  // a call on it, checked against Item
      self -> stock.first(skus) -> special           // one parameter, whatever the commas of its type
      self -> special.discount() -> off
      self -> stock.count(special) -> n              // a SpecialItem is an Item
      self -> stock.mystery(sku) -> unknown          // no return declared: its type is unknown
      self -> unknown.anything()                     // no finding: there is nothing to check it against
      self -> stock.restock(3)                       // a literal against int: the code's word, never compared (DS-18)
      self -> stock.find("A-1") -> other             // other is an Item too: its own lifeline, not item's
      self -> other.price() -> otherPrice
      opt a spare is on the shelf {
        local spare: store::Item                     // a local inside a frame is a local
        self -> spare.price() -> sparePrice
      }
      loop each line of the receipt {
        // printed by the till, nothing the design draws
      }

      self -> item.nothing()                         // ! W-MSG-UNDECLARED: Item does not declare it
      self -> stock.count(price) -> wrong            // ! W-ARG-TYPE: a Price is not an Item
      self -> stock.count(3) -> three                // ! W-ARG-TYPE: a literal is no Item
      self -> stock.restock(sku)                     // std::string against int: the code's words, never compared (DS-18)
      self -> stock.find(7) -> wrongSku              // a literal against std::string: never compared either
      self -> stock.restock(n) -> gone               // ds does not read void: no finding (DS-18)
      self -> early.price()                          // early is not yet a value: text, unchecked (DS-18)
      self -> stock.find(sku) -> early
    }
  }
}

diagram SEQ_Sell {
  kind: sequence
  include: shop@till::Till::sell
}
