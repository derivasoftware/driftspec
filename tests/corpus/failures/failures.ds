// failures.ds: how a behaviour fails, whatever the mechanism (DS-187).
//
// A path ends failing with the failure's name: `fail ParseError`, where a return would go. The name
// is text, as a type is: an exception class, an error value, an error code.
//
// An attempt runs its steps and handles what they fail with, one `on` each: a handler resolves the
// failure (it returns), translates it (it fails with another), or the failure goes on to the caller
// because no handler names it. The default path does not fail: it runs the attempt's steps and no
// handler. A handler that names a scenario is the path of that failure.
//
// What escapes each operation, and by which path, is computed from these two (DS-188): a failure
// goes up to every caller that does not handle it. Loader::open lets both of Loader::load's go up;
// Shelf::show handles them, and nothing escapes it. A call ds cannot follow, to an operation with no
// behaviour, is taken not to fail, unless its signature says what it fails with: Files::read does.
//
// A signature promises what may escape (DS-189): fails A, B, or fails nothing. What escapes and the
// signature does not say is W-FAILURE-UNDECLARED; what it says and no path produces is
// W-FAILURE-UNREACHED. An interface operation is a boundary: what escapes it is said, or nothing may.

package shelf {
  module books {
    class Files {
      + read(path: std::string) -> std::string fails IoError, Busy
    }
    class Parser {
      + parse(text: std::string) -> Book fails ParseError, Timeout   // ! W-FAILURE-UNREACHED: no path times out
    }
    class Book {
      + title: std::string
    }
    class Cache {
      + last() -> Book
    }

    class Loader {
      - files: Files
      - parser: Parser
      - cache: Cache
      + load(path: std::string) -> Book fails LoadError, ParseError
      + open(path: std::string) -> Book fails LoadError     // ! W-FAILURE-UNDECLARED: ParseError escapes too
    }

    class Shelf {
      - loader: Loader
      + show(path: std::string) -> std::string fails nothing
    }

    // where a failure starts: the path that does not parse ends failing
    sequence Parser::parse {
      opt the text does not parse / broken {
        fail ParseError
      }
      return book
    }

    // where it is handled: a read that fails is translated, a busy disk is resolved from the cache,
    // and a parse error, named by no handler, goes on to the caller
    sequence Loader::load {
      attempt {
        self -> files.read(path) -> text
        self -> parser.parse(text) -> book
      } on IoError / unreadable {
        fail LoadError
      } on Busy / busy {
        self -> cache.last() -> book
        return book
      }
      return book
    }

    // what it calls fails, and it handles nothing: ParseError and LoadError go up through it
    sequence Loader::open {
      -> load(path) -> book
      return book
    }

    // both handled: nothing escapes
    sequence Shelf::show {
      attempt {
        self -> loader.open(path) -> book
      } on ParseError {
        return nothing
      } on LoadError {
        return nothing
      }
      return title
    }
  }

  // the boundary: what escapes an interface operation is said in its signature
  interface library {
    kind: library
    operation show(path: string) -> string
    operation open(path: string) -> books::Book   // ! W-FAILURE-UNDECLARED: a boundary says what escapes it
  }

  sequence library::show {
    local shelf: books::Shelf
    -> shelf.show(path) -> title
    return title
  }

  sequence library::open {
    local loader: books::Loader
    -> loader.open(path) -> book
    return book
  }
  // a use case has no signature: what a call of its scenario fails with is handled there, or it
  // escapes the use case and is said at the scenario (DS-434)
  usecase UC-00001-1 {         // ? W-USECASE-UNREALISED
    title: Read a book
  }
  sequence UC-00001-1 {        // ! W-FAILURE-UNDECLARED: the loader's LoadError and ParseError escape it
    -> Loader.load(path) -> book
    return book
  }

  usecase UC-00002-1 {         // ? W-USECASE-UNREALISED
    title: Show a book
  }
  sequence UC-00002-1 {        // the shelf handles what it calls fails with: nothing escapes
    -> Shelf.show(path) -> title
    return title
  }
  // an outcome may be the end of a failure (DS-467): what escapes the scenario and an outcome names ends
  // there, and is no failure undeclared
  usecase UC-00003-1 {         // ? W-USECASE-UNREALISED
    title: Read a book, or say why not
    outcome default: the book
    outcome unreadable fails LoadError: the file could not be read
    outcome broken fails ParseError: the file is not a book
  }
  sequence UC-00003-1 {        // both escape, and both end in an outcome: nothing to say
    -> Loader.load(path) -> book
    return book
  }

  // a use case that specialises it keeps its outcomes; one it redefines by name is no second end
  usecase UC-00004-1 : UC-00003-1 {   // ? W-USECASE-UNREALISED
    title: Read a book from the shelf
    outcome broken fails ParseError: the shelf holds no such book
  }

  // what an outcome names must be a failure somewhere; one failure ends in one outcome
  usecase UC-00005-1 {         // ? W-USECASE-UNREALISED
    title: Lend a book
    outcome default: the book is lent
    outcome lost fails Missing: the book is not there     // ! W-OUTCOME-FAILURE-UNKNOWN: nothing in the workspace is Missing
    outcome late fails Busy: the files are busy
    outcome slow fails Busy: the files are busy again      // ! W-OUTCOME-FAILURE-TWICE: late is the end of Busy already
  }
}

diagram SEQ_Load {
  kind: sequence
  include: shelf@books::Loader::load
  depth: 1
}
