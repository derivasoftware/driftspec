// e14: bare name before a root package (DS-224). A probe of the model audit of 2026-11 (DS-209); the `!` lines are its findings, the `?` lines its coverage.
package e14Cart {
  module store {
    class Cart {
      + total() -> int
    }
    class Shop {
      - cart: Cart
      + open() -> none
