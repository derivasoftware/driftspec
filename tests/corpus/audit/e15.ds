// e15: a relation between two kinds it never joins (DS-226). A probe of the model audit of 2026-11 (DS-209); the `!` lines are its findings.
package e15shop {
  usecase UC-01501-1 buy(item: string) -> int {
    title: Buy an item
    outcome default: the number of the order
  }
  interface shell {
    kind: cli
    operation buy(item: string) -> int : UC-01501-1
  }
  sequence shell::buy {
    return 0
  }
  requirement REQ-01501-1: The shop shall sell
  verification VER-01501-1 {
    @requirement REQ-01501-1
    @interface shell  // ! E-RELATION-KIND: a verification realises no interface
    title: A verification that names an interface
    method: review
  }
  module store {
    class Cart : UC-01501-1 {  // ! E-RELATION-KIND: a class inherits a class, never a use case
      + total() -> int
    }
    class Basket : Cart {  // a class inheriting a class, as the language joins it
      + total() -> int
    }
  }
}
