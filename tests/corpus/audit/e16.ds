// e16: rule of an attribute (DS-224). A probe of the model audit of 2026-11 (DS-209); the `!` lines are its findings, the `?` lines its coverage.
package e16shop {
  requirement REQ-16001-1: Amounts shall be positive
  module store {
    class Cart {
      - cents: int {
        rule positive {
          @requirement REQ-16001-1
          for class c in e16shop@store
          holds c in e16shop@store
        }
      }
      - items: int {
        rule positive {
          @requirement REQ-16001-1
          for class c in e16shop@store
          holds c in e16shop@store
        }
      }
      + total() -> int {
        rule positive {
          @requirement REQ-16001-1
          for class c in e16shop@store
          holds c in e16shop@store
        }
      }
    }
  }
}
